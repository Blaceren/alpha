# ATA Backend — production environment.
# Install to /srv/ata/config/backend.env  (root:ata, mode 0640)
#
# Loaded by systemd EnvironmentFile=. Format is KEY=value, one per line.
# Do NOT use `export`, and do NOT wrap values in quotes unless the value itself
# genuinely contains them — systemd does not run a shell over this file.
#
# Validated at startup by backend/src/lib/env.ts. That validator is strict and
# fails CLOSED: a misconfigured production host does not boot. Every rule below
# is taken from it rather than guessed.

# --- runtime ----------------------------------------------------------------
NODE_ENV=production
PORT=3110

# Environment classification. MUST be exactly one of: dev | staging | production
# (backend/src/lib/env.ts:186). This is a SEPARATE axis from NODE_ENV on purpose:
# the project serves a production BUILD everywhere, so NODE_ENV=production is
# true on developer boxes too and cannot be used to classify a host.
# Absence fails. A misspelling fails. Both are deliberate.
ATA_ENVIRONMENT=production

# IANA zone name, e.g. Europe/Kyiv. Drives business-day boundaries.
ATA_BUSINESS_TIMEZONE=__TIMEZONE__
TZ=__TIMEZONE__

# --- required in production (env.ts:55-62) ----------------------------------
# All six are checked by name. An empty value counts as missing.

DATABASE_URL=file:/srv/ata-data/db/app.db

# Generate with: openssl rand -base64 48
# The development fallback value is rejected explicitly (env.ts:464).
SESSION_SECRET=__SESSION_SECRET__

# Must match what is configured on the Pocket side. The development fallback
# value is rejected explicitly (env.ts:468).
POSTBACK_SECRET=__POSTBACK_SECRET__

APP_URL=https://api.__DOMAIN__

STORAGE_DRIVER=local
LOCAL_UPLOADS_DIR=/srv/ata-data/uploads

# REQUIRED IN PRODUCTION, and the placeholder in backend/.env.example will NOT
# do. That placeholder is a deliberate non-value: a tracked template carrying a
# real affiliate id would silently attribute every fresh deployment's traffic to
# whoever committed it. Put YOUR account's real registration link here.
POCKET_AFFILIATE_BASE_URL=__POCKET_AFFILIATE_BASE_URL__

# --- CAPTCHA (AFD-3A2) ------------------------------------------------------
# Outside ATA_ENVIRONMENT=dev a WORKING provider is MANDATORY (env.ts:407-410).
# "Unclassified or misspelled" counts as outside, so forgetting does not excuse.

CAPTCHA_PROVIDER=turnstile
TURNSTILE_SECRET_KEY=__TURNSTILE_SECRET_KEY__

# Comma-separated BARE hostnames (no scheme, no port). This is the set of hosts
# whose Turnstile tokens this backend will accept.
TURNSTILE_EXPECTED_HOSTNAMES=academy.__DOMAIN__

# REQUIRED to be exactly `true` outside dev (env.ts:438-442). This is what stops
# the bounded DEV login exception in src/lib/captcha.ts from ever becoming a
# production bypass — a deployment without it does not boot.
CAPTCHA_LOGIN_ENFORCED=true

# ============================================================================
# KEYS THAT MUST *NOT* APPEAR IN THIS FILE
#
# Each of these causes a HARD STARTUP FAILURE in production. They are listed
# here, commented, precisely so nobody "helpfully" copies them in from
# backend/.env.example — which is a DEV template and is stale on these points.
#
#   TURNSTILE_EXPECTED_ACTION   RETIRED (env.ts:450). Actions are now pinned
#                               per authentication surface in source. Setting
#                               this key does nothing, so startup fails loudly
#                               rather than leave a false belief in the file.
#   CAPTCHA_TEST_MODE           isolated-test marker, dev only.
#   CAPTCHA_PROVIDER=turnstile_test   isolated-test provider, dev only.
#   REPORT_ATTACHMENT_TEST_BACKEND    regression-only.
#   CHECKPOINT_PROVIDER_TEST_BACKEND  regression-only.
#   POCKET_PARTNER_API_TEST_MODE      regression-only.
#   STAGING_ATTESTATION_ENABLED       requires ATA_ENVIRONMENT=staging exactly;
#                                     a production host with it set REFUSES to
#                                     boot.
#
# CAPTCHA_DEV_BYPASS is a separate case: it is GONE from the contract entirely
# (env.ts:70-72). It is still present in backend/.env.example, where it is now
# misleading — setting it grants nothing. Do not carry it over.
# ============================================================================

# --- operational safety -----------------------------------------------------
EMAIL_VERIFICATION_REQUIRED=true
ALLOW_PRODUCTION_SEED=false
ALLOW_PRODUCTION_BETA_RESET=false

# --- curriculum V2 feature flags --------------------------------------------
# All default to false. Decide deliberately which to enable; see README.md.
#
# CURRICULUM_V2_REGISTRATION_AUTO_ENROLL_ENABLED deserves particular care: with
# it on, a registration that cannot produce an enrollment (no published
# curriculum, two published curricula, a corrupt graph) fails the WHOLE
# registration with 503 rather than creating a learner with no programme.
CURRICULUM_V2_ADMIN_ENABLED=false
CURRICULUM_V2_READ_ENABLED=false
CURRICULUM_V2_ENROLLMENT_ENABLED=false
CURRICULUM_V2_REGISTRATION_AUTO_ENROLL_ENABLED=false
CURRICULUM_V2_XP_ENABLED=false
CURRICULUM_V2_CONTENT_ENABLED=false
CURRICULUM_V2_ASSESSMENT_ENABLED=false
CURRICULUM_V2_REPORT_ENABLED=false

# --- Pocket ingest ----------------------------------------------------------
# Keep OFF until the nginx postback logging block is verified in place (see
# deploy/aws/README.md, "Before enabling Pocket"). Turning these on before that
# writes the live provider secret into access logs in plaintext.
POCKET_POSTBACK_REQUIRE_SECRET=true
