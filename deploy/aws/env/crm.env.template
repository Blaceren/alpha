# ATA CRM — production environment.
# Install to /srv/ata/config/crm.env  (root:ata, mode 0640)
#
# ############################################################################
# READ THIS BEFORE DEPLOYING. CRM IS NOT LIKE ACADEMY.
#
# CRM_MODE and CRM_BACKEND_ORIGIN are needed AT BUILD TIME, not only at runtime.
#
# crm/next.config.mjs calls buildRewrites(process.env) from `rewrites()`, and
# Next evaluates `rewrites()` during `next build`, baking the result into
# .next/routes-manifest.json. `next start` only reads that manifest.
#
# So if these two are absent when the build runs, buildRewrites() returns an
# EMPTY ARRAY (crm/next.config.mjs:402 — `if (mode !== "api") return []`) and
# the resulting artifact has no proxy routes at all. The build succeeds. The
# service starts. Every CRM API call then 404s, and nothing in the logs points
# at the cause.
#
# deploy/aws/build.sh sources this file before building for exactly this reason.
# Keep the two copies in agreement; a rebuild is required after changing either.
# ############################################################################

NODE_ENV=production
PORT=3130

CRM_MODE=api

# Loopback, same reasoning as Academy. Must be a bare absolute origin: http(s),
# no credentials, no query, no hash, no path — parseBackendOrigin rejects all of
# those and the build then throws rather than producing a silently broken CRM.
CRM_BACKEND_ORIGIN=http://127.0.0.1:3110
