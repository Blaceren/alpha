# ATA Academy — production environment.
# Install to /srv/ata/config/academy.env  (root:ata, mode 0640)
#
# All of these are read AT RUNTIME (getAcademyConfig is lazy and resolves on the
# first request — academy/src/config/academy-config.ts:186). Changing a value
# here takes effect on `systemctl restart ata-prod-academy`, with no rebuild.
# This is the opposite of CRM — see crm.env.template.

NODE_ENV=production
PORT=3120

# MUST be set explicitly: `fixture` | `api`.
# In production, an absent value is a startup error on purpose — production must
# never silently fall back to serving fixture data (academy-config.ts:141).
ACADEMY_MODE=api

# Loopback, deliberately.
#
# The origin validator requires https:// for any non-loopback host, but accepts
# plain http for 127.0.0.1 / localhost / ::1 (academy-config.ts:65,118).
# Going over loopback keeps backend traffic off the network entirely and avoids
# a pointless TLS round trip through nginx and back into the same machine.
#
# It must be a bare origin: no path, no query, no fragment, no credentials.
BACKEND_ORIGIN=http://127.0.0.1:3110

# The PUBLIC Cloudflare Turnstile site key (the secret half lives only in the
# backend and is deliberately unreadable from here).
#
# Injected at runtime rather than compiled in as NEXT_PUBLIC_*, so one build
# serves every deployment and rotating the widget is not a release.
#
# Absence is LEGAL and fails CLOSED at the surface: the site boots and serves
# its other routes normally, but the registration form renders an unavailable
# state and blocks submission. In other words, leaving this empty produces a
# working site on which nobody can sign up — which looks like a product bug, not
# a config error. Set it before go-live.
TURNSTILE_SITE_KEY=__TURNSTILE_SITE_KEY__

# Bounds: 1000–30000. Outside that range is a startup error.
ACADEMY_REQUEST_TIMEOUT_MS=10000
