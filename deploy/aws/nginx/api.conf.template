# ATA Backend API + admin UI.  api.__DOMAIN__ -> 127.0.0.1:3110
#
# Placeholders (__DOMAIN__) are substituted by deploy/aws/bootstrap.sh.
#
# Academy and CRM do NOT reach the backend through this hostname — they proxy
# over loopback (http://127.0.0.1:3110). This public name exists for exactly two
# reasons: Pocket's postback callbacks, and the backend's own admin UI.

server {
    listen 80;
    listen [::]:80;
    server_name api.__DOMAIN__;

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name api.__DOMAIN__;

    ssl_certificate     /etc/letsencrypt/live/api.__DOMAIN__/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/api.__DOMAIN__/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Robots-Tag "noindex, nofollow, noarchive" always;

    access_log /var/log/nginx/api.access.log;
    error_log  /var/log/nginx/api.error.log;

    # =========================================================================
    # THE POCKET CALLBACK. Declared FIRST and with `=` so it takes exact-match
    # precedence and cannot be shadowed by the `location /` catch-all below.
    #
    # Ported from backend/ops/nginx/PREPROD_POSTBACK_LOGGING_HANDOFF.conf.
    # This block MUST be in place BEFORE any Pocket ingest switch is enabled.
    # =========================================================================
    location = /api/postbacks/pocket {
        # Sanitised format — path only, no query string. See the reasoning in
        # /etc/nginx/conf.d/ata-http-scope.conf.
        access_log /var/log/nginx/ata-postback.log postback_noquery;

        # -------------------------------------------------------------------
        # THE ERROR LOG, WHICH THE ACCESS-LOG FIX DOES NOT COVER.
        #
        # Sanitising the access log alone is NOT sufficient. nginx writes the
        # ORIGINAL REQUEST LINE into error_log entries for upstream failures:
        #
        #   ... upstream timed out ... request: "GET /api/postbacks/pocket
        #   ?goal=dep&clickid=...&ow=<THE LIVE SECRET> HTTP/1.1" ...
        #
        # and error_log has NO format directive — `log_format` cannot apply to
        # it, so postback_noquery has no effect there whatsoever. Every upstream
        # 502, timeout, refusal and reset would write the live secret in
        # plaintext. Those cluster during deploys and restarts, which is exactly
        # when Pocket retries hardest.
        #
        # The fix is route-local on purpose: `error_log` is valid at location
        # scope and the last level specified wins for requests handled there.
        # Every other location, every other site, and every crit/alert/emerg
        # condition keeps normal logging. Nothing outside this one path changes.
        # -------------------------------------------------------------------
        error_log /var/log/nginx/ata-postback-error.log crit;

        # No rate limit here. Pocket retries hard on failure and throttling the
        # provider would drop genuine financial callbacks; the endpoint
        # authenticates by shared secret rather than by volume.
        proxy_pass http://127.0.0.1:3110;

        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_hide_header X-Powered-By;
    }

    # Health probe: used by publish-release.sh as its readiness path. Kept out
    # of the access log so monitoring does not drown the real traffic.
    location = /api/health {
        access_log off;
        include /etc/nginx/snippets/ata-proxy.conf;
        proxy_pass http://127.0.0.1:3110;
    }

    # Credential endpoints. bcrypt is expensive by design, which makes an
    # unthrottled login form a cheap way to saturate 2 vCPUs.
    location ~ ^/api/auth/(login|register|resend-verification|change-password)$ {
        limit_req zone=ata_auth burst=5 nodelay;
        include /etc/nginx/snippets/ata-proxy.conf;
        proxy_pass http://127.0.0.1:3110;
    }

    # See academy.conf.template for why these two blocks exist.
    location /_next/image {
        return 404;
    }

    location /_next/static/ {
        add_header X-Content-Type-Options "nosniff" always;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        include /etc/nginx/snippets/ata-proxy.conf;
        proxy_pass http://127.0.0.1:3110;
    }

    location / {
        limit_req zone=ata_general burst=60 nodelay;
        include /etc/nginx/snippets/ata-proxy.conf;
        proxy_pass http://127.0.0.1:3110;
    }
}
