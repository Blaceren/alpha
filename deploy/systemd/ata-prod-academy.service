[Unit]
Description=ATA prod academy (loopback only)
After=network-online.target
Wants=network-online.target
RequiresMountsFor=/srv/ata-data

[Service]
Type=simple
User=ata
Group=ata
WorkingDirectory=/srv/ata/current/academy
EnvironmentFile=/srv/ata/config/academy.env
ExecStart=/usr/local/bin/npm run start -- --hostname 127.0.0.1 --port 3050
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
KillSignal=SIGTERM
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
