# /srv/ata/config/backend.env — PROD. Права 0600, владелец ata. Значения — только через TTY-скрипты, никогда в чате/тикетах.
NODE_ENV=production
NEXT_TELEMETRY_DISABLED=1
PORT=3100
HOSTNAME=127.0.0.1
ATA_ENVIRONMENT=production
APP_URL=https://alfatrade.media
PUBLIC_APP_URL=https://alfatrade.media
DATABASE_URL=file:/srv/ata-data/data/ata-prod.sqlite
STORAGE_DRIVER=local
LOCAL_UPLOADS_DIR=/srv/ata-data/uploads
# Секреты: сгенерировать `openssl rand -hex 32` для каждого, все разные.
SESSION_SECRET=
PARTNER_SESSION_SECRET=
ATTRIBUTION_TOKEN_SECRET=
# Новый секрет для PROD, тот же вписывается в постбэк-URL в кабинете Pocket.
POSTBACK_SECRET=
POCKET_POSTBACK_REQUIRE_SECRET=true
# Cloudflare Turnstile — виджет для PROD-хостов (секретная часть здесь, публичная — в academy.env / crm.env).
CAPTCHA_PROVIDER=turnstile
CAPTCHA_LOGIN_ENFORCED=true
TURNSTILE_SECRET_KEY=
TURNSTILE_EXPECTED_HOSTNAMES=alfatrade.media,crm.alfatrade.media
# Почта продукта: сброс пароля, подтверждение и смена адреса — раздел 13 руководства.
# НЕ РАСКОММЕНТИРОВАТЬ, пока не пройден раздел 13 и не выпущен релиз с транспортом `ses`:
# с транспортом, которого сборка не знает, проверка окружения не проходит (readiness 503).
# Без этих строк почта выключена, и продукт ничего не обещает: «Забыли пароль?» не показывается.
# MAIL_TRANSPORT=ses
# MAIL_FROM=Alfa Trade Academy <no-reply@alfatrade.media>
# MAIL_SES_REGION=eu-central-1
# Pocket / партнёрская программа
POCKET_AFFILIATE_BASE_URL=
POCKET_POSTBACK_ENABLED=true
POCKET_REG_INGEST_ENABLED=true
POCKET_DEP_INGEST_ENABLED=true
POCKET_RDEP_INGEST_ENABLED=true
POCKET_FIRST_DEPOSIT_ENABLED=true
POCKET_BALANCE_PROVIDER_ENABLED=true
AFFILIATE_PLATFORM_ENABLED=true
AFFILIATE_ATTRIBUTION_ENABLED=true
AFFILIATE_CPA_QUALIFICATION_ENABLED=true
AFFILIATE_POSTBACK_DELIVERY_ENABLED=true
# Учебная программа v2 — все флаги включены, как на PREPROD
CURRICULUM_V2_READ_ENABLED=true
CURRICULUM_V2_ENROLLMENT_ENABLED=true
CURRICULUM_V2_REGISTRATION_AUTO_ENROLL_ENABLED=true
CURRICULUM_V2_XP_ENABLED=true
CURRICULUM_V2_CONTENT_ENABLED=true
CURRICULUM_V2_ASSESSMENT_ENABLED=true
CURRICULUM_V2_REPORT_ENABLED=true
CURRICULUM_V2_CHECKPOINT_ENABLED=true
# На PROD ЗАПРЕЩЕНО: аттестация чекпоинтов вручную существует только для стенда.
STAGING_ATTESTATION_ENABLED=false
