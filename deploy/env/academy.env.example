# /srv/ata/config/academy.env — PROD
NODE_ENV=production
NEXT_TELEMETRY_DISABLED=1
PORT=3050
HOSTNAME=127.0.0.1
ACADEMY_MODE=api
BACKEND_ORIGIN=http://127.0.0.1:3100
# Каталог медиа (раздел 14 руководства): видео уроков (lessons/) и фильм главной (public/film/).
# Абсолютный путь; без него у уроков нет видео, а фильм на главной остаётся «Скоро».
ATA_MEDIA_ROOT=/srv/ata-data/media
# Видео с Amazon CloudFront (academy/docs/ops/media-cdn/MEDIA_CDN.md). Без ATA_MEDIA_DELIVERY=cdn
# файлы отдаёт сама академия из ATA_MEDIA_ROOT. В режиме cdn уроки — только по подписанной ссылке:
# без ключа они не отдаются вовсе.
# ATA_MEDIA_DELIVERY=cdn
# ATA_MEDIA_CDN_ORIGIN=https://dxxxxxxxxxxxx.cloudfront.net
# ATA_MEDIA_CDN_KEY_PAIR_ID=
# ATA_MEDIA_CDN_PRIVATE_KEY_FILE=/srv/ata/config/media-cdn-signing.pem
# ATA_MEDIA_CDN_URL_TTL_SECONDS=21600
# ATA_MEDIA_CDN_SIGNATURE=sha1
# Публичная часть виджета Turnstile (та же пара, что TURNSTILE_SECRET_KEY в backend.env)
TURNSTILE_SITE_KEY=
# Индексация поисковиками: только публичная главная и только здесь, на PROD.
# Обе переменные обязательны; без любой из них весь хост отвечает noindex.
ACADEMY_SEARCH_INDEXING=on
ACADEMY_PUBLIC_ORIGIN=https://alfatrade.media
