# Files that are executed on Linux must keep LF endings regardless of the
# checkout platform. With core.autocrlf=true (the common Windows default, and
# what this repository was last cloned with) a shell script checked out on
# Windows gets CRLF, and a CRLF script fails on the server with the singularly
# unhelpful `bad interpreter: /usr/bin/env bash^M`.
*.sh            text eol=lf
*.service       text eol=lf
*.timer         text eol=lf
*.conf          text eol=lf
*.template      text eol=lf
.env.example    text eol=lf

# Lockfiles and manifests: normalise so a Windows edit does not rewrite the
# whole file as a diff.
package-lock.json text eol=lf
*.json          text eol=lf

# Binary — never touch these.
*.png           binary
*.woff2         binary
*.db            binary
*.sqlite        binary
