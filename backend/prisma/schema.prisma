  submission               ReportSubmission  @relation("ReportSubmissionReceipts", fields: [submissionId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  targetRevision           ReportRevision?   @relation("ReportCommandTargetRevision", fields: [targetRevisionId, submissionId], references: [id, submissionId], onDelete: Restrict, onUpdate: Cascade)
  resultRevision           ReportRevision?   @relation("ReportCommandResultRevision", fields: [resultRevisionId, submissionId], references: [id, submissionId], onDelete: Restrict, onUpdate: Cascade)

