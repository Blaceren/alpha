/**
 * PHASE-G0 — the durable, editable video-production contract.
 * WHY IT EXISTS. Until now the 58 ATA video contracts lived only in
 * `curriculum/canonical/ata-video-production-contracts.v1.json`. A source file
 * is the right home for provenance and for the bootstrap, and the wrong home
 * for an authoring workflow: moving a lesson from SCRIPT_PENDING to
 * SCRIPT_READY would have meant an engineering commit per editorial action.
 * ONE WRITABLE FIELD. `contractPayload` holds the EXACT accepted contract shape
 * — the same object `videoProductionContractSchema` parses out of the canonical
 * file, no field invented, none dropped. Everything else on this row is either
 * identity, lifecycle, or a SERVER-DERIVED projection of that payload. There is
 * deliberately no second place to write a take, a question or a QA verdict, so
 * the payload and the columns cannot disagree.
 * THE DERIVED COLUMNS. `contractFingerprint`, `assessmentFingerprint` and
 * `productionEvidenceStale` are computed on every write by
 * `calculateContractFingerprint`, `calculateAssessmentFingerprint` and
 * `isProductionEvidenceStale` — the EXISTING Phase-C functions, never a second
 * implementation. `scriptState`, `videoState`, `qaState`, `sourceProvenance`,
 * `levelNumber` and `contractVersion` are likewise copied out of the payload in
 * the same transaction, purely so the readiness view can filter without
 * deserialising 58 JSON documents. A caller may never supply any of them.
 * WHAT IT DOES NOT DECIDE. `sourceProvenance` (SOURCE_BACKED / PROPOSED_CANON)
 * is provenance and `editorialState` is approval. L18 is SOURCE_BACKED and NOT
 * approved, and this row keeps those two facts in two columns precisely so they
 * can never be conflated.
 */
model VideoProductionVersion {
  id                  Int            @id @default(autoincrement())
  levelDefinitionId   Int
  curriculumVersionId Int
  versionNumber       Int
  revision            Int            @default(1)
  editorialState      EditorialState @default(draft)

  /// Denormalised from the payload for querying. Server-written, never accepted.
  levelNumber      Int
  contractVersion  Int
  sourceProvenance String
  scriptState      String
  videoState       String
  qaState          String

  /// The exact accepted contract object. The ONLY writable authoring surface here.
  contractPayload Json

  /// Server-computed. `calculateContractFingerprint` / `calculateAssessmentFingerprint`.
  contractFingerprint     String
  assessmentFingerprint   String
  /// Server-computed. `isProductionEvidenceStale` at write time.
  productionEvidenceStale Boolean @default(false)

  createdById          Int?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  lastAuthoredById     Int?
  lastAuthoredAt       DateTime?
  submittedById        Int?
  submittedAt          DateTime?
  changesRequestedById Int?
  changesRequestedAt   DateTime?
  approvedById         Int?
  approvedAt           DateTime?

  levelDefinition            LevelDefinition                @relation(fields: [levelDefinitionId, curriculumVersionId], references: [id, curriculumVersionId], onDelete: Restrict, onUpdate: Cascade)
  createdBy                  User?                          @relation("VideoProductionVersionCreator", fields: [createdById], references: [id], onDelete: SetNull, onUpdate: Cascade)
  lastAuthoredBy             User?                          @relation("VideoProductionVersionLastAuthor", fields: [lastAuthoredById], references: [id], onDelete: SetNull, onUpdate: Cascade)
  submittedBy                User?                          @relation("VideoProductionVersionSubmitter", fields: [submittedById], references: [id], onDelete: SetNull, onUpdate: Cascade)
  changesRequestedBy         User?                          @relation("VideoProductionVersionChangeRequester", fields: [changesRequestedById], references: [id], onDelete: SetNull, onUpdate: Cascade)
  approvedBy                 User?                          @relation("VideoProductionVersionApprover", fields: [approvedById], references: [id], onDelete: SetNull, onUpdate: Cascade)
  reviewNotes                EditorialReviewNote[]          @relation("EditorialReviewNoteVideoProduction")
  /// PHASE-G0 CORRECTION — the durable bridge to the real question bank.
  assessmentLink             VideoProductionAssessmentLink?
  previewSnapshots           AuthoringPreviewSnapshot[]     @relation("AuthoringPreviewSnapshotVideoProduction")
  /// PHASE-G2 FOUNDATION — adjudications whose Blueprint side came from this contract.
  sourceAuthorityResolutions SourceAuthorityResolution[]

  @@unique([levelDefinitionId, versionNumber])
  @@index([curriculumVersionId, editorialState])
  @@index([curriculumVersionId, levelNumber])
  @@index([createdById])
  @@index([lastAuthoredById])
  @@index([submittedById])
  @@index([changesRequestedById])
  @@index([approvedById])
}

/**
 * PHASE-G0 — append-only editorial review commentary.
 * NOT `ReportReview`. That model reviews a LEARNER's submitted report, is keyed
 * to a `ReportSubmission`, carries rubric scores and rejection reasons, and its
 * rows are learner-visible evidence. This one reviews STAFF authoring work, is
 * keyed to an authoring version, and is never shown to a learner. Reusing the
 * learner model would have put staff commentary one join away from a learner
 * surface, which is exactly the leak this domain must not have.
 * THREE NULLABLE TARGETS, EXACTLY ONE SET. Prisma cannot express a tagged union
 * across three foreign keys, so the constraint is enforced in the DATABASE by a
 * CHECK in the migration and re-asserted by the domain before every insert. The
 * alternative — one untyped integer plus a discriminator string — was rejected:
 * it has no referential integrity at all, so a note could outlive its target or
 * point at a row of the wrong kind and nothing would notice.
 * `targetRevision` records the aggregate revision the note was written against,
 * so a reviewer's "fix the third block" is still readable after the author
 * bumped the aggregate, and the UI can mark it as possibly stale rather than
 * silently reattributing it to new text.
 * NO HARD DELETE IN THE NORMAL WORKFLOW. There is no `deletedAt` and the domain
 * exposes no delete operation. A note is closed by `resolvedAt`/`resolvedById`,
 * which preserves what was asked and who accepted it.
 * NO LEARNER PII. There is no learner relation, no email, no name column. The
 * body is bounded staff prose about a lesson.
 */
model EditorialReviewNote {
  id Int @id @default(autoincrement())

  /// Exactly one of the three is non-null. Enforced by a CHECK constraint.
  contentVersionId         Int?
  assessmentVersionId      Int?
  videoProductionVersionId Int?

  /// Aggregate revision of the target at the moment the note was written.
  targetRevision Int
  /// Optional bounded field/block path, e.g. `sections[2].blocks[0].alt`.
  path           String?
  body           String
  /// The staff actor, as a canonical User id. Derived server-side, never accepted.
  authorId       Int
  createdAt      DateTime  @default(now())
  resolvedAt     DateTime?
  resolvedById   Int?

  contentVersion         ContentVersion?         @relation("EditorialReviewNoteContent", fields: [contentVersionId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  assessmentVersion      AssessmentVersion?      @relation("EditorialReviewNoteAssessment", fields: [assessmentVersionId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  videoProductionVersion VideoProductionVersion? @relation("EditorialReviewNoteVideoProduction", fields: [videoProductionVersionId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  author                 User                    @relation("EditorialReviewNoteAuthor", fields: [authorId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  resolvedBy             User?                   @relation("EditorialReviewNoteResolver", fields: [resolvedById], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([contentVersionId, resolvedAt])
  @@index([assessmentVersionId, resolvedAt])
  @@index([videoProductionVersionId, resolvedAt])
  @@index([authorId])
  @@index([resolvedById])
}

/**
 * PHASE-G0 — the immutable staff preview snapshot.
 * WHY THE EXISTING VERSION IDS ARE NOT ENOUGH. A preview must render an EXACT
 * draft state. Draft rows are mutable by design — that is what `revision` is
 * for — and the previous state is not retained anywhere. So "preview
 * ContentVersion 42" names a moving target: by the time the renderer reads it,
 * revision N may already be N+1, and staff would review text that no longer
 * exists while believing they reviewed what they clicked. Freezing the render
 * payload is the only way to make the preview exact, so the table is required.
 * `snapshotCode` IS AN IDENTIFIER, NOT A CREDENTIAL. It is opaque and unique so
 * it can appear in a URL path, and it grants nothing: the preview route must
 * still resolve the caller's session and re-check curriculum_read exactly as
 * every other authoring surface does. No bearer secret is ever placed in a
 * preview URL, and this column must never be treated as one.
 * WHAT IS FROZEN. `payload` holds the already-normalised learner-facing render
 * input, plus the asset table it references. It carries no internal production
 * metadata, no correct answers and no learner data — a snapshot is what a
 * learner would see, which is the whole point of previewing it.
 * G0 SCOPE. The table and its integrity land here so the migration is done
 * once. The creation domain and the Academy render route are G1.
 */
model AuthoringPreviewSnapshot {
  id                  Int    @id @default(autoincrement())
  /// Opaque, unique, URL-safe. NOT a credential — authorization is checked separately.
  snapshotCode        String @unique
  levelDefinitionId   Int
  curriculumVersionId Int

  contentVersionId         Int?
  /// Aggregate revision frozen into `payload`. Proves what was rendered.
  contentRevision          Int?
  assessmentVersionId      Int?
  assessmentRevision       Int?
  /// PHASE-G0 CORRECTION — the third pinnable authoring target. Paired with its
  /// revision exactly like the two above: a version id without a revision cannot
  /// prove what was rendered, and a revision without its version names nothing.
  videoProductionVersionId Int?
  videoProductionRevision  Int?

  /// Frozen learner-facing render input. No internal metadata, no answer keys.
  payload Json

  createdById Int
  createdAt   DateTime  @default(now())
  expiresAt   DateTime?

  levelDefinition        LevelDefinition         @relation(fields: [levelDefinitionId, curriculumVersionId], references: [id, curriculumVersionId], onDelete: Restrict, onUpdate: Cascade)
  contentVersion         ContentVersion?         @relation("AuthoringPreviewSnapshotContent", fields: [contentVersionId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  assessmentVersion      AssessmentVersion?      @relation("AuthoringPreviewSnapshotAssessment", fields: [assessmentVersionId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  videoProductionVersion VideoProductionVersion? @relation("AuthoringPreviewSnapshotVideoProduction", fields: [videoProductionVersionId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  createdBy              User                    @relation("AuthoringPreviewSnapshotCreator", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([videoProductionVersionId])
  @@index([levelDefinitionId, createdAt])
  @@index([createdById])
  @@index([expiresAt])
}

/**
 * PHASE-G0 CORRECTION — the durable bridge between a video production contract
 * and the REAL question bank it was reviewed against.
 * WHY IT IS A TABLE AND NOT THREE NULLABLE COLUMNS. The link is meaningful only
 * as a whole: an AssessmentVersion without the revision it was fingerprinted at,
 * or a fingerprint without the bank it describes, is not a weaker link — it is a
 * FALSE one. SQLite refuses a CHECK on `ALTER TABLE ADD COLUMN`, so nullable
 * columns on VideoProductionVersion could not have carried a real all-or-nothing
 * constraint and the pairing would have lived only in the domain. A new table
 * CAN declare its constraints inline, so "linked" is a row that exists with
 * every column NOT NULL and "unlinked" is the absence of a row. There is no
 * half-linked state for a reader to reason about.
 * ONE BANK PER CONTRACT. `videoProductionVersionId` is unique: a production
 * contract is coherent with exactly one bank, and a level whose candidate bank
 * is ambiguous gets NO row rather than a guess.
 * `assessmentBankFingerprint` IS SERVER-COMPUTED, ALWAYS. It is
 * `calculateAssessmentFingerprint` — the accepted Phase-C function — applied to
 * `projectAssessmentBank`, which reads QuestionDefinition and its canonical
 * QuestionLocalization. It is never accepted from a caller, and staleness is
 * DERIVED by recomputing it rather than by trusting a stored boolean.
 */
model VideoProductionAssessmentLink {
  id                        Int      @id @default(autoincrement())
  /// One bank per production contract. Unique, so a link can never fork.
  videoProductionVersionId  Int      @unique
  assessmentVersionId       Int
  /// The bank's aggregate revision at the moment the fingerprint was computed.
  assessmentRevision        Int
  /// Server-computed over the DURABLE bank. Never caller-supplied.
  assessmentBankFingerprint String
  linkedById                Int?
  linkedAt                  DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  videoProductionVersion VideoProductionVersion @relation(fields: [videoProductionVersionId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  assessmentVersion      AssessmentVersion      @relation(fields: [assessmentVersionId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  linkedBy               User?                  @relation("VideoProductionAssessmentLinker", fields: [linkedById], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([assessmentVersionId])
  @@index([linkedById])
}

/// PHASE-G2 FOUNDATION — one adjudicated FIELD conflict between the Blueprint
/// proposal and the durable bank.
///
/// It records a DECISION, never a value. Nothing here rewrites a prompt, an
/// option or a correct answer, so the raw disagreement stays exactly where it
/// always was — computed live from the two sides — and remains fully
/// inspectable after adjudication. What changes is that the platform can now
/// say which side a named human chose, on what evidence, and when.
///
/// A row is only meaningful for the two values it was decided against, which is
/// why both sides are pinned by hash. If either side moves afterwards the
/// projection reports the decision as stale and the conflict blocks again.
model SourceAuthorityResolution {
  id Int @id @default(autoincrement())

  assessmentVersionId      Int
  videoProductionVersionId Int
  levelDefinitionId        Int
  curriculumVersionId      Int
  /// Zero-based question ordinal, matching the accepted `questions[N]` grammar.
  questionIndex            Int
  /// `prompt` or `correctAnswerText` — the accepted conflict fields.
  field                    String
  /// The accepted path, verbatim, e.g. `questions[0].prompt`.
  conflictPath             String

  /// `CURRENT` or `BLUEPRINT`.
  decision String

  /// The exact two values compared, by sha256. Server-computed.
  currentValueHash   String
  blueprintValueHash String

  blueprintSourceDocumentSha256 String
  contractFingerprintAtDecision String
  bankFingerprintAtDecision     String
  assessmentRevisionAtDecision  Int

  rationale      String
  /// Durable evidence identity, e.g. the adjudication artifact's filename.
  evidenceRef    String
  evidenceSha256 String

  /// Groups one atomic adjudication request.
  batchId String

  decidedById Int
  decidedAt   DateTime @default(now())
  createdAt   DateTime @default(now())

  /// Supersession rather than deletion — history is never removed.
  supersededAt   DateTime?
  supersededById Int?

  assessmentVersion      AssessmentVersion      @relation(fields: [assessmentVersionId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  videoProductionVersion VideoProductionVersion @relation(fields: [videoProductionVersionId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  levelDefinition        LevelDefinition        @relation(fields: [levelDefinitionId, curriculumVersionId], references: [id, curriculumVersionId], onDelete: Restrict, onUpdate: Cascade)
  decidedBy              User                   @relation("SourceAuthorityResolutionDecider", fields: [decidedById], references: [id], onDelete: Restrict, onUpdate: Cascade)
  supersededBy           User?                  @relation("SourceAuthorityResolutionSuperseder", fields: [supersededById], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([assessmentVersionId, supersededAt])
  @@index([curriculumVersionId, levelDefinitionId])
  @@index([batchId])
  @@index([decidedById])
  @@index([supersededById])
}

