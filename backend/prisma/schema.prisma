/**
 * L4VC-1 — the configured threshold for one financial-checkpoint level.
 * One requirement per level (`levelDefinitionId` is unique). The threshold is an
 * INTEGER in minor units so $50.00 is 5000 and no float rounding can ever move
 * a gate. `integrationCode` names which provider integration answers for this
 * level; it is a code, not a URL and not a credential.
 * A level with no row here is `requirement_unconfigured` and is never verified —
 * the platform will not invent a threshold.
 */
model LevelCheckpointRequirement {
  id                  Int             @id @default(autoincrement())
  levelDefinitionId   Int             @unique
  integrationCode     String
  thresholdCurrency   String
  thresholdMinorUnits Int
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  levelDefinition     LevelDefinition @relation(fields: [levelDefinitionId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([integrationCode])
}

/**
 * L4VC-1 — one verification attempt, and the durable receipt that replays it.
 * WHAT IT DELIBERATELY DOES NOT HAVE: a balance column, a demo balance column,
 * a remaining-amount column, an account identifier, a token, or a `Json` bag a
 * provider payload could be poured into. The privacy contract is enforced by
 * the ABSENCE of columns, so no future code path can persist an observed
 * amount without a schema change and a migration review.
 * `observedAt` is a timestamp, not a measurement: it records how fresh the
 * provider's answer was, which is what makes `stale` meaningful.
 */
model CheckpointVerificationAttempt {
  id                Int                           @id @default(autoincrement())
  enrollmentId      Int
  levelDefinitionId Int
  requestId         String
  outcome           CheckpointVerificationOutcome
  providerRequestId String?
  observedAt        DateTime?
  cooldownUntil     DateTime?
  createdAt         DateTime                      @default(now())
  completedAt       DateTime?
  enrollment        UserCurriculumEnrollment      @relation(fields: [enrollmentId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  levelDefinition   LevelDefinition               @relation(fields: [levelDefinitionId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([enrollmentId, levelDefinitionId, requestId])
  @@index([enrollmentId, requestId])
  @@index([enrollmentId, levelDefinitionId, createdAt])
  @@index([levelDefinitionId])
}

/// A8 — the two QA event classes an operator may attest on PREPROD.
///
/// Named rather than free text so a third class cannot appear at runtime, and
/// so each class is bound to exactly one completion owner in
/// src/lib/curriculum/completion.ts.
enum StagingAttestationEventClass {
  /// Stands in for the authenticated Pocket registration postback (level 1).
  pocket_registration
  /// Stands in for a passed financial checkpoint gate.
  financial_checkpoint
}

/**
 * A8 — a PREPROD operator's attestation that a QA gate should be considered
 * satisfied.
 * WHAT ONE ROW MEANS, EXACTLY
 * "An authorized operator, on a deployment authoritatively classified
 * `staging`, attested that this enrollment's gate at this level should be
 * treated as satisfied for QA." It does NOT mean the learner deposited money,
 * and it does NOT mean Pocket witnessed a registration. Production is
 * unaffected: it remains Pocket-authoritative for both.
 * WHAT THIS TABLE CANNOT REPRESENT, STRUCTURALLY
 * There is no amount column, no currency column, no balance column, no Pocket
 * user id, no click id and no provider payload. A staging attestation therefore
 * cannot fabricate a financial event or a partner event even by mistake — the
 * shape has nowhere to put one. It is also NOT a
 * `CheckpointVerificationAttempt`: that table means "the platform asked a
 * balance provider", and writing a fake `met` row into it would corrupt both
 * the cooldown window and the meaning of every honest row.
 * WHY `environment` IS STORED ON THE ROW
 * The runtime gate already refuses outside staging. Recording the
 * classification the row was MADE under means a database copied from PREPROD to
 * anywhere else still carries rows that identify themselves as staging-only,
 * and the completion primitive re-checks it. A CHECK constraint pins the column
 * to the single legal value.
 * IDEMPOTENCY AND EXACTNESS
 * `(enrollmentId, levelDefinitionId, requestId)` is unique, so an identical
 * retry resolves to the one row instead of a second attestation.
 * `(enrollmentId, levelDefinitionId, eventClass)` is unique too, so a gate can
 * be attested exactly once however many request identities are tried.
 */
model StagingAttestation {
  id                Int                          @id @default(autoincrement())
  eventClass        StagingAttestationEventClass
  enrollmentId      Int
  levelDefinitionId Int
  /// Operator-supplied idempotency identity. Never a learner value.
  requestId         String
  /// The operator. Never the learner: the domain refuses self-attestation.
  attestedById      Int
  /// Always the literal `staging`. Pinned by a CHECK constraint.
  environment       String                       @default("staging")
  attestedAt        DateTime                     @default(now())
  createdAt         DateTime                     @default(now())

  enrollment      UserCurriculumEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  levelDefinition LevelDefinition          @relation(fields: [levelDefinitionId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  attestedBy      User                     @relation("StagingAttestationOperator", fields: [attestedById], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([enrollmentId, levelDefinitionId, requestId])
  @@unique([enrollmentId, levelDefinitionId, eventClass])
  @@index([enrollmentId, requestId])
  @@index([attestedById, attestedAt])
  @@index([levelDefinitionId])
}

/**
 * L4PA-1 — the authoritative binding between an ATA learner and a Pocket trader.
 * WHY THIS EXISTS RATHER THAN `ExchangeAccount.traderId`
 * `traderId` looks like the same fact and is not. It is nullable, it is NOT
 * unique, it is written by EVERY authenticated postback goal (deposit,
 * withdrawal, commission — not just registration), and the processor overwrites
 * it with `traderId ?? existing`, so a later postback silently rebinds a learner
 * to a different Pocket account. It is also one of the OR-branches the account
 * lookup itself searches, so it is an attribution hint, not an identity claim.
 * Using it to authorise a $50 financial gate would mean the gate could be moved
 * onto someone else's funded account without anyone noticing.
 * This table states the fact once, immutably in practice, with the uniqueness
 * the gate actually requires:
 * - `userId` UNIQUE  — one learner has at most one authoritative Pocket ID;
 * - `pocketUserId` UNIQUE — one Pocket trader backs at most one learner.
 * Both constraints are enforced by the DATABASE, so two concurrent registration
 * postbacks cannot both win and a conflict cannot be resolved by overwriting.
 * `pocketUserId` is TEXT holding a canonical decimal integer, not INTEGER: it
 * is a foreign system's identifier that must round-trip exactly, and comparing
 * canonical strings avoids ever depending on float behaviour for an identity.
 * PRIVACY BY ABSENCE. There is no balance column, no demo balance, no deposit
 * total, no FTD, no raw postback, no raw provider response, no free-form JSON,
 * no API token and no generated hash. Storing a learner's money here would
 * require a new migration and a review, which is the point.
 */
model PocketTraderIdentity {
  id           Int           @id @default(autoincrement())
  userId       Int           @unique
  pocketUserId String        @unique
  clickId      String
  /**
   * Provenance of the binding. Only `registration_postback` is written today.
   */
  source       String        @default("registration_postback")
  boundAt      DateTime      @default(now())
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  user         User          @relation("PocketTraderIdentityLearner", fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  /// G4-GROWTH. The `pocket_reg` event this binding produced.
  growthEvents GrowthEvent[] @relation("GrowthEventPocketIdentity")

  @@index([clickId])
  /// AFD-5B1 — the trusted Pocket-registration metric counts this table by
  /// `boundAt`. Without this the date-ranged count was a full table scan.
  @@index([source, boundAt])
}

/// AFD-4 — which provider produced an event. One member today, named rather
/// than assumed, so a second provider cannot silently inherit Pocket's
/// idempotency namespace.
enum PocketProviderEventProvider {
  pocket
}

/// AFD-4 — the provider event types ATA can canonically own.
///
/// `first_deposit` is deliberately the only member. Pocket's callback carries no
/// transaction id, no event id and no occurrence time, so ATA cannot tell a
/// replay from a correction from a genuine second deposit. Adding `redeposit`
/// here would be claiming a distinction the provider does not supply.
enum PocketProviderEventType {
  first_deposit
  redeposit
}

/// How much is truthfully known about a provider event's time.
enum PocketProviderEventTimeStatus {
  /// No usable provider event time arrived.
  absent
  /// A provider-local wall clock, with no zone anybody can vouch for.
  local_only
  /// The delivery stated its own offset, so the instant is the provider's claim.
  absolute_from_sender
}

/// AFD-4 — how far an event has got towards being a countable conversion.
///
/// `pending_identity` is the honest state for a deposit that arrived before the
/// registration that would tell us whose it is. `conflict` is a quarantine, not
/// an error state: the row is kept exactly as first received so an operator can
/// see what disagreed, and no later delivery may overwrite it.
enum PocketProviderEventStatus {
  pending_identity
  matched
  conflict
}

/// AFD-4 — whether the stored amount has a known unit. See
/// `POCKET_DEPOSIT_CURRENCY`.
enum PocketProviderEventCurrencyStatus {
  unspecified
  configured
}

/// AFD-4 — the bounded set of disagreements that quarantine an event.
enum PocketProviderEventConflictCode {
  /// A later delivery for this player named a different Pocket click id.
  click_id_mismatch
  /// A later delivery for this player reported a different amount.
  amount_mismatch
  /// The click resolves to one learner and the Pocket identity to another.
  identity_owner_mismatch
  /// The click id no longer resolves to any exchange account.
  click_owner_missing
}

/// AFD-4 — the canonical record of one Pocket provider event.
///
/// THE DOMAIN INVARIANT THIS TABLE EXISTS TO ENFORCE: one Pocket player produces
/// at most one canonical first deposit. That is a database fact here, not an
/// application convention — `UNIQUE(provider, eventType, pocketPlayerId)` is
/// what a replayed, retried or concurrent callback collides with.
///
/// WHY THE KEY IS THE PLAYER AND NOT A TRANSACTION ID. Pocket sends no unique
/// deposit identifier. AFD-1 established that the existing
/// `PostbackEvent.externalEventId` therefore stays null for deposits and the
/// event records as `not_processed`. Synthesising a key from the amount and a
/// timestamp — which an earlier revision of the legacy route did — is forbidden
/// in both directions: two real deposits of the same size in the same second
/// collapse into one, and a redelivery with a different clock looks like new
/// money.
///
/// THE CANONICAL VALUES ARE IMMUTABLE. `pocketClickId` and `normalizedAmount`
/// are written once, by the first accepted delivery, and no later delivery may
/// change them. A delivery that disagrees is recorded as a conflict beside them,
/// never on top of them.
model PocketProviderEvent {
  id                    Int                               @id @default(autoincrement())
  provider              PocketProviderEventProvider       @default(pocket)
  eventType             PocketProviderEventType
  /// The Pocket click id as delivered. Immutable after the first acceptance.
  pocketClickId         String
  /// The Pocket player id. Together with provider and type, the identity of the
  /// event.
  pocketPlayerId        String
  /// Null until the click owner and the Pocket identity agree on one learner.
  matchedUserId         Int?
  /// Canonical decimal TEXT, always two fractional digits. Never a float, and
  /// never a balance.
  normalizedAmount      String
  /// Null whenever Pocket did not tell us the unit and no operator configured
  /// one. Never defaulted to USD.
  currencyCode          String?
  currencyStatus        PocketProviderEventCurrencyStatus @default(unspecified)
  status                PocketProviderEventStatus         @default(pending_identity)
  firstReceivedAt       DateTime
  lastReceivedAt        DateTime
  /// Bounded count of identical redeliveries. Metadata about transport, not
  /// about money: it never implies more than one deposit.
  replayCount           Int                               @default(0)
  conflictCode          PocketProviderEventConflictCode?
  conflictDetectedAt    DateTime?
  matchedAt             DateTime?
  /// POCKET-DEP-RDEP-1. ATA's own deterministic redeposit identity, derived from
  /// provider + player + normalised DATE_TIME + exact amount. NULL for a first
  /// deposit, which is identified by its player. NOT a provider-issued id: the
  /// residual collision risk is BUSINESS_ACCEPTED_RDEP_DEDUP_ASSUMPTION.
  providerEventKey      String?
  /// The provider's local wall clock, normalised. ZONE-INDEPENDENT and always
  /// present for a redeposit: this is what Pocket's own clock read, and what the
  /// deterministic key is built from.
  providerEventLocal    String?
  /// The ABSOLUTE provider instant. NULL unless the delivery stated its own
  /// offset — Pocket renders DATE_TIME in a zone that varies by user, account
  /// and registration GEO, so there is no global zone ATA could apply without
  /// fabricating one. Never a receive time, never now().
  providerEventAt       DateTime?
  /// Which of the two above is true, so nothing can mistake "we do not know the
  /// instant" for "it happened then".
  providerEventAtStatus PocketProviderEventTimeStatus     @default(absent)
  /// The exact DATE_TIME bytes the provider sent, kept so a zone declared later
  /// can be applied without re-deriving anything.
  providerEventAtRaw    String?
  createdAt             DateTime                          @default(now())
  updatedAt             DateTime                          @updatedAt
  matchedUser           User?                             @relation("PocketProviderEventLearner", fields: [matchedUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  /// One canonical FIRST DEPOSIT per provider/player, and one canonical
  /// REDEPOSIT per derived key. Both are PARTIAL indexes in migration 49, which
  /// Prisma cannot express — see that migration for the authoritative shape.
  @@unique([provider, eventType, providerEventKey])
  @@index([provider, pocketPlayerId, eventType])
  @@index([eventType, pocketPlayerId, providerEventAt])
  @@index([pocketClickId])
  @@index([matchedUserId])
  @@index([status, firstReceivedAt])
  /// AFD-5B1 — conflicting deposits are counted by `conflictDetectedAt`, which
  /// the composite above does not carry, so its range was unindexed.
  @@index([status, conflictDetectedAt])
  @@index([conflictCode])
  @@index([lastReceivedAt])
}

/// AFD-2 — administrative affiliate foundation.
///
/// These three tables describe WHO buys traffic and WHICH named link they were
/// given. They deliberately hold no click, no visitor, no attribution, no
/// conversion and no learner: acquisition data arrives in AFD-3B and lives in
/// its own tables. Nothing here is reachable from an unauthenticated request.
enum AffiliateEntityStatus {
  active
  paused
  archived
}

/// Tracking-link lifecycle. AFD-3B2 adds `active`, which AFD-2 deliberately
/// refused to invent before a public route and an attribution owner existed.
/// Stored status is what an operator chose; whether a link can actually serve
/// traffic also depends on the feature switch and on its parents, which is a
/// runtime question answered by `effectiveAvailability`, not by this column.
enum AffiliateTrackingLinkStatus {
  draft
  active
  paused
  archived
}

/// How a click was treated by the public acquisition route. Only `qualified`
/// can ever be attributed — the other two exist so that machine traffic and
/// clicks by already-registered users are recorded honestly instead of being
/// dropped or, worse, counted.
enum AffiliateClickClassification {
  qualified
  prefetch
  authenticated_user
}

/// The attribution model in force. One value in AFD-3B2, named rather than
/// implied so a stored decision says which rule produced it.
enum AffiliateAttributionModel {
  last_eligible_affiliate_click
}

/// Why a particular click was selected.
enum AffiliateAttributionSelectionReason {
  registration_cookie
}

/// Conversion-event types. Deposit-shaped events belong to AFD-4 and are absent.
enum AffiliateConversionEventType {
  academy_registration
  /// AFD-4. At most one per Pocket player, emitted only once the deposit's
  /// Pocket identity has been legally bound by a trusted `goal=reg`.
  first_deposit
  /// AFFILIATE-PLATFORM-V1 §41. Every canonical redeposit after the FTD.
  ///
  /// IT IS A STATISTIC AND A POSTBACK, AND IT IS NOT A CPA EVENT. The
  /// qualification owner accepts `first_deposit` and nothing else, so this
  /// value cannot reach a commission however it is produced. It exists because
  /// a partner is owed the truth about redeposit volume, not because a
  /// redeposit earns anything.
  ///
  /// WHY IT WAS ABSENT UNTIL NOW. The financial phase closed with redeposits as
  /// canonical PocketProviderEvent rows and Growth `rdep` events, and refused to
  /// invent an affiliate conversion type it had no partner-facing consumer for.
  /// This phase builds that consumer, so the type is added WITH its reader.
  redeposit
}

/// AFD-4 — whether a money-bearing conversion knows its unit.
///
/// Null on rows that carry no money at all. On a `first_deposit` it is always
/// present, and it is the field that makes an unknown currency an explicit,
/// queryable state rather than an absence somebody later "fixes" by assuming
/// dollars.
enum AffiliateConversionCurrencyStatus {
  unspecified
  configured
}

/// The owner that produced a conversion event, and therefore the namespace its
/// `sourceEventId` is unique within.
enum AffiliateConversionSourceOwner {
  auth_register
  /// AFD-4. Its `sourceEventId` names a PocketProviderEvent ROW, never a Pocket
  /// player or click id, so no provider identifier reaches the ledger's key.
  pocket_first_deposit
  /// AFFILIATE-PLATFORM-V1. Same rule as `pocket_first_deposit`: the
  /// `sourceEventId` names the canonical PocketProviderEvent ROW for the
  /// redeposit, never the ATA-derived provider key and never a Pocket player.
  /// A redeposit's canonical row is already unique per derived key (migration
  /// 49's partial index), so keying on the row id inherits that uniqueness
  /// without republishing a provider identifier into the affiliate ledger.
  pocket_redeposit
}

/// The server-owned logical destination of a tracking link. A KEY, never a URL:
/// storing a URL would make every link a redirector for whatever an operator
/// pasted, which is the open-redirect this design refuses to have.
enum AffiliateLandingKey {
  academy_registration
}

model AffiliatePartner {
  id                           Int                         @id @default(autoincrement())
  /// Immutable, lowercase, globally unique operator-facing handle.
  code                         String                      @unique
  displayName                  String
  description                  String?
  status                       AffiliateEntityStatus       @default(active)
  /// Inherited by links that set no window of their own. Bounded 1..365.
  defaultAttributionWindowDays Int                         @default(30)
  createdByUserId              Int
  createdAt                    DateTime                    @default(now())
  updatedAt                    DateTime                    @updatedAt
  archivedAt                   DateTime?
  createdBy                    User                        @relation("AffiliatePartnerCreator", fields: [createdByUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  campaigns                    AffiliateCampaign[]
  trackingLinks                AffiliateTrackingLink[]
  conversionEvents             AffiliateConversionEvent[]
  /// AFFILIATE-PLATFORM-V1 — the humans who may sign in for this partner, the
  /// money it has earned, and where its conversions are delivered.
  partnerUsers                 AffiliatePartnerUser[]
  cpaQualifications            AffiliateCpaQualification[]
  commissions                  AffiliateCommission[]
  postbackEndpoints            AffiliatePostbackEndpoint[]
  postbackDeliveries           AffiliatePostbackDelivery[]

  @@index([status, createdAt])
  @@index([createdAt])
  @@index([createdByUserId])
}

model AffiliateCampaign {
  id                 Int                         @id @default(autoincrement())
  affiliatePartnerId Int
  /// Immutable and lowercase. Unique WITHIN one partner, so two affiliates may
  /// each run a campaign called `summer`.
  code               String
  displayName        String
  notes              String?
  status             AffiliateEntityStatus       @default(active)
  createdByUserId    Int
  createdAt          DateTime                    @default(now())
  updatedAt          DateTime                    @updatedAt
  archivedAt         DateTime?
  partner            AffiliatePartner            @relation(fields: [affiliatePartnerId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  createdBy          User                        @relation("AffiliateCampaignCreator", fields: [createdByUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  trackingLinks      AffiliateTrackingLink[]
  conversionEvents   AffiliateConversionEvent[]
  /// AFFILIATE-PLATFORM-V1 §9/§10 — this campaign IS the commercial owner, and
  /// these are its priced versions. Append-only; at most one is `active`.
  commercialTerms    AffiliateCampaignTerms[]
  cpaQualifications  AffiliateCpaQualification[]

  @@unique([affiliatePartnerId, code])
  /// Composite target for the tracking-link FK that proves a link and its
  /// campaign belong to the SAME partner without a runtime read.
  @@unique([id, affiliatePartnerId])
  @@index([affiliatePartnerId, status, createdAt])
  @@index([createdAt])
  @@index([createdByUserId])
}

model AffiliateTrackingLink {
  id                     Int                         @id @default(autoincrement())
  affiliatePartnerId     Int
  affiliateCampaignId    Int?
  /// Server-generated, 160-bit, URL-safe, immutable and globally unique. Never
  /// accepted from a client, and it embeds no database id and no partner code.
  publicCode             String                      @unique
  displayName            String
  status                 AffiliateTrackingLinkStatus @default(draft)
  landingKey             AffiliateLandingKey         @default(academy_registration)
  /// Names of INCOMING query parameters this link will accept in AFD-3B. These
  /// are parameter NAMES, never captured values.
  externalClickParameter String                      @default("clickid")
  sub1Parameter          String?
  sub2Parameter          String?
  sub3Parameter          String?
  sub4Parameter          String?
  sub5Parameter          String?
  /// Null inherits AffiliatePartner.defaultAttributionWindowDays.
  attributionWindowDays  Int?
  /// The STAFF `User` who created this link, when staff created it.
  ///
  /// NULLABLE SINCE AFFILIATE-PLATFORM-V1, and the change is deliberate. A link
  /// a partner created for itself has no accountable ATA employee, and naming
  /// one — the staff member who happened to create the partner login, say —
  /// would be a false authorship claim in the table an operator consults when
  /// asking who published a public acquisition URL. Exactly one of the two
  /// creator columns is non-null, enforced by a CHECK constraint.
  createdByUserId        Int?
  createdAt              DateTime                    @default(now())
  updatedAt              DateTime                    @updatedAt
  archivedAt             DateTime?
  partner                AffiliatePartner            @relation(fields: [affiliatePartnerId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  campaign               AffiliateCampaign?          @relation(fields: [affiliateCampaignId, affiliatePartnerId], references: [id, affiliatePartnerId], onDelete: Restrict, onUpdate: Cascade)
  createdBy              User?                       @relation("AffiliateTrackingLinkCreator", fields: [createdByUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  clicks                 AffiliateClick[]
  conversionEvents       AffiliateConversionEvent[]
  /// AFFILIATE-PLATFORM-V1 §20 — a link may now be created by a PARTNER human
  /// rather than by staff. Exactly one of the two creator axes is set, enforced
  /// by a CHECK constraint in migration50: a link with neither creator has no
  /// accountable author, and a link with both is a contradiction.
  createdByPartnerUserId Int?
  createdByPartnerUser   AffiliatePartnerUser?       @relation("AffiliateTrackingLinkPartnerCreator", fields: [createdByPartnerUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  cpaQualifications      AffiliateCpaQualification[]

  @@index([createdByPartnerUserId])
  @@index([affiliatePartnerId, status, createdAt])
  @@index([affiliateCampaignId, status, createdAt])
  @@index([status, createdAt])
  @@index([createdAt])
  @@index([createdByUserId])
}

/// AFD-3B2 — one row per request the public acquisition route accepted.
///
/// PRIVACY BY SHAPE. There is no column here for a raw IP address, a
/// User-Agent, a complete request URL, a query string, a cookie or any
/// authorization material, so none of them can be stored by accident. The only
/// externally supplied values are those of parameters an operator explicitly
/// configured on the link, each bounded and control-character-free.
model AffiliateClick {
  id                             Int                          @id @default(autoincrement())
  /// OUR acquisition click id: 160 CSPRNG bits as 32 lowercase base32
  /// characters, globally unique, never accepted from a client, and not the
  /// affiliate network's click id nor any Pocket identifier.
  ataClickId                     String                       @unique
  trackingLinkId                 Int
  /// The anonymous visitor journey this click belongs to. NULL for prefetch and
  /// for authenticated-user clicks, which is what makes those permanently
  /// unattributable at the database level rather than by convention.
  anonymousVisitorId             String?
  /// The AFFILIATE NETWORK's own click id, from the link-configured parameter.
  /// Deliberately not unique: networks legitimately repeat values.
  externalAffiliateClickId       String?
  sub1                           String?
  sub2                           String?
  sub3                           String?
  sub4                           String?
  sub5                           String?
  classification                 AffiliateClickClassification
  /// The attribution window as it stood WHEN THE CLICK HAPPENED. Eligibility is
  /// judged against this snapshot, so later edits to the link or the partner
  /// cannot retroactively create or destroy attribution for past traffic.
  effectiveAttributionWindowDays Int
  /// A bare lowercase host, never a URL, a path or a query.
  sanitizedReferrerHost          String?
  occurredAt                     DateTime
  createdAt                      DateTime                     @default(now())
  trackingLink                   AffiliateTrackingLink        @relation(fields: [trackingLinkId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  firstTouchOf                   AffiliateAttribution[]       @relation("AffiliateAttributionFirstTouch")
  lastTouchOf                    AffiliateAttribution[]       @relation("AffiliateAttributionLastTouch")
  selectedBy                     AffiliateAttribution[]       @relation("AffiliateAttributionSelected")
  conversionEvents               AffiliateConversionEvent[]
  /// G4-GROWTH. The `traffic_click` event, plus every downstream event this
  /// click is the acquisition origin of.
  growthEvents                   GrowthEvent[]                @relation("GrowthEventAcquisitionClick")

  @@index([trackingLinkId, occurredAt])
  @@index([anonymousVisitorId, occurredAt])
  @@index([externalAffiliateClickId])
  @@index([classification, occurredAt])
}

/// AFD-3B2 — the frozen answer to "which affiliate acquired this learner".
///
/// Written once, inside the registration transaction, and never again. There is
/// no PATCH owner, no DELETE owner and no reattribution path in the application.
/// The two unique constraints make the two dangerous mistakes unrepresentable:
/// a user cannot acquire a second attribution, and one visitor journey cannot be
/// spent twice — which is precisely what a copied or replayed token attempts.
model AffiliateAttribution {
  id                 Int                                 @id @default(autoincrement())
  userId             Int                                 @unique
  anonymousVisitorId String                              @unique
  firstTouchClickId  Int
  lastTouchClickId   Int
  selectedClickId    Int
  attributionModel   AffiliateAttributionModel
  selectedAt         DateTime
  /// Separate from `selectedAt` on purpose: when a decision was computed and
  /// when it became immutable are different facts.
  frozenAt           DateTime
  selectionReason    AffiliateAttributionSelectionReason
  createdAt          DateTime                            @default(now())
  user               User                                @relation("UserAffiliateAttribution", fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  firstTouchClick    AffiliateClick                      @relation("AffiliateAttributionFirstTouch", fields: [firstTouchClickId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  lastTouchClick     AffiliateClick                      @relation("AffiliateAttributionLastTouch", fields: [lastTouchClickId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  selectedClick      AffiliateClick                      @relation("AffiliateAttributionSelected", fields: [selectedClickId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  conversionEvents   AffiliateConversionEvent[]
  /// G4-GROWTH. Growth events carrying the frozen acquisition answer.
  growthEvents       GrowthEvent[]                       @relation("GrowthEventAttribution")
  /// AFFILIATE-PLATFORM-V1 §15 — the qualifications that READ this frozen
  /// answer. They never write it: attribution is decided at registration and a
  /// deposit resolves it, so this relation only ever grows.
  cpaQualifications  AffiliateCpaQualification[]

  @@index([selectedClickId])
  @@index([selectedAt])
}

/// AFD-3B2 — the append-only conversion ledger.
///
/// Exactly one `academy_registration` row per successful public registration,
/// INCLUDING a direct one, whose affiliate columns are all NULL. A direct
/// registration that produced no row would be indistinguishable from one the
/// ledger missed, and "nobody referred this learner" must not look like "we do
/// not know". The snapshots are denormalised so a payout report still reads the
/// code an affiliate had at conversion time after a rename or an archive.
model AffiliateConversionEvent {
  id                             Int                                @id @default(autoincrement())
  eventId                        String                             @unique
  eventType                      AffiliateConversionEventType
  userId                         Int
  attributionId                  Int?
  selectedClickId                Int?
  affiliatePartnerId             Int?
  affiliateCampaignId            Int?
  trackingLinkId                 Int?
  affiliateCodeSnapshot          String?
  campaignCodeSnapshot           String?
  trackingLinkPublicCodeSnapshot String?
  sourceOwner                    AffiliateConversionSourceOwner
  /// The producing owner's idempotency key. Never an email address — an email
  /// is mutable and re-registrable, and would make replay look like a new
  /// conversion.
  sourceEventId                  String
  /// AFD-4 — the provider-reported conversion amount, as canonical decimal TEXT.
  ///
  /// Null for `academy_registration`, which has no money. Present for every
  /// `first_deposit`. It is ONE IMMUTABLE REPORTED AMOUNT, not a balance, not a
  /// running total and not something a later event adds to.
  providerAmount                 String?
  /// Null whenever the provider did not state a currency and no operator
  /// configured one. Never defaulted to USD — see `currencyStatus`.
  currencyCode                   String?
  /// Records WHY `currencyCode` is null, so "we know it is unspecified" can
  /// never be misread as "this row has not been backfilled yet".
  currencyStatus                 AffiliateConversionCurrencyStatus?
  occurredAt                     DateTime
  createdAt                      DateTime                           @default(now())
  user                           User                               @relation("UserAffiliateConversionEvents", fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  attribution                    AffiliateAttribution?              @relation(fields: [attributionId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  selectedClick                  AffiliateClick?                    @relation(fields: [selectedClickId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  partner                        AffiliatePartner?                  @relation(fields: [affiliatePartnerId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  campaign                       AffiliateCampaign?                 @relation(fields: [affiliateCampaignId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  trackingLink                   AffiliateTrackingLink?             @relation(fields: [trackingLinkId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  /// AFFILIATE-PLATFORM-V1. At most one qualification (first_deposit only), and
  /// any number of outbound deliveries — one per endpoint version.
  cpaQualification               AffiliateCpaQualification?
  postbackDeliveries             AffiliatePostbackDelivery[]

  @@unique([eventType, sourceOwner, sourceEventId])
  @@index([eventType, occurredAt])
  @@index([affiliatePartnerId, occurredAt])
  @@index([affiliateCampaignId, occurredAt])
  @@index([trackingLinkId, occurredAt])
  @@index([userId, occurredAt])
}

// ============================================================================
// AFFILIATE PLATFORM V1 — partner principal, commercial terms, CPA, outbound
// ============================================================================

/// Whether a partner human may sign in. Two values, because V1 owns exactly two
/// facts: staff created this login, and staff can stop it. There is no
/// `invited`, no `pending` and no `locked` — none of them has an owner yet, and
/// a state nothing can leave is worse than a state that does not exist.
enum AffiliatePartnerUserStatus {
  active
  disabled
}

/// The lifecycle of one COMMERCIAL TERMS VERSION.
///
/// A version is never edited. Changing the CPA supersedes the current row and
/// writes a new one, which is what makes §11 structural rather than a promise:
/// there is no UPDATE path that could reach the amount a past commission was
/// computed from.
enum AffiliateCommercialTermsStatus {
  active
  superseded
}

/// Whether a partner's outbound destination may be delivered to. `disabled`
/// stops future delivery and terminates pending ones; it never erases the
/// deliveries that already happened.
enum AffiliatePostbackEndpointStatus {
  active
  disabled
}

/// The state of ONE LOGICAL DELIVERY — one conversion to one endpoint version.
///
/// `failed_retryable` and `failed_terminal` are separate because the difference
/// decides whether a worker will ever touch the row again, and an operator
/// looking at a failure needs to know that without reading retry arithmetic.
enum AffiliatePostbackDeliveryStatus {
  pending
  delivered
  failed_retryable
  failed_terminal
}

/// What happened on ONE ATTEMPT. Bounded vocabulary: an attempt records a
/// CLASS, never a provider message, because an arbitrary remote string is
/// exactly what should not be persisted or rendered.
enum AffiliatePostbackAttemptOutcome {
  delivered
  http_4xx
  http_5xx
  http_other
  timeout
  connect_error
  dns_error
  blocked_destination
  too_many_redirects
  response_too_large
  endpoint_disabled
}

/// AFFILIATE-PLATFORM-V1 §17 — a HUMAN who may sign in on behalf of one partner.
///
/// THIS IS NOT THE PARTNER. `AffiliatePartner` is a commercial counterparty;
/// this is a login. Fusing them is the mistake that makes "disable the partner"
/// and "revoke this person's access" the same button, and makes a second person
/// at the same partner impossible to represent.
///
/// IT IS ALSO NOT A `User`. The learner/staff `User` table carries the Academy
/// session, the CRM StaffProfile axis, XP, enrolments and progression. A partner
/// principal that lived there would inherit every one of those relations and
/// would be one `role` column away from reaching the Academy. The separation is
/// physical.
///
/// MEMBERSHIP IS THE FK. V1 is one principal, one partner. `affiliatePartnerId`
/// IS the membership, and every partner-scoped query derives its tenant from
/// the SESSION's principal — never from a request parameter.
model AffiliatePartnerUser {
  id                   Int                         @id @default(autoincrement())
  /// Server-generated, 160-bit, URL-safe. The API never exposes the integer id.
  publicId             String                      @unique
  affiliatePartnerId   Int
  /// Lowercased and trimmed by the only writer. Globally unique, not unique per
  /// partner: an email addresses one human, and the same address signing in to
  /// two partners would make "which tenant am I" a question the login cannot
  /// answer.
  email                String                      @unique
  /// bcrypt, cost 10 — the same construction and cost the learner credential
  /// uses. Never selected by any read path that reaches a response.
  passwordHash         String
  displayName          String
  status               AffiliatePartnerUserStatus  @default(active)
  /// Bumped by a password change or a forced sign-out, and carried inside the
  /// session token. A stale token then fails signature-independent validation,
  /// so "log everyone out" does not need a session table.
  sessionEpoch         Int                         @default(1)
  /// The staff `User` who created this login. Restrict, so the human who
  /// granted partner access cannot be deleted out from under the record.
  createdByUserId      Int
  createdAt            DateTime                    @default(now())
  updatedAt            DateTime                    @updatedAt
  lastLoginAt          DateTime?
  passwordUpdatedAt    DateTime?
  disabledAt           DateTime?
  partner              AffiliatePartner            @relation(fields: [affiliatePartnerId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  createdBy            User                        @relation("AffiliatePartnerUserCreator", fields: [createdByUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  createdTrackingLinks AffiliateTrackingLink[]     @relation("AffiliateTrackingLinkPartnerCreator")
  createdEndpoints     AffiliatePostbackEndpoint[] @relation("AffiliatePostbackEndpointCreator")

  @@index([affiliatePartnerId, status])
  @@index([createdByUserId])
}

/// AFFILIATE-PLATFORM-V1 §10 — the CPA configuration, as an APPEND-ONLY VERSION.
///
/// ONE ACTIVE VERSION PER CAMPAIGN, enforced by a PARTIAL UNIQUE INDEX created
/// in migration50 (Prisma cannot express `WHERE status = 'active'`). Application
/// code that forgot to supersede would therefore fail the write rather than
/// leave a campaign with two live prices.
///
/// THE AMOUNT IS TEXT. `500` and `500.00` are the same money and different
/// strings, so the writer canonicalises before storing, exactly as the deposit
/// amount owner does. It is never a float: this column is multiplied by nothing
/// and summed only by callers that group by currency.
model AffiliateCampaignTerms {
  id                  Int                            @id @default(autoincrement())
  publicId            String                         @unique
  affiliateCampaignId Int
  /// Monotonic per campaign, starting at 1. It is the human-legible name of a
  /// price, and a qualification records it so an operator never has to date-join
  /// to answer "which price was this".
  version             Int
  /// Canonical decimal TEXT. The CPA ATA pays, and NEVER the provider deposit
  /// amount — see AffiliateCommission.
  cpaAmount           String
  /// ISO-4217, uppercase, REQUIRED. Deliberately not nullable and never
  /// defaulted: the provider's deposit currency is `unspecified` in every live
  /// row, and a commission whose unit was also unknown would be unpayable.
  /// ATA chooses what it pays in, so ATA always knows.
  cpaCurrency         String
  status              AffiliateCommercialTermsStatus @default(active)
  effectiveFrom       DateTime
  createdByUserId     Int
  createdAt           DateTime                       @default(now())
  supersededAt        DateTime?
  campaign            AffiliateCampaign              @relation(fields: [affiliateCampaignId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  createdBy           User                           @relation("AffiliateCampaignTermsCreator", fields: [createdByUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  qualifications      AffiliateCpaQualification[]

  @@unique([affiliateCampaignId, version])
  @@index([affiliateCampaignId, status])
  @@index([createdByUserId])
}

/// AFFILIATE-PLATFORM-V1 §14 — WHY a conversion earned a commission.
///
/// Distinct from the FTD on purpose. The FTD is a fact about a learner's money;
/// this is a fact about a commercial agreement, and it answers questions the
/// deposit cannot: which partner, under which terms version, at what rate, at
/// what moment the rule fired.
///
/// UNIQUE(conversionEventId) IS THE WHOLE INVARIANT. Retry, concurrency, a
/// replayed provider delivery and a second worker all collide on it, in the
/// database, and no application path can talk its way past it.
///
/// A ROW EXISTS ONLY WHEN EVERY COMMERCIAL PRECONDITION HELD: an attributed
/// first_deposit, a partner, a campaign and an ACTIVE terms version. An
/// unattributed deposit produces NO row — not a row with nulls — because §6
/// says the financial event stays valid and no partner may be guessed.
model AffiliateCpaQualification {
  id                    Int                      @id @default(autoincrement())
  publicId              String                   @unique
  /// The qualifying conversion. UNIQUE — one FTD, one qualification, forever.
  conversionEventId     Int                      @unique
  affiliatePartnerId    Int
  affiliateCampaignId   Int
  attributionId         Int
  trackingLinkId        Int?
  /// The terms VERSION ROW that applied. Restrict: a price a commission was
  /// computed from cannot be deleted.
  termsId               Int
  /// …and the values it carried, copied. Two independent guarantees against a
  /// retroactive rewrite: the version cannot change, and this copy is not a join.
  termsVersionSnapshot  Int
  cpaAmountSnapshot     String
  cpaCurrencySnapshot   String
  affiliateCodeSnapshot String
  campaignCodeSnapshot  String
  /// When the COMMERCIAL RULE fired. Not when the deposit happened — the
  /// conversion owns that — and not a period boundary either surface may assume.
  qualifiedAt           DateTime
  createdAt             DateTime                 @default(now())
  conversionEvent       AffiliateConversionEvent @relation(fields: [conversionEventId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  partner               AffiliatePartner         @relation(fields: [affiliatePartnerId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  campaign              AffiliateCampaign        @relation(fields: [affiliateCampaignId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  attribution           AffiliateAttribution     @relation(fields: [attributionId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  trackingLink          AffiliateTrackingLink?   @relation(fields: [trackingLinkId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  terms                 AffiliateCampaignTerms   @relation(fields: [termsId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  commission            AffiliateCommission?

  @@index([affiliatePartnerId, qualifiedAt])
  @@index([affiliateCampaignId, qualifiedAt])
  @@index([termsId])
}

/// AFFILIATE-PLATFORM-V1 §13 — ONE EARNED PARTNER LIABILITY.
///
/// THE NARROWEST DURABLE V1, AND NOTHING MORE. There is no status column, no
/// approval, no reversal, no hold, no payout reference and no settlement date,
/// because no owner in this product has authority over any of them. §13 is
/// explicit that inventing an approval workflow without authority is worse than
/// leaving the concept out. A row here means exactly: ATA owes this partner this
/// amount, for this qualification.
///
/// `amount` IS A COPY OF THE CPA SNAPSHOT, NOT THE DEPOSIT. A 500 deposit under
/// 120 CPA terms produces 120 here. The deposit amount lives on the conversion,
/// two joins away, and no query in this platform substitutes one for the other.
model AffiliateCommission {
  id                 Int                       @id @default(autoincrement())
  publicId           String                    @unique
  /// UNIQUE — one qualification can be the source of at most one liability.
  qualificationId    Int                       @unique
  affiliatePartnerId Int
  amount             String
  currencyCode       String
  createdAt          DateTime                  @default(now())
  qualification      AffiliateCpaQualification @relation(fields: [qualificationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  partner            AffiliatePartner          @relation(fields: [affiliatePartnerId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([affiliatePartnerId, createdAt])
}

/// AFFILIATE-PLATFORM-V1 §26 — where a partner wants its conversions delivered.
///
/// ONE ENDPOINT PER PARTNER PER EVENT TYPE. A partner that wanted two consumers
/// of the same event would need a fan-out owner, retry semantics per consumer
/// and a way to say which one failed; none of that exists, so V1 represents one.
///
/// `urlTemplate` IS UNTRUSTED INPUT and is validated twice: at configuration
/// time (shape, scheme, macro vocabulary) and again at delivery time (DNS and
/// address family, on every attempt and after every redirect). Storing a
/// validated string is not a safety property — the address it resolves to can
/// change between the two moments.
///
/// `signingSecret` IS REVEALED EXACTLY ONCE, at creation or rotation, and by no
/// read path afterwards. It is generated server-side; a partner cannot choose
/// it, so it cannot be a password they reused.
model AffiliatePostbackEndpoint {
  id                     Int                             @id @default(autoincrement())
  publicId               String                          @unique
  affiliatePartnerId     Int
  eventType              AffiliateConversionEventType
  /// The macro template. Only names in the closed vocabulary are accepted, and
  /// an unknown `{macro}` is a CONFIGURATION REJECTION, never a literal that
  /// silently ships to the partner's server.
  urlTemplate            String
  /// Bumped whenever `urlTemplate` changes. It is half the delivery idempotency
  /// key: re-pointing an endpoint legitimately produces a NEW logical delivery
  /// for a conversion already delivered to the OLD address, and neither
  /// duplicates the other.
  version                Int                             @default(1)
  status                 AffiliatePostbackEndpointStatus @default(active)
  /// 256 CSPRNG bits. Never returned by any endpoint after the one-time reveal,
  /// never written to a log, never included in an audit payload.
  signingSecret          String
  secretVersion          Int                             @default(1)
  secretRotatedAt        DateTime?
  createdByPartnerUserId Int
  createdAt              DateTime                        @default(now())
  updatedAt              DateTime                        @updatedAt
  disabledAt             DateTime?
  partner                AffiliatePartner                @relation(fields: [affiliatePartnerId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  createdBy              AffiliatePartnerUser            @relation("AffiliatePostbackEndpointCreator", fields: [createdByPartnerUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  deliveries             AffiliatePostbackDelivery[]

  @@unique([affiliatePartnerId, eventType])
  @@index([status])
  @@index([createdByPartnerUserId])
}

/// AFFILIATE-PLATFORM-V1 §27 — ONE LOGICAL DELIVERY.
///
/// UNIQUE(conversionEventId, endpointId, endpointVersion) is the idempotency
/// §27 asks for, stated in the only place that can enforce it. A duplicated
/// worker, a concurrent worker and a manual re-run all collide here. Retries
/// add ATTEMPT rows; they never add delivery rows.
///
/// IT IS WRITTEN OUTSIDE THE CONVERSION TRANSACTION, DELIBERATELY. §28 requires
/// conversion truth to commit independently of delivery, so the enqueue is a
/// separate, idempotent, failure-swallowing step. A conversion that committed
/// with no delivery row is recoverable — a reconciler can see it — whereas a
/// conversion rolled back because a partner's URL was slow is not.
model AffiliatePostbackDelivery {
  id                 Int                              @id @default(autoincrement())
  publicId           String                           @unique
  conversionEventId  Int
  endpointId         Int
  /// The endpoint version this delivery is FOR, copied so the key stays stable
  /// even after the endpoint is re-pointed.
  endpointVersion    Int
  affiliatePartnerId Int
  eventType          AffiliateConversionEventType
  status             AffiliatePostbackDeliveryStatus  @default(pending)
  attemptCount       Int                              @default(0)
  maxAttempts        Int
  nextAttemptAt      DateTime?
  lastAttemptAt      DateTime?
  lastOutcome        AffiliatePostbackAttemptOutcome?
  lastHttpStatus     Int?
  deliveredAt        DateTime?
  /// The resolved request URL, macros substituted. It carries the partner's own
  /// tracking context and no ATA secret — the signature travels in a header, so
  /// nothing here is a credential. Bounded by the template validator.
  requestUrl         String
  createdAt          DateTime                         @default(now())
  updatedAt          DateTime                         @updatedAt
  conversionEvent    AffiliateConversionEvent         @relation(fields: [conversionEventId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  endpoint           AffiliatePostbackEndpoint        @relation(fields: [endpointId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  partner            AffiliatePartner                 @relation(fields: [affiliatePartnerId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  attempts           AffiliatePostbackAttempt[]

  @@unique([conversionEventId, endpointId, endpointVersion])
  @@index([status, nextAttemptAt])
  @@index([affiliatePartnerId, createdAt])
  @@index([endpointId, createdAt])
}

/// AFFILIATE-PLATFORM-V1 §27 — ONE ATTEMPT against one logical delivery.
///
/// `responseSnippet` is bounded and it is the ONLY thing a remote server can put
/// into this database. It is never rendered as HTML by any surface, and the
/// reader that shows it escapes it as text.
model AffiliatePostbackAttempt {
  id              Int                             @id @default(autoincrement())
  deliveryId      Int
  attemptNumber   Int
  startedAt       DateTime
  finishedAt      DateTime
  outcome         AffiliatePostbackAttemptOutcome
  httpStatus      Int?
  durationMs      Int
  /// At most 256 characters of the response body, control characters stripped.
  responseSnippet String?
  delivery        AffiliatePostbackDelivery       @relation(fields: [deliveryId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([deliveryId, attemptNumber])
  @@index([deliveryId, startedAt])
}

