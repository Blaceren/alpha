model ContentVersion {
  id                   Int                   @id @default(autoincrement())
  levelDefinitionId    Int
  curriculumVersionId  Int
  versionNumber        Int
  status               ContentResourceStatus @default(draft)
  videoDurationSeconds Int?
  createdById          Int?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  publishedAt          DateTime?
  archivedAt           DateTime?
  changeNotes          String?

  // ---------------------------------------------------------------- PHASE-G0
  //
  // AGGREGATE AUTHORING REVISION. `revision` covers this version AND every
  // learner-content child under it — localizations and assets. A per-row
  // revision would not have stopped the lost update it is here to stop: two
  // editors working on the same lesson usually touch DIFFERENT children (one
  // rewrites a block, one swaps an image), so per-row guards both succeed and
  // the lesson still ends up in a state neither editor reviewed. Guarding the
  // aggregate makes "the lesson changed under me" the observable event.
  //
  // `lastAuthoredById` is the four-eyes evidence, and it is the LATEST
  // SUBSTANTIVE AUTHOR rather than the creator: it is rewritten by every
  // mutation that bumps `revision`, so it always names the actor whose work is
  // being approved. `createdById` above cannot serve this purpose — it is fixed
  // at creation and says nothing about who wrote the text under review.
  revision             Int            @default(1)
  editorialState       EditorialState @default(draft)
  lastAuthoredById     Int?
  lastAuthoredAt       DateTime?
  submittedById        Int?
  submittedAt          DateTime?
  changesRequestedById Int?
  changesRequestedAt   DateTime?
  approvedById         Int?
  approvedAt           DateTime?

  levelDefinition    LevelDefinition            @relation(fields: [levelDefinitionId, curriculumVersionId], references: [id, curriculumVersionId], onDelete: Restrict, onUpdate: Cascade)
  createdBy          User?                      @relation("ContentVersionCreator", fields: [createdById], references: [id], onDelete: SetNull, onUpdate: Cascade)
  lastAuthoredBy     User?                      @relation("ContentVersionLastAuthor", fields: [lastAuthoredById], references: [id], onDelete: SetNull, onUpdate: Cascade)
  submittedBy        User?                      @relation("ContentVersionSubmitter", fields: [submittedById], references: [id], onDelete: SetNull, onUpdate: Cascade)
  changesRequestedBy User?                      @relation("ContentVersionChangeRequester", fields: [changesRequestedById], references: [id], onDelete: SetNull, onUpdate: Cascade)
  approvedBy         User?                      @relation("ContentVersionApprover", fields: [approvedById], references: [id], onDelete: SetNull, onUpdate: Cascade)
  localizations      ContentLocalization[]
  assets             ContentAsset[]
  resourceBindings   LevelResourceBinding[]
  lessonProgress     UserLessonProgress[]
  reviewNotes        EditorialReviewNote[]      @relation("EditorialReviewNoteContent")
  previewSnapshots   AuthoringPreviewSnapshot[] @relation("AuthoringPreviewSnapshotContent")

  @@unique([id, levelDefinitionId])
  @@unique([levelDefinitionId, versionNumber])
  @@index([curriculumVersionId, status])
  @@index([createdById])
  @@index([curriculumVersionId, editorialState])
  @@index([lastAuthoredById])
  @@index([submittedById])
  @@index([changesRequestedById])
  @@index([approvedById])
}

model ContentLocalization {
  id                         Int            @id @default(autoincrement())
  contentVersionId           Int
  locale                     String
  title                      String
  subtitle                   String         @default("")
  learningObjectiveExtension String         @default("")
