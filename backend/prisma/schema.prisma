enum StaffRole {
  crm_admin
  crm_manager
  retention_manager
  mentor
  support
  moderator
  analyst
  content_manager
  read_only
  /// PHASE-1 ADMIN. The dedicated administrative progression operator; holds
  /// exactly one permission (`curriculum_progress_override`). Adding it is a
  /// code-only change: Prisma models enums as bare TEXT on SQLite and
  /// `StaffProfile.staffRole` carries no CHECK constraint, so the physical
  /// schema is unchanged and no migration accompanies this value.
  progression_operator
}

model StaffProfile {
  id                   String         @id @default(cuid())
  userId               Int            @unique
  displayName          String
  staffRole            StaffRole
  permissionVersion    Int            @default(1)
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  user                 User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  authoredCrmUserNotes CrmUserNote[]  @relation("CrmUserNoteAuthor")
  ownedLearnerStates   CrmUserOwner[] @relation("CrmUserOwnerStaff")

  // Owner-history attribution axes. All three are Restrict-referenced (see
  // CrmUserOwnerHistory), so a StaffProfile named as an actor, previous or next
  // owner cannot be deleted out from under the immutable record.
  actedOwnerHistory    CrmUserOwnerHistory[] @relation("CrmUserOwnerHistoryActor")
  previousOwnerHistory CrmUserOwnerHistory[] @relation("CrmUserOwnerHistoryPrevious")
  nextOwnerHistory     CrmUserOwnerHistory[] @relation("CrmUserOwnerHistoryNext")

  // AGENT-FOUNDATION-1 — the two Agent Core axes that name a human. Both are
  // Restrict-referenced, so a staff profile that initiated a run or decided a
  // proposal cannot be deleted out from under the immutable record. This is a
  // back-reference only: StaffProfile gains no column and remains the single
  // canonical staff identity, because the Agent Core does not introduce a
  // second staff model.
  initiatedAgentRuns   AgentRun[]            @relation("AgentRunInitiator")
  agentActionDecisions AgentActionDecision[] @relation("AgentActionDecisionStaff")

  // LEARNER-OPERATIONS-V1 — every staff attribution axis in the operational
  // department. All are Restrict-referenced on the far side, so a staff profile
  // named as an owner, an actor, an author, an escalation party, a QA reviewer,
  // a knowledge owner or a VOC linker cannot be deleted out from under the
  // record that names them. Back-references only: StaffProfile gains no column
  // and remains the single canonical staff identity. Learner Operations
  // introduces no second staff model.
  learnerOpsAssignedCases       LearnerOpsCase[]             @relation("LearnerOpsCaseAssignee")
  learnerOpsEventsActed         LearnerOpsCaseEvent[]        @relation("LearnerOpsCaseEventActor")
  learnerOpsEventsPreviousOwner LearnerOpsCaseEvent[]        @relation("LearnerOpsCaseEventPreviousAssignee")
  learnerOpsEventsNextOwner     LearnerOpsCaseEvent[]        @relation("LearnerOpsCaseEventNextAssignee")
  learnerOpsMessagesAuthored    LearnerOpsMessage[]          @relation("LearnerOpsMessageStaffAuthor")
  learnerOpsNotesAuthored       LearnerOpsNote[]             @relation("LearnerOpsNoteAuthor")
  learnerOpsEscalationsRaised   LearnerOpsEscalation[]       @relation("LearnerOpsEscalationRaiser")
  learnerOpsEscalationsTargeted LearnerOpsEscalation[]       @relation("LearnerOpsEscalationTargetStaff")
  learnerOpsEscalationsResolved LearnerOpsEscalation[]       @relation("LearnerOpsEscalationResolver")
  learnerOpsQaReviews           LearnerOpsQaReview[]         @relation("LearnerOpsQaReviewer")
  learnerOpsKnowledgeOwned      LearnerOpsKnowledgeArticle[] @relation("LearnerOpsKnowledgeOwner")
  learnerOpsVocOwned            LearnerOpsVocSignal[]        @relation("LearnerOpsVocOwner")
  learnerOpsVocCreated          LearnerOpsVocSignal[]        @relation("LearnerOpsVocCreator")
  learnerOpsVocLinked           LearnerOpsVocSignalCase[]    @relation("LearnerOpsVocSignalLinker")

  // COMMUNITY-V1 — the staff attribution axes in Community moderation. All are
  // Restrict-referenced on the far side, so a staff profile that removed a
  // discussion, restored a reply or resolved a report cannot be deleted out
  // from under the record naming it. Back-references only: StaffProfile gains
  // no column and remains the single canonical staff identity. Community
  // introduces no second staff model and no hardcoded moderator identity.
  communityModerationActions  CommunityModerationAction[] @relation("CommunityModerationActor")
  communityDiscussionsRemoved CommunityDiscussion[]       @relation("CommunityDiscussionRemovedBy")
  communityRepliesRemoved     CommunityReply[]            @relation("CommunityReplyRemovedBy")
  communityReportsResolved    CommunityContentReport[]    @relation("CommunityContentReportResolver")

  @@index([staffRole])
}

// CRM learner note — Notes v1. Immutable, append-only internal staff commentary
// about a learner. There is deliberately no updatedAt, deletedAt, visibility,
// pinned, category, caseId, owner, team, version or author name snapshot: v1
// creates notes and reads them back, nothing else.
//
// Both relations are Restrict on purpose. Deleting a learner who has notes, or
// a StaffProfile that authored notes, fails loudly rather than silently
// orphaning or erasing operational history. The author's display name is always
// resolved live through `author`, so a corrected staff name corrects every note.
model CrmUserNote {
  id        String   @id @default(cuid())
  userId    Int
  authorId  String
  body      String
  createdAt DateTime @default(now())

  user   User         @relation("CrmUserNoteTarget", fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  author StaffProfile @relation("CrmUserNoteAuthor", fields: [authorId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  // Exactly the keyset the list query walks: (userId) filter, then the
  // (createdAt DESC, id DESC) cursor tuple.
  @@index([userId, createdAt, id])
  @@index([authorId])
}

// CRM learner owner — Owner v1. The single current owner of one learner, stored
// as a mutable singleton keyed by the learner (userId is the primary key, so a
// learner can have at most one owner-state row). Ownership is informational
// only: it grants no authorization and changes no Notes, email, financial or
// learner-visibility rule.
//
// Concurrency and lifecycle are deliberate and MUST NOT be simplified:
//   - NO row            = pristine, never-mutated state → owner null, version 0.
//   - version starts at 1 on the first real assignment (row is created then).
//   - `ownerId` is nullable: a row with ownerId = null and version > 0 is
//     "previously mutated but currently unassigned" — a real, distinct state.
//   - version is monotonic and never resets; unassignment sets ownerId = null
//     and increments version. The row is NEVER deleted by Owner v1.
//
// Both foreign keys are Restrict: deleting a learner that has an owner-state
// row, or a StaffProfile that currently owns a learner, fails loudly rather
// than silently orphaning operational state. The owner FK is nullable so an
// unassigned row keeps no dangling reference. The owner's display name is
// always resolved live through `owner`, never snapshotted.
//
// There is deliberately no history, actorId, assignedBy, reason, comment,
// deletedAt, AuditLog relation, workload or team field: Owner v1 stores current
// state only. Typed assignment history is a deferred future slice.
model CrmUserOwner {
  userId    Int      @id
  ownerId   String?
  version   Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User          @relation("CrmUserOwnerLearner", fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  owner StaffProfile? @relation("CrmUserOwnerStaff", fields: [ownerId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([ownerId])
}

// CRM learner owner HISTORY — Owner History OH-1. One immutable row per real
// owner transition of one learner. It is the dedicated domain record of owner
// change; it is NOT the generic AuditLog and NOT the mock `/audit` workspace.
//
// A row is written inside the SAME transaction as the CrmUserOwner mutation it
// records, so the current owner and its history can never disagree: if the row
// cannot be written the owner change rolls back, and if the owner change fails
// no row is written. Exactly one row is written per successful assign, replace
// or unassign; a no-op or a stale/losing concurrent write produces none.
//
// Transition type is DERIVED, never stored as a string:
//   previousOwnerId NULL, nextOwnerId set   -> assigned   (from unowned)
//   both set, previous <> next              -> reassigned
//   previousOwnerId set, nextOwnerId NULL   -> unassigned
// The DB CHECK constraint (see the migration) rejects null->null and A->A, so
// an invalid transition cannot be stored even if application validation is
// bypassed. `ownerVersion` is the RESULTING current owner version after the
// transition, and (userId, ownerVersion) is unique — a version is claimed by at
// most one history row, which is the concurrency backstop.
//
// All three staff references are Restrict: the actor and the previous/next
// owner cannot be deleted while any history names them, so attribution is never
// silently erased. There is deliberately no updatedAt, deletedAt, reason,
// comment, IP, user-agent or AuditLog relation: history rows are immutable and
// carry only what the CRM read needs. History begins after this migration; no
// backfill is attempted and no synthetic transition is fabricated.
model CrmUserOwnerHistory {
  id              String   @id @default(cuid())
  userId          Int
  actorStaffId    String
  previousOwnerId String?
  nextOwnerId     String?
  ownerVersion    Int
  createdAt       DateTime @default(now())

  user          User          @relation("CrmUserOwnerHistoryLearner", fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  actor         StaffProfile  @relation("CrmUserOwnerHistoryActor", fields: [actorStaffId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  previousOwner StaffProfile? @relation("CrmUserOwnerHistoryPrevious", fields: [previousOwnerId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  nextOwner     StaffProfile? @relation("CrmUserOwnerHistoryNext", fields: [nextOwnerId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  // A resulting version is claimed by at most one history row per learner. This
  // unique index also carries the keyset the list query walks: (userId) filter,
  // then ownerVersion DESC — newest transition first, no tie-breaker needed
  // because ownerVersion is unique and monotonic per learner.
  @@unique([userId, ownerVersion])
  // Support the Restrict deletion lookups ("does any history name this staff?")
  // across all three attribution axes, matching the CrmUserOwner/CrmUserNote
  // convention of indexing each Restrict-referenced staff FK.
  @@index([actorStaffId])
  @@index([previousOwnerId])
  @@index([nextOwnerId])
}

// ===========================================================================
// AGENT-FOUNDATION-1 — the shared Agent Core.
// ===========================================================================
//
// Nine tables recording WHAT AN AGENT DID and WHAT IT POINTED AT. Common
// foundation for curie_atlas, curie_pulse, curie_mentor and curie_sentinel.
//
// THE OWNERSHIP RULE. Authoritative product data stays with its existing owner.
// Nothing below copies an affiliate aggregate, a learner's progression, a
// lesson event, a Pocket event, a deposit, a balance, a report or any personal
// detail. An evidence row carries a typed REFERENCE and a consumer re-reads the
// value from the owner through the owner's own permission gate. That is what
// keeps a stale agent output from becoming a second, divergent source of truth,
// and it is why these tables can be classified as holding no PII at all.
//
// THERE IS NO AgentDefinition MODEL, deliberately. An agent's identity, version
// and capabilities live in src/lib/agents/agent-registry.ts, where they are a
// reviewable artefact. A row would let an operator invent an agent at runtime
// that no review ever saw. AgentRun stores agentCode and agentVersion as
// denormalised strings so a stored run stays interpretable after the registry
// moves on.
//
// APPEND-ORIENTED. Findings, evidence, decisions and terminal executions are
// immutable. The only permitted mutation anywhere below is a status transition
// along an edge declared in src/lib/agents/agent-core-contract.ts, performed as
// a compare-and-swap so that an illegal or concurrent transition fails without
// mutating anything.
//
// NOTHING RUNS. No scheduler, no model provider, no execution provider, no
// network client, no message transport. ModelInvocation and
// AgentActionExecution exist so that enabling them later is a reviewed
// configuration decision rather than a migration under time pressure.

enum AgentExecutionMode {
  deterministic
  model_assisted
  model_only
}

enum AgentTriggerType {
  interactive
  scheduled
  handoff
  system
  test
}

enum AgentRunStatus {
  created
  running
  completed
  failed
  cancelled
}

/// The closed list of things a run can be ABOUT. subjectRef is an INTERNAL
/// OPAQUE REFERENCE — an internal primary key as a string. It is never an
/// email, a phone number, a raw Pocket player id or an external click id.
///
/// `learner` is pseudonymous, NOT anonymous: anyone holding the learner table
/// resolves it to a person in one join. It is classified pseudonymous_subject
/// and staff_restricted, and no public Agent API exposes it.
enum AgentSubjectType {
  learner
  affiliate_partner
  affiliate_campaign
  affiliate_tracking_link
  curriculum_level
}

/// Proposed retention categories. NO PURGE SCHEDULER EXISTS and no row is
/// automatically deleted. No duration is invented anywhere in this schema:
/// purgeAfter is nullable and stays NULL until a policy decides a number.
enum AgentRetentionClass {
  operational_short
  analytical_standard
  decision_record
  execution_record
  evaluation_record
}

enum AgentFindingSeverity {
  info
  warning
  critical
}

enum AgentFindingStatus {
  active
  superseded
  expired
  withdrawn
}

/// How much a finding is entitled to claim. There is no `inferred` and no
/// `predicted` tier, because the Core has no mechanism that could justify one.
enum AgentSupportTier {
  measured
  derived
  insufficient
}

/// Closed evidence domains. Only affiliate_analytics and agent_run have an
/// accepted owner to re-read from today and only those two may be written —
/// enforced in source, not by this enum, which is deliberately wider so the
/// column never has to be altered later.
enum AgentEvidenceDomain {
  affiliate_analytics
  curriculum
  progression
  assessment
  report
  pocket_event
  money_event
  product_event
  communication_event
  agent_run
}

enum AgentHandoffStatus {
  proposed
  accepted
  rejected
  expired
  cancelled
}

enum AgentActionStatus {
  proposed
  awaiting_approval
  approved
  rejected
  expired
  cancelled
  execution_pending
  executed
  execution_failed
}

/// The closed set of actions an agent may ever PROPOSE. Every member is
/// educational or supportive.
///
/// PERMANENTLY ABSENT, because the platform teaches trading rather than selling
/// it: deposit encouragement, trading encouragement, any bid/CPA/payout change,
/// affiliate enablement or disablement, and any financial-pressure messaging.
enum AgentActionClass {
  education_reminder
  continue_learning
  complete_registration
  review_feedback
  support_followup
}

/// Where an action would eventually be delivered. NO PROVIDER IS IMPLEMENTED
/// for any of these and no message can be sent. The `email`, `push` and `sms`
/// members name a TRANSPORT, never a recipient: no column in this schema holds
/// an address, and parametersJson cannot express one.
enum AgentActionChannel {
  in_app
  email
  push
  sms
  human_task
}

enum AgentDecisionType {
  approved
  rejected
  cancelled
}

enum AgentExecutionStatus {
  pending
  running
  succeeded
  failed
  cancelled
}

enum AgentEvaluatorType {
  deterministic
  human
  model
}

enum AgentEvaluationTargetType {
  agent_run
  agent_finding
  agent_action_proposal
}

enum AgentEvaluationResult {
  passed
  failed
  inconclusive
  not_applicable
}

enum ModelInvocationStatus {
  pending
  running
  succeeded
  failed
  cancelled
}

enum ModelValidationStatus {
  not_run
  valid
  invalid_schema
  invalid_policy
  unsupported_claim
}

/// One bounded execution attempt by one agent.
model AgentRun {
  id String @id @default(cuid())

  /// Denormalised registry identity. Stored as strings, not as a foreign key,
  /// so a run stays interpretable after the source registry moves on.
  agentCode    String
  agentVersion String

  /// Only `deterministic` is executable in this phase. The other two members
  /// are schema-ready and refused by runtime policy.
  executionMode AgentExecutionMode
  triggerType   AgentTriggerType
  status        AgentRunStatus     @default(created)

  /// The implementation and catalog that produced the findings, kept separate
  /// from agentVersion: a rule-ordering fix and a new finding code must stay
  /// distinguishable to a consumer deciding whether two runs are comparable.
  engineVersion  String?
  catalogVersion String?

  /// Correlates this run with the HTTP request that caused it. Never a URL and
  /// never a query string.
  requestId String

  /// A stable hash of the RESOLVED question, never the raw request. Two
  /// spellings of one window collide, and the same spelling on two different
  /// days does not.
  inputFingerprint String

  /// Optional for interactive runs, required by the future scheduled, handoff
  /// and action workflows. Unique per agent WHEN PRESENT — SQLite treats NULLs
  /// as distinct, so many keyless runs coexist under one agent.
  idempotencyKey String?

  /// Both absent for a global run, both present for a subject-scoped run. The
  /// pairing is enforced by a CHECK constraint in the migration as well as in
  /// the service, because a half-scoped run is a silently wrong answer.
  subjectType AgentSubjectType?
  subjectRef  String?

  /// Nullable for future system runs. When present it is the canonical CRM
  /// staff identity — this schema does not introduce a second staff model.
  initiatedByStaffId String?

  retentionClass AgentRetentionClass @default(analytical_standard)
  purgeAfter     DateTime?

  startedAt   DateTime?
  completedAt DateTime?
  failedAt    DateTime?
  failureCode String?

  findingCount Int @default(0)
  warningCount Int @default(0)

  createdAt DateTime @default(now())

  initiatedByStaff StaffProfile? @relation("AgentRunInitiator", fields: [initiatedByStaffId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  findings         AgentFinding[]        @relation("AgentFindingRun")
  handoffs         AgentHandoff[]        @relation("AgentHandoffSource")
  acceptedHandoffs AgentHandoff[]        @relation("AgentHandoffAccepted")
  actionProposals  AgentActionProposal[] @relation("AgentActionProposalRun")
  modelInvocations ModelInvocation[]     @relation("ModelInvocationRun")

  /// THE IDEMPOTENCY CONTRACT: the same logical question, asked twice under one
  /// agent, returns the first run instead of doing the work again.
  @@unique([agentCode, idempotencyKey])
  /// "What did this agent do lately" — the run list, per agent, newest first.
  @@index([agentCode, createdAt])
  /// "What is unfinished" — the operational sweep over non-terminal runs.
  @@index([status, createdAt])
  /// "Everything ever run about this subject" — the subject timeline.
  @@index([subjectType, subjectRef, createdAt])
  /// "Has this exact question been asked before" — the pre-run lookup, which
  /// must not scan a growing table.
  @@index([inputFingerprint])
  /// Supports the Restrict deletion lookup on the staff axis, matching the
  /// CrmUserOwner and CrmUserOwnerHistory convention.
  @@index([initiatedByStaffId])
}

/// One structured statement. NOT prose.
///
/// The authoritative representation is code + messageKey + validated operands +
/// evidence. There is deliberately NO rendered-message column: a sentence is
/// produced from the catalog template for the code at read time, so "no invented
/// causes" is a property of a fixed reviewable list rather than of whatever a
/// writer felt like storing.
model AgentFinding {
  id    String @id @default(cuid())
  runId String

  /// Stable within a run, so a consumer can address a finding across re-reads
  /// without depending on row order.
  findingKey String

  /// From the closed catalog in agent-payload-policy.ts. A code may be added,
  /// never repurposed.
  code     String
  category String
  severity AgentFindingSeverity

  /// Names the sentence template. Never the sentence.
  messageKey String

  /// A bounded, flat map of scalars validated against the versioned schema
  /// registered for `code`. Unknown keys, PII-shaped keys, nested values and
  /// oversized payloads are all rejected at write time.
  operandsJson          Json
  operandsSchemaVersion Int  @default(1)

  supportTier AgentSupportTier
  status      AgentFindingStatus @default(active)
  expiresAt   DateTime?
  createdAt   DateTime           @default(now())

  run       AgentRun                 @relation("AgentFindingRun", fields: [runId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  evidence  AgentEvidenceReference[] @relation("AgentEvidenceFinding")
  proposals AgentActionProposal[]    @relation("AgentActionProposalFinding")

  /// A finding key is claimed once per run.
  @@unique([runId, findingKey])
  /// "All findings of this run" — the read that renders a report.
  @@index([runId])
  /// "Every occurrence of this code over time" — the trend read.
  @@index([code, createdAt])
  /// "Everything that needs a look" — the severity sweep.
  @@index([severity, createdAt])
  /// "What is active and expiring" — the future expiry sweep.
  @@index([status, expiresAt])
}

/// What a finding points at, WITHOUT copying it.
///
/// IMMUTABLE AFTER CREATION. There is no updatedAt, no status and no service
/// method that writes to an existing row.
model AgentEvidenceReference {
  id        String @id @default(cuid())
  findingId String

  sourceDomain AgentEvidenceDomain
  /// The kind of thing within the domain — an aggregate name, never a table.
  sourceType   String
  /// An internal opaque reference to the authoritative record.
  sourceRef    String
  /// Which field of it, in the owner's own spelling.
  fieldPath    String

  /// How to tell whether the value has moved since it was observed, without
  /// storing the value's history.
  sourceVersion     String?
  sourceFingerprint String?

  /// OPTIONAL and bounded to metricKey + metricValue + unit: the minimal value
  /// needed to reproduce the finding. Never an entire DTO, an entire API
  /// response, a user profile or a provider payload — none of which is a flat
  /// map with a metricKey, so none of which can be stored here.
  observedValueJson Json?

  createdAt DateTime @default(now())

  finding AgentFinding @relation("AgentEvidenceFinding", fields: [findingId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  /// "The evidence behind this finding" — the only read this table has.
  @@index([findingId])
}

/// A structured request from one agent run to another agent.
///
/// NO CONSUMER AND NO BACKGROUND WORKER EXISTS. Nothing accepts a handoff and
/// no target run is ever created from one in this phase.
model AgentHandoff {
  id          String @id @default(cuid())
  sourceRunId String

  targetAgentCode    String
  /// Null for a reserved target, which has no published version to pin.
  targetAgentVersion String?

  /// A code, not an instruction. payloadJson carries validated operands only:
  /// there is no message, note or instruction key in any handoff schema.
  handoffCode          String
  payloadJson          Json
  payloadSchemaVersion Int    @default(1)

  /// Collapses repeated proposals of the same request. Unique when present.
  deduplicationKey String?

  status    AgentHandoffStatus @default(proposed)
  expiresAt DateTime?

  /// Set only when a future phase actually consumes one. Always NULL here.
  acceptedRunId String?

  createdAt     DateTime  @default(now())
  acceptedAt    DateTime?
  rejectedAt    DateTime?
  rejectionCode String?

  sourceRun   AgentRun  @relation("AgentHandoffSource", fields: [sourceRunId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  acceptedRun AgentRun? @relation("AgentHandoffAccepted", fields: [acceptedRunId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([deduplicationKey])
  /// "What is waiting for this agent" — the future consumer's only query.
  @@index([targetAgentCode, status, createdAt])
  /// "Everything this run asked for" — the source-run read.
  @@index([sourceRunId])
  /// Supports the Restrict deletion lookup on the accepted-run axis.
  @@index([acceptedRunId])
}

/// A PROPOSED action. Inert: it has no effect until a human decides it.
model AgentActionProposal {
  id              String  @id @default(cuid())
  sourceRunId     String
  sourceFindingId String?

  actionClass AgentActionClass

  /// A proposal is always ABOUT something. Unlike a run, there is no global
  /// proposal — an action with no subject has no one it could apply to.
  subjectType AgentSubjectType
  subjectRef  String

  /// Stable codes naming the findings that motivated this, never a rationale
  /// sentence. A flat, bounded, validated map like every other JSON column.
  reasonCodesJson Json

  channel AgentActionChannel

  /// Names a REVIEWED template. The agent never authors the message, chooses
  /// the link or addresses the recipient — parametersJson has no body, text,
  /// url, recipient or destination key in any registered schema.
  templateKey             String
  parametersJson          Json
  parametersSchemaVersion Int    @default(1)

  deduplicationKey String?

  status AgentActionStatus @default(proposed)

  /// ALWAYS TRUE. Enforced by a CHECK constraint in the migration, not merely
  /// by a default: automatic approval and automatic execution are forbidden,
  /// and a column that could be set false would make that a convention.
  requiresHumanApproval Boolean @default(true)

  expiresAt DateTime?
  createdAt DateTime  @default(now())

  sourceRun     AgentRun      @relation("AgentActionProposalRun", fields: [sourceRunId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  sourceFinding AgentFinding? @relation("AgentActionProposalFinding", fields: [sourceFindingId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  decision   AgentActionDecision?   @relation("AgentActionDecisionProposal")
  executions AgentActionExecution[] @relation("AgentActionExecutionProposal")

  @@unique([deduplicationKey])
  /// "What is proposed about this subject" — the review queue, per subject.
  @@index([subjectType, subjectRef, status])
  /// "What is pending and expiring" — the future expiry sweep.
  @@index([status, expiresAt])
  /// "Everything this run proposed" — the source-run read.
  @@index([sourceRunId])
  /// Supports the Restrict deletion lookup on the finding axis.
  @@index([sourceFindingId])
}

/// The HUMAN GATE. One decision per proposal, ever, and it is immutable.
///
/// decidedByStaffId is NOT NULL: there is no system approval and no anonymous
/// approval. An agent never holds more authority than the human who decided.
model AgentActionDecision {
  id         String @id @default(cuid())
  proposalId String @unique

  decision     AgentDecisionType
  decisionCode String

  decidedByStaffId String

  /// Which policy version authorised this, so a decision stays interpretable
  /// after the policy moves.
  policyVersion String

  createdAt DateTime @default(now())

  proposal       AgentActionProposal @relation("AgentActionDecisionProposal", fields: [proposalId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  decidedByStaff StaffProfile        @relation("AgentActionDecisionStaff", fields: [decidedByStaffId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  /// Supports the Restrict deletion lookup on the staff axis.
  @@index([decidedByStaffId])
}

/// A future execution attempt.
///
/// NO EXECUTION PROVIDER IS REGISTERED and no execution service is enabled.
/// The provider registry is an empty array in source, so no row here can be
/// created by any code path in this phase.
model AgentActionExecution {
  id            String @id @default(cuid())
  proposalId    String
  attemptNumber Int

  executionProvider String
  status            AgentExecutionStatus @default(pending)

  /// The effect-level idempotency key. This is the second of the two levels —
  /// AgentRun(agentCode, idempotencyKey) prevents duplicate WORK, this prevents
  /// duplicate EFFECT.
  idempotencyKey String @unique

  /// OPAQUE ONLY. Never a recipient address, an email, a phone number or a raw
  /// provider payload.
  externalReceiptRef String?

  /// The single audit surface stays AuditLog. Agent Core owns its own
  /// structured history, and anything that CHANGES THE PRODUCT is recorded
  /// there through this reference rather than in a private audit trail.
  auditLogId Int?

  startedAt   DateTime?
  completedAt DateTime?
  failedAt    DateTime?
  failureCode String?
  createdAt   DateTime  @default(now())

  proposal AgentActionProposal @relation("AgentActionExecutionProposal", fields: [proposalId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  auditLog AuditLog?           @relation("AgentActionExecutionAudit", fields: [auditLogId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  /// One row per attempt, so a retry can never overwrite the record of the
  /// attempt it is retrying.
  @@unique([proposalId, attemptNumber])
  /// "What is executing or recently failed" — the operational sweep.
  @@index([status, createdAt])
  /// Supports the Restrict deletion lookup on the audit axis.
  @@index([auditLogId])
}

/// An assessment of a run, a finding or a proposal.
///
/// Kept separate from its target so that re-evaluating a historical run never
/// mutates it. Only deterministic evaluators are enabled: there is no Curie
/// Sentinel runtime and no model grader.
model AgentEvaluation {
  id String @id @default(cuid())

  evaluatorType AgentEvaluatorType
  evaluatorCode String

  targetType AgentEvaluationTargetType
  targetRef  String

  evaluationCode String

  /// An exact decimal string, never a float. A score somebody compares across
  /// runs must not depend on binary rounding.
  scoreValue String?

  result AgentEvaluationResult

  /// A code, a count and a bound. Never a free-form evaluation report: a
  /// sentence stored here would become authoritative evidence nobody reviewed.
  evidenceJson          Json?
  evidenceSchemaVersion Int   @default(1)

  createdAt DateTime @default(now())

  /// "How has this target been evaluated" — the only read this table has.
  @@index([targetType, targetRef, createdAt])
  /// "Every result of this check over time" — the quality trend read.
  @@index([evaluationCode, createdAt])
}

/// SCHEMA-ONLY infrastructure for a model provider that does not exist.
///
/// NO PROVIDER IS SELECTED, no API key is read, no network client exists and
/// every invocation attempt fails closed with MODEL_PROVIDER_DISABLED.
///
/// DELIBERATELY ABSENT, and a regression asserts each by name: any prompt, any
/// system prompt, any raw response, any completion, any feature packet, any
/// credential. This table records THAT a call happened and what it cost — never
/// what was said.
model ModelInvocation {
  id    String  @id @default(cuid())
  runId String?

  providerCode String
  modelCode    String
  modelVersion String?

  /// Versions of the reviewed prompt and the expected output schema. These name
  /// artefacts held in source — they are not the artefacts themselves.
  promptVersion       String?
  outputSchemaVersion String?

  attemptNumber Int @default(1)

  status           ModelInvocationStatus @default(pending)
  validationStatus ModelValidationStatus @default(not_run)

  inputTokenCount  Int?
  outputTokenCount Int?
  cachedTokenCount Int?
  latencyMs        Int?

  /// Minor units of an explicit currency. Never a float, for the same reason
  /// money is never a float anywhere else in this schema.
  costMinorUnits Int?
  costCurrency   String?

  /// The provider's own opaque request id. Never a URL, a payload or a key.
  externalRequestRef String?

  startedAt   DateTime?
  completedAt DateTime?
  failedAt    DateTime?
  failureCode String?
  createdAt   DateTime  @default(now())

  run AgentRun? @relation("ModelInvocationRun", fields: [runId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  /// One row per attempt of a run.
  @@unique([runId, attemptNumber])
  /// "Every model call this run made" — the run drill-down.
  @@index([runId])
  /// "Usage and cost by provider and model over time" — the billing read.
  @@index([providerCode, modelCode, createdAt])
  /// "What is in flight or recently failed" — the operational sweep.
  @@index([status, createdAt])
}

/// G4-GROWTH — the canonical growth event taxonomy.
///
/// ONE VOCABULARY, NOT FOUR. Before this phase ATA had an affiliate conversion
/// ledger, a Pocket provider-event table and a curriculum progression model that
/// each described part of a learner's journey in its own words. Analytics that
/// wanted the whole funnel had to join three shapes and invent the connective
/// tissue. These members are that connective tissue, named once.
///
/// THE FOUR MONEY-ADJACENT NAMES ARE KEPT APART DELIBERATELY. `ata_reg` is a
/// registration in ATA. `pocket_reg` is a trusted provider confirmation that the
/// learner also registered with Pocket. `dep` is the FIRST Pocket deposit for a
/// player. `rdep` is any later one. Collapsing any pair of these would make a
/// future CPA calculation wrong in a way no downstream reader could detect.
enum GrowthEventType {
  traffic_click
  ata_reg
  curriculum_enrollment
  academy_activation
  level_started
  level_completed
  assessment_completed
  report_submitted
  report_approved
  mentor_review_submitted
  mentor_review_approved
  pocket_reg
  dep
  rdep
}

/// G4-GROWTH — which module produced an event, and therefore the namespace its
/// `sourceEventId` is unique within.
///
/// A GrowthEvent is DERIVED from a row that already exists in an owner table.
/// This enum names that owner. It is what makes the ledger a projection with a
/// provable origin rather than a second, independently writable truth.
enum GrowthEventSourceOwner {
  acquisition_click
  auth_register
  curriculum_enrollment
  curriculum_level_progress
  curriculum_assessment_attempt
  curriculum_report_submission
  curriculum_report_review
  curriculum_mentor_review
  pocket_identity_binding
  pocket_first_deposit
  pocket_redeposit
}

/// G4-GROWTH — whether a row was written by a live emitter or by the migration
/// that backfilled history from the owner tables.
///
/// Recorded because "the ledger has no registrations before 13 August" and "no
/// registrations happened before 13 August" are different statements, and a
/// reader must be able to tell which one a sparse period means.
enum GrowthEventOrigin {
  runtime
  backfill
}

/// G4-GROWTH — whether a money-bearing growth event knows its unit. Mirrors the
/// AFD-4 vocabulary rather than inventing a second spelling of the same idea.
enum GrowthEventCurrencyStatus {
  unspecified
  configured
}

/// G4-GROWTH — the canonical append-only growth event ledger.
///
/// WHAT THIS TABLE IS. One row per business-significant fact in the acquisition
/// and progression journey, in one vocabulary, with one time basis, addressable
/// by one key. Future affiliate postbacks, CPA qualification, Atlas adapters and
/// the CRO/CMO dashboards are all consumers of THIS, so that adding a consumer
/// never means adding a second definition of "a registration".
///
/// WHAT THIS TABLE IS NOT. It is not where money invariants live. The rule that
/// one Pocket player has at most one first deposit is enforced by
/// `PocketProviderEvent.UNIQUE(provider, eventType, pocketPlayerId)` and stays
/// there. A `dep` GrowthEvent is a projection OF that row, carrying its already
/// canonical amount for reporting. No emitter may write a GrowthEvent carrying a
/// fact that is not already true in the owner row it names.
///
/// THE IDEMPOTENCY KEY IS `(eventType, sourceOwner, sourceEventId)`. Each family
/// declares its own authority: `ata_reg` keys on the user id, `pocket_reg` on
/// the trader identity row, `dep` on the provider event row, a level completion
/// on the progress row. A replayed emitter collides with the index instead of
/// producing a second event, and the migration backfill uses exactly the same
/// keys so a backfilled row and a runtime row can never both exist.
///
/// IMMUTABLE AFTER INSERT. There is no update path in the application. The only
/// nullable field a later phase may legitimately fill is
/// `providerIngressEventId` on rows whose evidence arrives late, and even that
/// is written by the ingress owner inside the same transaction as the insert.
model GrowthEvent {
  id            Int               @id @default(autoincrement())
  /// Opaque, server-generated, 160-bit base32. The identifier a future outbound
  /// postback quotes, so it can never be a database id.
  eventId       String            @unique
  eventType     GrowthEventType
  /// When the fact HAPPENED, copied from the owner row's own occurrence column.
  /// Never `now()`, never `updatedAt`, never a neighbouring event's time.
  occurredAt    DateTime
  /// When ATA wrote it down. Separate from `occurredAt` on purpose.
  recordedAt    DateTime          @default(now())
  origin        GrowthEventOrigin @default(runtime)
  schemaVersion Int               @default(1)

  /// Null for `traffic_click`, which happens before anyone is a user.
  userId                 Int?
  enrollmentId           Int?
  /// `AffiliateClick.id` — the ACQUISITION click. Never the Pocket referral
  /// click, which is `ExchangeAccount.clickId` and a different identity.
  acquisitionClickId     Int?
  attributionId          Int?
  pocketTraderIdentityId Int?
  providerIngressEventId Int?
  /// `pocket` on provider-sourced rows, null on first-party ones.
  provider               String?

  /// The level a progression event belongs to. TYPED COLUMNS, NOT METADATA JSON,
  /// because "L1 completion rate by campaign" is the single most-run CRO query
  /// and `json_extract` cannot use an index. `levelNumber` is denormalised from
  /// `LevelDefinition` so a funnel can be built without joining the curriculum
  /// on every read, and it is the level's ordinal AT THE TIME OF THE EVENT.
  levelDefinitionId Int?
  levelNumber       Int?

  /// Canonical decimal TEXT with exactly two fractional digits, copied from the
  /// owner row. Never a float, never a balance, never a running total, and never
  /// a commission — a future CPA amount is a different field on a different table.
  amount         String?
  currencyCode   String?
  currencyStatus GrowthEventCurrencyStatus?

  sourceOwner      GrowthEventSourceOwner
  /// The owner TABLE this row was derived from, spelled out so a reader can find
  /// the origin without consulting a mapping held somewhere else.
  sourceEntityType String
  /// The owner ROW id, as text.
  sourceEntityId   String
  /// The owner's idempotency key within its namespace.
  sourceEventId    String

  /// Bounded, validated, allowlisted keys only. Never a raw payload, never a
  /// query string, never PII, never authentication material.
  metadata Json?

  user             User?                     @relation("GrowthEventLearner", fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  enrollment       UserCurriculumEnrollment? @relation("GrowthEventEnrollment", fields: [enrollmentId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  acquisitionClick AffiliateClick?           @relation("GrowthEventAcquisitionClick", fields: [acquisitionClickId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  attribution      AffiliateAttribution?     @relation("GrowthEventAttribution", fields: [attributionId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  pocketIdentity   PocketTraderIdentity?     @relation("GrowthEventPocketIdentity", fields: [pocketTraderIdentityId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  ingressEvent     ProviderIngressEvent?     @relation("GrowthEventIngress", fields: [providerIngressEventId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  levelDefinition  LevelDefinition?          @relation("GrowthEventLevel", fields: [levelDefinitionId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  outboxItem       GrowthEventOutbox?

  @@unique([eventType, sourceOwner, sourceEventId])
  /// "Every DEP in August" — the primary analytics read.
  @@index([eventType, occurredAt])
  /// "How many enrollments reached L3" — the level funnel read.
  @@index([eventType, levelNumber, occurredAt])
  /// "This learner's journey in order" — the funnel and the drilldown.
  @@index([userId, occurredAt])
  /// "Which events did this campaign's traffic produce" — the CMO join.
  @@index([acquisitionClickId, eventType])
  @@index([attributionId, eventType])
  @@index([enrollmentId, eventType])
  @@index([occurredAt])
  @@index([providerIngressEventId])
}

/// G4-GROWTH — the durable hand-off point between a committed growth event and
/// anything that wants to act on it.
///
/// WHY IT EXISTS BEFORE ANY CONSUMER DOES. The failure this prevents is an
/// outbound affiliate postback issued from inside the transaction that records a
/// deposit: a slow or failing partner endpoint would then be able to roll back a
/// real conversion, and a retry would either double-send or lose the event.
/// Writing the intent to a table in the same transaction, and delivering from it
/// afterwards, is what makes "the event happened" and "the event was announced"
/// two separately recoverable facts.
///
/// NO DESTINATION COLUMN IN THIS PHASE. There is no partner endpoint, no URL and
/// no delivery engine yet. One item per event, one time — fan-out to several
/// consumers is a later phase's problem and will add a consumer table beside
/// this, never a second copy of the semantic event.
enum GrowthEventOutboxStatus {
  pending
  /// Claimed by a worker. Present so a future dispatcher has a state to take.
  in_flight
  delivered
  /// Exhausted its attempts. Never deleted, so an operator can see it.
  failed
}

model GrowthEventOutbox {
  id            Int                     @id @default(autoincrement())
  growthEventId Int                     @unique
  /// Denormalised so a dispatcher can filter without joining the ledger.
  eventType     GrowthEventType
  status        GrowthEventOutboxStatus @default(pending)
  createdAt     DateTime                @default(now())
  /// Not before this instant. The backoff mechanism, and it is a column rather
  /// than a sleep so a restart does not lose the schedule.
  availableAt   DateTime
  attemptCount  Int                     @default(0)
  lastAttemptAt DateTime?
  /// A bounded code only. Never a provider response body and never a stack.
  lastErrorCode String?

  growthEvent GrowthEvent @relation(fields: [growthEventId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  /// "What is due right now" — the dispatcher's only hot query.
  @@index([status, availableAt])
  @@index([eventType, status])
}

/// G4-GROWTH — which provider goal a delivery claimed to be.
///
/// EXACTLY THREE MEMBERS. `withdraw`, `commission`, `email` and the other nine
/// aliases the legacy route accepted are absent by design: a caller-supplied
/// string must not be able to select a financial mutation, and this enum is the
/// database saying so as well as the application.
enum ProviderIngressGoal {
  reg
  dep
  redep
}

/// G4-GROWTH — how far a delivery got, and why it stopped.
///
/// `identity_unresolved` is the honest terminal state for a redeposit: the
/// evidence is durable and complete, and ATA still cannot say whether it is a
/// retry of a delivery it already has or a genuinely new deposit, because Pocket
/// supplies no event identifier. It is NOT an error and NOT a rejection.
enum ProviderIngressStatus {
  accepted_processed
  accepted_duplicate
  accepted_pending_linkage
  identity_unresolved
  rejected
  quarantined
}

/// G4-GROWTH — the bounded reasons a delivery was refused or quarantined.
enum ProviderIngressRejectionCode {
  auth_failed
  goal_unknown
  goal_disabled
  schema_invalid
  amount_invalid
  click_unknown
  player_conflict
  identity_owner_mismatch
  provider_event_identity_missing
  ordering_unresolved
}

/// G4-GROWTH — whether the provider's own event time could be trusted.
///
/// `unparseable` keeps the raw string beside the failure instead of guessing a
/// timezone, which is the one thing a money timestamp must never be.
enum ProviderIngressTimeStatus {
  absent
  parsed
  unparseable
}

/// G4-GROWTH — durable, sanitized evidence of every provider delivery.
///
/// SEPARATE FROM THE CANONICAL EVENT ON PURPOSE. A GrowthEvent says a business
/// fact is true. A row here says a request arrived and what it contained. The
/// overwhelming majority of operational questions — "did Pocket ever send this",
/// "why was it refused", "is the integration healthy" — are questions about
/// deliveries, not about facts, and answering them from the canonical ledger
/// would mean polluting it with rows that are not facts.
///
/// NO SECRET REACHES THIS TABLE. `sanitizedPayload` is built by the route's
/// existing redactor, which replaces `ow`, `secret` and `token` with a marker
/// before anything is persisted. `rawPayloadHash` is computed over the SAME
/// sanitized structure, so the hash cannot be used as an offline oracle for the
/// secret either.
///
/// `rawPayloadHash` IS NOT AN EVENT IDENTITY. Two legitimate redeposits with the
/// same player, amount and second produce byte-identical payloads and therefore
/// the same hash. It identifies a repeated DELIVERY, never a repeated DEPOSIT,
/// and nothing in this schema treats it as the latter.
model ProviderIngressEvent {
  id       Int                 @id @default(autoincrement())
  provider String              @default("pocket")
  goal     ProviderIngressGoal

  receivedAt            DateTime
  /// The provider's own event time, parsed. Null unless `providerEventAtStatus`
  /// is `parsed`.
  providerEventAt       DateTime?
  /// The raw provider string, kept when it could not be parsed rather than
  /// discarded or guessed at.
  providerEventAtRaw    String?
  providerEventAtStatus ProviderIngressTimeStatus @default(absent)

  /// The Pocket player id, digits only, as delivered.
  playerIdNormalized String?
  /// The POCKET REFERRAL click (`tq-<uuid>`), not the acquisition click id.
  clickId            String?

  /// Canonical decimal TEXT. Null on a registration, which carries no money.
  amount String?

  campaignId   String?
  campaignName String?
  sub1         String?
  sub2         String?
  sub3         String?
  sub4         String?
  sub5         String?
  /// Provider- or network-asserted, never a user identity claim. See COUNTRY_IP
  /// in the contract document.
  country      String?
  deviceType   String?

  /// Redacted structured payload. Bounded keys, bounded lengths.
  sanitizedPayload Json
  /// SHA-256 over the sanitized payload. Delivery identity, never event identity.
  rawPayloadHash   String

  /// The provider's own unique event id, when a contract proves one exists.
  /// Null for every Pocket delivery today: Pocket issues none.
  ///
  /// POCKET-DEP-RDEP-1 — this is NOT where ATA's derived redeposit key goes, and
  /// the distinction is load-bearing. A provider-issued id identifies ONE
  /// DELIVERY, which is why the unique index below is correct for it. ATA's
  /// derived key identifies one DEPOSIT and is deliberately stable across
  /// retries, so it would collide here on exactly the redeliveries the design
  /// depends on. It lives on `PocketProviderEvent.providerEventKey` instead.
  providerEventIdentity String?

  processingStatus ProviderIngressStatus
  rejectionCode    ProviderIngressRejectionCode?
  /// The canonical event this delivery produced, when it produced one.
  canonicalEventId Int?

  schemaVersion Int      @default(1)
  createdAt     DateTime @default(now())

  growthEvents GrowthEvent[] @relation("GrowthEventIngress")

  /// Two deliveries may not claim the same provider event identity. Enforced
  /// only where the identity EXISTS, which on SQLite a partial index gives us
  /// for free by leaving nulls out of the uniqueness domain.
  @@unique([provider, goal, providerEventIdentity])
  /// "Ingress health for Pocket redeposits this week" — the operator sweep.
  @@index([provider, goal, receivedAt])
  @@index([processingStatus, receivedAt])
  @@index([rejectionCode, receivedAt])
  @@index([playerIdNormalized])
  @@index([clickId])
  @@index([rawPayloadHash])
}

// ===========================================================================
// LEARNER-OPERATIONS-V1 — the operational department.
// ===========================================================================
//
// Learner Operations runs the DAILY EXECUTION of learner support and mentor /
// review operations. It is not an educational authority and the schema is
// arranged so that it cannot become one.
//
// THE AUTHORITY RULE, STATED AS A SCHEMA PROPERTY. Nothing below has a write
// path to UserLevelProgress, UserCurriculumEnrollment, XPTransaction,
// ReportSubmission, ReportReview, PocketProviderEvent, ProviderIngressEvent,
// GrowthEvent or CheckpointVerificationAttempt. Where a work item concerns one
// of those objects it holds a NULLABLE REFERENCE to it and nothing more: the
// canonical owner still decides what the object's state is, and a consumer
// re-reads the value from that owner. `LearnerOpsCase.status = resolved`
// therefore cannot complete a level, because resolving a case writes to exactly
// one table and that table is this one.
//
// NO SHADOW TRUTH. There is deliberately no learnerName, learnerLevel,
// currentStep, reportStatus, progressStatus, depositState or balance column
// anywhere below. The superseded SupportDialog carries three such snapshots and
// they are precisely why it is superseded: a denormalised copy of a canonical
// fact is a second answer to a question that already had one.
//
// INTERNAL AND LEARNER-VISIBLE COMMUNICATION ARE TWO TABLES, NOT ONE COLUMN.
// LearnerOpsMessage is always learner-visible. LearnerOpsNote is never. There
// is no `internalNote` boolean anywhere in this domain, because a boolean is
// one mistaken predicate away from disclosure and the learner-facing read path
// must not even NAME the internal table. That is the structural difficulty the
// product contract asks for.

/// The seven kinds of work Learner Operations owns. A case's type fixes which
/// canonical anchor it may carry, enforced by a CHECK constraint in the
/// migration rather than by application convention alone.
enum LearnerOpsCaseType {
  support_request
  report_review
  mentor_review
  educational_escalation
  complaint
  service_recovery
  operational_followup
}

/// The operational lifecycle. Note what is NOT here.
///
/// `assigned` is not a status: assignment is its own axis
/// (`assignedStaffId`), so "assigned" is derivable, cannot disagree with the
/// owner column, and does not have to be re-established after every unrelated
/// transition.
///
/// `reopened` is not a status either: it is `reopenCount > 0`, which SURVIVES
/// the next transition. As a status it would be erased the moment an operator
/// picked the case back up, which is exactly when the fact matters most.
enum LearnerOpsCaseStatus {
  new
  open
  in_progress
  waiting_learner
  waiting_internal
  waiting_external
  escalated
  resolved
  closed
}

enum LearnerOpsPriority {
  urgent
  high
  normal
  low
}

/// Every distinct thing that can happen to a case, recorded immutably. There is
/// no `updated` catch-all: an event whose meaning has to be reconstructed from
/// its metadata is not an audit record.
enum LearnerOpsCaseEventType {
  created
  status_changed
  assigned
  reassigned
  unassigned
  priority_changed
  reason_code_changed
  message_sent
  note_added
  escalated
  escalation_resolved
  first_response_recorded
  resolved
  closed
  reopened
  qa_reviewed
  canonical_decision_mirrored
}

/// Who wrote a learner-visible message. A message has exactly one author and
/// the two axes are mutually exclusive, enforced by CHECK in the migration.
enum LearnerOpsMessageAuthorKind {
  staff
  learner
}

enum LearnerOpsEscalationClass {
  educational_methodology
  technical_product
  external_provider
  security_abuse
  operational_lead
}

enum LearnerOpsQaResult {
  meets
  needs_improvement
  does_not_meet
}

enum LearnerOpsKnowledgeStatus {
  draft
  published
  archived
}

enum LearnerOpsVocStatus {
  open
  under_review
  accepted
  rejected
  resolved
}

enum LearnerOpsVocSeverity {
  critical
  high
  medium
  low
}

/// Where an SLA policy's numbers CAME FROM. The product owner has supplied no
/// business SLA durations, so every row this phase seeds is stamped
/// `preprod_acceptance_fixture` and the CRM renders that provenance next to the
/// number. A fixture presented as policy would be an invented business rule.
enum LearnerOpsSlaOrigin {
  preprod_acceptance_fixture
  product_owner_supplied
}

/// A team-level work container. Queues are configuration, not code: adding one
/// is a row, and the CRM resolves names through this table so a renamed queue
/// renames everywhere at once.
model LearnerOpsQueue {
  id          String   @id @default(cuid())
  key         String   @unique
  name        String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  cases             LearnerOpsCase[]       @relation("LearnerOpsCaseQueue")
  escalationTargets LearnerOpsEscalation[] @relation("LearnerOpsEscalationTargetQueue")

  @@index([isActive, key])
}

/// SLA policy. Targets are MINUTES and nullable where the product genuinely has
/// no target, rather than defaulted to a number nobody chose.
///
/// The three pause flags are separate because the three waits mean different
/// things. Waiting on a LEARNER is not our delay. Waiting on an INTERNAL
/// decision is. Waiting on an EXTERNAL provider is neither, and the product
/// owner may want it counted either way — so it is configuration, not a
/// hardcoded belief.
///
/// Breach is NEVER stored. It is derived at read time from openedAt, pausedMs
/// and the live clock, because a stored boolean is wrong from the moment the
/// deadline passes until something happens to rewrite it.
model LearnerOpsSlaPolicy {
  id                         String              @id @default(cuid())
  key                        String              @unique
  name                       String
  priority                   LearnerOpsPriority
  firstResponseTargetMinutes Int?
  resolutionTargetMinutes    Int?
  pausesOnWaitingLearner     Boolean             @default(true)
  pausesOnWaitingInternal    Boolean             @default(false)
  pausesOnWaitingExternal    Boolean             @default(true)
  origin                     LearnerOpsSlaOrigin
  isActive                   Boolean             @default(true)
  createdAt                  DateTime            @default(now())
  updatedAt                  DateTime            @updatedAt

  cases LearnerOpsCase[] @relation("LearnerOpsCaseSlaPolicy")

  @@unique([priority, isActive, key])
  @@index([isActive])
}

/// Structured classification. Deliberately small — a seeded V1 vocabulary with
/// clear config ownership, not an exhaustive taxonomy invented up front. Free
/// text is preserved ALONGSIDE this on the case, never replaced by it.
model LearnerOpsReasonCode {
  id        String   @id @default(cuid())
  code      String   @unique
  category  String
  label     String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cases LearnerOpsCase[] @relation("LearnerOpsCaseReasonCode")

  @@index([category, isActive])
}

/// THE WORK ITEM. One row answers every question the operating model asks:
/// what needs attention, who owns it, why it exists, which learner, which
/// product object, what priority, when the clock started, what we are waiting
/// for, when it resolved and whether it came back.
///
/// TWO INDEPENDENT VERSION COUNTERS, AND THEY ARE NOT INTERCHANGEABLE.
///   `version`           guards STATE transitions
///   `assignmentVersion` guards OWNERSHIP transitions
/// Two operators may legitimately do different things at once — one replying
/// while another reassigns — and a single counter would make the second one
/// fail for no reason. Both are monotonic and never reset, following the
/// CrmUserOwner precedent.
///
/// THE THREE CANONICAL ANCHORS ARE REFERENCES, NEVER COPIES. A case about a
/// report names the ReportSubmission and reads its state from the report owner.
/// It does not store the report's status, and it cannot change it. The CHECK
/// constraint in the migration ties each anchor to the types permitted to hold
/// it, so a support case cannot acquire a mentor-review anchor.
model LearnerOpsCase {
  id        String @id @default(cuid())
  reference String @unique

  userId Int
  type   LearnerOpsCaseType
  status LearnerOpsCaseStatus @default(new)

  priority LearnerOpsPriority @default(normal)

  queueId         String
  assignedStaffId String?

  /// Monotonic CAS counters. See the note above: state and ownership are
  /// deliberately guarded separately.
  version           Int @default(1)
  assignmentVersion Int @default(0)

  reasonCodeId String?

  /// Structured classification does not replace context. Both are kept.
  subject String
  details String

  /// The canonical anchors. Nullable, mutually constrained by type, and never
  /// a copy of anything the anchored object owns.
  supportDialogId     Int?
  /// Unique where present (migration 52) — one operational mirror per report.
  reportSubmissionId  Int? @unique
  /// Unique where present (migration 52) — one operational mirror per progress row.
  userLevelProgressId Int? @unique

  slaPolicyId        String?
  firstResponseDueAt DateTime?
  resolutionDueAt    DateTime?
  firstRespondedAt   DateTime?

  /// Pause accounting. `pausedMs` accumulates on EXIT from a pausing state, so
  /// elapsed time is always derivable and never needs a background job.
  clockPausedAt DateTime?
  pausedMs      Int       @default(0)

  openedAt       DateTime  @default(now())
  lastActivityAt DateTime  @default(now())
  resolvedAt     DateTime?
  closedAt       DateTime?

  /// Reopen is durable and countable, not a status that the next transition
  /// would erase.
  reopenCount Int       @default(0)
  reopenedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Restrict throughout: a learner with operational history, or a staff member
  /// named as an owner, cannot be deleted out from under that history.
  user          User                  @relation("LearnerOpsCaseLearner", fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  queue         LearnerOpsQueue       @relation("LearnerOpsCaseQueue", fields: [queueId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  assignedStaff StaffProfile?         @relation("LearnerOpsCaseAssignee", fields: [assignedStaffId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  reasonCode    LearnerOpsReasonCode? @relation("LearnerOpsCaseReasonCode", fields: [reasonCodeId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  slaPolicy     LearnerOpsSlaPolicy?  @relation("LearnerOpsCaseSlaPolicy", fields: [slaPolicyId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  /// SetNull, not Restrict, on the canonical anchors: Learner Operations must
  /// never be the reason a canonical educational object cannot be removed by
  /// its own owner. Losing the anchor degrades the case to "no longer linked",
  /// which is honest, rather than blocking the owner.
  supportDialog     SupportDialog?     @relation("LearnerOpsCaseSupportDialog", fields: [supportDialogId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  reportSubmission  ReportSubmission?  @relation("LearnerOpsCaseReportSubmission", fields: [reportSubmissionId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  userLevelProgress UserLevelProgress? @relation("LearnerOpsCaseLevelProgress", fields: [userLevelProgressId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  events      LearnerOpsCaseEvent[]     @relation("LearnerOpsCaseEvents")
  messages    LearnerOpsMessage[]       @relation("LearnerOpsCaseMessages")
  notes       LearnerOpsNote[]          @relation("LearnerOpsCaseNotes")
  escalations LearnerOpsEscalation[]    @relation("LearnerOpsEscalationCase")
  qaReviews   LearnerOpsQaReview[]      @relation("LearnerOpsQaReviewCase")
  vocLinks    LearnerOpsVocSignalCase[] @relation("LearnerOpsVocSignalCaseCase")

  /// The queue read: open work in one queue, newest activity first.
  @@index([queueId, status, priority, lastActivityAt])
  /// The "my work" read.
  @@index([assignedStaffId, status, lastActivityAt])
  /// The unassigned-backlog read, which is a different question from "my work".
  @@index([status, assignedStaffId, openedAt])
  /// Learner 360 — every case for one learner.
  @@index([userId, openedAt])
  /// Type-sliced queues (report review, mentor review) and analytics by type.
  @@index([type, status, openedAt])
  /// SLA sweeps.
  @@index([status, firstResponseDueAt])
  @@index([status, resolutionDueAt])
  /// The canonical anchors, UNIQUE as of migration 52.
  ///
  /// The original comment here said "NOT unique: a report can legitimately
  /// acquire a second case after the first is closed". That was written before
  /// the integration existed and it is wrong about the product: one canonical
  /// report is one piece of operational work for its whole life, including
  /// across revision requests and resubmissions — a second case would split its
  /// history and its SLA in half. LO-REVIEW-WORKITEM-UNREACHABLE-1 settles it:
  /// exactly one work item per canonical review object, enforced by a partial
  /// unique index in the database and not merely by the ensure helper.
  @@index([reportSubmissionId])
  @@index([userLevelProgressId])
  @@index([supportDialogId])
  @@index([reasonCodeId])
  @@index([slaPolicyId])
}

/// Immutable case history. Written in the SAME TRANSACTION as the mutation it
/// records, so a case and its history can never disagree: if the event cannot
/// be written the mutation rolls back.
///
/// `(caseId, caseVersion)` is UNIQUE and is the concurrency backstop — a
/// version is claimed by at most one event, so two racing writers cannot both
/// believe they performed the transition even if application validation is
/// bypassed.
model LearnerOpsCaseEvent {
  id          String                  @id @default(cuid())
  caseId      String
  caseVersion Int
  eventType   LearnerOpsCaseEventType

  /// Null actor means the system did it (an SLA target being set, a canonical
  /// decision being mirrored). It never means "we do not know who".
  actorStaffId String?

  previousStatus LearnerOpsCaseStatus?
  nextStatus     LearnerOpsCaseStatus?

  previousAssignedStaffId String?
  nextAssignedStaffId     String?

  previousPriority LearnerOpsPriority?
  nextPriority     LearnerOpsPriority?

  /// Free-form provenance. Never contains a secret, a password or a full
  /// learner identity — see the audit rules in the phase contract.
  reason   String?
  metadata Json?

  createdAt DateTime @default(now())

  case                  LearnerOpsCase @relation("LearnerOpsCaseEvents", fields: [caseId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  actorStaff            StaffProfile?  @relation("LearnerOpsCaseEventActor", fields: [actorStaffId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  previousAssignedStaff StaffProfile?  @relation("LearnerOpsCaseEventPreviousAssignee", fields: [previousAssignedStaffId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  nextAssignedStaff     StaffProfile?  @relation("LearnerOpsCaseEventNextAssignee", fields: [nextAssignedStaffId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([caseId, caseVersion])
  @@index([caseId, createdAt])
  @@index([actorStaffId])
  @@index([previousAssignedStaffId])
  @@index([nextAssignedStaffId])
  @@index([eventType, createdAt])
}

/// LEARNER-VISIBLE COMMUNICATION. Every row in this table is visible to the
/// learner the case belongs to. There is no visibility column and no way to
/// mark a row private — a private thought belongs in LearnerOpsNote, which is a
/// different table with a different name that the learner-facing read path does
/// not import.
model LearnerOpsMessage {
  id         String                      @id @default(cuid())
  caseId     String
  authorKind LearnerOpsMessageAuthorKind

  /// Exactly one of these is set, enforced by CHECK in the migration.
  authorStaffId String?
  authorUserId  Int?

  body String

  /// Delivery facts the platform actually knows. `readByLearnerAt` is set by
  /// the learner's own read, never inferred.
  readByLearnerAt DateTime?

  createdAt DateTime @default(now())

  case        LearnerOpsCase @relation("LearnerOpsCaseMessages", fields: [caseId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  authorStaff StaffProfile?  @relation("LearnerOpsMessageStaffAuthor", fields: [authorStaffId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  authorUser  User?          @relation("LearnerOpsMessageLearnerAuthor", fields: [authorUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([caseId, createdAt])
  @@index([authorStaffId])
  @@index([authorUserId])
}

/// INTERNAL OPERATIONAL NOTE. Never learner-visible, under any circumstance.
///
/// This is a SEPARATE TABLE from LearnerOpsMessage on purpose. The learner-
/// facing API selects from LearnerOpsMessage and never joins this table, so
/// disclosure would require adding a table to a query rather than getting one
/// boolean predicate wrong. Append-only: no updatedAt, no deletedAt, no
/// visibility column — following the CrmUserNote precedent exactly.
model LearnerOpsNote {
  id            String   @id @default(cuid())
  caseId        String
  authorStaffId String
  body          String
  createdAt     DateTime @default(now())

  case        LearnerOpsCase @relation("LearnerOpsCaseNotes", fields: [caseId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  authorStaff StaffProfile   @relation("LearnerOpsNoteAuthor", fields: [authorStaffId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([caseId, createdAt])
  @@index([authorStaffId])
}

/// An escalation does not move the case. The case keeps its owner, its queue
/// and its timeline; this row records that a second party was pulled in, why,
/// and what came back. `returnedToOwnerAt` is what closes the loop.
model LearnerOpsEscalation {
  id     String                    @id @default(cuid())
  caseId String
  class  LearnerOpsEscalationClass

  raisedByStaffId String
  targetQueueId   String?
  targetStaffId   String?

  reason String

  raisedAt          DateTime  @default(now())
  resolvedAt        DateTime?
  resolution        String?
  resolvedByStaffId String?
  returnedToOwnerAt DateTime?

  case            LearnerOpsCase   @relation("LearnerOpsEscalationCase", fields: [caseId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  raisedByStaff   StaffProfile     @relation("LearnerOpsEscalationRaiser", fields: [raisedByStaffId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  targetQueue     LearnerOpsQueue? @relation("LearnerOpsEscalationTargetQueue", fields: [targetQueueId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  targetStaff     StaffProfile?    @relation("LearnerOpsEscalationTargetStaff", fields: [targetStaffId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  resolvedByStaff StaffProfile?    @relation("LearnerOpsEscalationResolver", fields: [resolvedByStaffId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([caseId, raisedAt])
  @@index([class, resolvedAt])
  @@index([targetQueueId, resolvedAt])
  @@index([raisedByStaffId])
  @@index([targetStaffId])
  @@index([resolvedByStaffId])
}

/// Quality review of completed operational work. IMMUTABLE, and it writes only
/// to itself — QA can never edit the interaction it reviews, which is what
/// keeps historical learner communication auditable.
///
/// `dimensions` is Json rather than columns because no scoring policy has been
/// supplied. A rubric invented here would be a business rule nobody chose. The
/// shape is validated at the API boundary and the architecture admits a
/// configurable rubric later without a migration.
model LearnerOpsQaReview {
  id               String             @id @default(cuid())
  caseId           String
  reviewerStaffId  String
  result           LearnerOpsQaResult
  dimensions       Json?
  feedback         String?
  coachingRequired Boolean            @default(false)
  createdAt        DateTime           @default(now())

  case          LearnerOpsCase @relation("LearnerOpsQaReviewCase", fields: [caseId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  reviewerStaff StaffProfile   @relation("LearnerOpsQaReviewer", fields: [reviewerStaffId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([caseId, createdAt])
  @@index([reviewerStaffId, createdAt])
  @@index([result, createdAt])
}

/// Internal staff knowledge. Staff-visible only, and explicitly NOT an
/// authority: an article can describe how the product behaves and can never
/// decide what a learner's progression is.
model LearnerOpsKnowledgeArticle {
  id           String                    @id @default(cuid())
  slug         String                    @unique
  title        String
  body         String
  status       LearnerOpsKnowledgeStatus @default(draft)
  version      Int                       @default(1)
  ownerStaffId String
  createdAt    DateTime                  @default(now())
  updatedAt    DateTime                  @updatedAt

  ownerStaff StaffProfile @relation("LearnerOpsKnowledgeOwner", fields: [ownerStaffId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([status, updatedAt])
  @@index([ownerStaffId])
}

/// A recurring theme turned into structured product evidence. Frequency is
/// DERIVED from the join table below and never stored, so it cannot drift from
/// the cases that justify it.
model LearnerOpsVocSignal {
  id       String                @id @default(cuid())
  theme    String
  category String
  severity LearnerOpsVocSeverity
  status   LearnerOpsVocStatus   @default(open)

  ownerStaffId        String?
  createdByStaffId    String
  /// Where the product took it — an issue key, a commit, a decision note. Free
  /// text because this is deliberately NOT an issue tracker.
  resolutionReference String?
  resolutionNote      String?

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  resolvedAt DateTime?

  ownerStaff     StaffProfile? @relation("LearnerOpsVocOwner", fields: [ownerStaffId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  createdByStaff StaffProfile  @relation("LearnerOpsVocCreator", fields: [createdByStaffId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  cases LearnerOpsVocSignalCase[] @relation("LearnerOpsVocSignalCaseSignal")

  @@index([status, severity, updatedAt])
  @@index([category, status])
  @@index([ownerStaffId])
  @@index([createdByStaffId])
}

/// The evidence link. One case may support several signals and one signal is
/// justified by several cases, so this is a real many-to-many with its own
/// attribution.
model LearnerOpsVocSignalCase {
  id              String   @id @default(cuid())
  signalId        String
  caseId          String
  linkedByStaffId String
  createdAt       DateTime @default(now())

  signal        LearnerOpsVocSignal @relation("LearnerOpsVocSignalCaseSignal", fields: [signalId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  case          LearnerOpsCase      @relation("LearnerOpsVocSignalCaseCase", fields: [caseId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  linkedByStaff StaffProfile        @relation("LearnerOpsVocSignalLinker", fields: [linkedByStaffId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([signalId, caseId])
  @@index([caseId])
  @@index([linkedByStaffId])
}

// ===========================================================================
// COMMUNITY-V1
//
// WHY THESE ARE NEW TABLES AND NOT `ChatChannel` / `ChatMessage`.
//
// The legacy chat models are live V1 authority and they stay exactly as they
// are. They cannot carry this product for four independent reasons, each of
// which alone would be enough:
//
//   1. `ChatChannel.retentionDays` defaults to 3. A learning discussion whose
//      answer disappears after three days is not a learning discussion.
//   2. `ChatMessage` has no title and no parent. A discussion with replies
//      cannot be expressed in it without adding both columns to a live V1
//      table.
//   3. `ChatMessage` denormalises `userLevel`, `userRank` and `achievementTitle`
//      onto every row — V1 progress storage frozen into content. V2 Community
//      must not treat XP or a V1 level as social status.
//   4. `ChatChannel.requiredLevel` means `User.level`. Reusing the table would
//      put V2 spaces in the same column as V1 gates, where one `requiredLevel`
//      would have to mean two different progressions at once.
//
// Nothing joins the two domains. `/chat` keeps working, unchanged.
// ===========================================================================

/// Why a piece of Community content is not being shown as itself.
/// `removed_by_author` and `removed_by_moderator` are deliberately distinct:
/// a learner withdrawing their own words and a moderator removing them are
/// different facts, they render differently, and only one of them notifies.
enum CommunityContentStatus {
  visible
  removed_by_author
  removed_by_moderator
}

/// The closed reason set a learner may pick when reporting content. Bounded on
/// purpose (§19): a free-form taxonomy is a triage problem, not a product.
enum CommunityReportReason {
  spam
  off_topic
  abuse
  other
}

enum CommunityReportStatus {
  open
  actioned
  dismissed
}

/// A Community space. Rows are seeded from the accepted five-space map in
/// `academy/docs/CURRICULUM_AND_UNLOCKS.md` §5.
///
/// `readFromLevel` / `writeFromLevel` are levels of the **V2 curriculum**
/// (`UserCurriculumEnrollment.highestCompletedLevel`), NOT `User.level`. The
/// column names deliberately differ from the legacy `requiredLevel` so that no
/// reader can mistake one authority for the other.
model CommunitySpace {
  id             Int      @id @default(autoincrement())
  /// Stable product code, e.g. `channel.start_questions`. Never renumbered.
  code           String   @unique
  title          String
  /// One sentence a learner reads to decide whether their question belongs here.
  purpose        String
  /// V2 levels completed before the space may be READ. 0 = any enrolled learner.
  readFromLevel  Int      @default(0)
  /// V2 levels completed before the learner may POST. Always >= readFromLevel.
  writeFromLevel Int      @default(0)
  orderIndex     Int      @default(0)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  discussions CommunityDiscussion[] @relation("CommunityDiscussionSpace")

  @@index([isActive, orderIndex])
}

/// One learner-authored discussion. The unit of the product.
///
/// There is no `replyCount` column on purpose: a maintained counter is a number
/// that can disagree with the rows it counts, and Community must not display a
/// metric it cannot derive (§42). `lastActivityAt` IS a column, because
/// ordering by it must not require aggregating every reply on every list read;
/// it is written in the same transaction as the reply that moves it.
model CommunityDiscussion {
  id             String                 @id @default(cuid())
  spaceId        Int
  authorId       Int
  title          String
  body           String
  status         CommunityContentStatus @default(visible)
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  /// Latest of: creation, or the newest visible reply.
  lastActivityAt DateTime               @default(now())

  /// Removal attribution. Set together or not at all; `removedByStaffId` stays
  /// null for `removed_by_author`, which is what distinguishes the two in the
  /// data rather than only in the enum.
  removedAt        DateTime?
  removedByStaffId String?
  removalReason    String?

  space     CommunitySpace @relation("CommunityDiscussionSpace", fields: [spaceId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  author    User           @relation("CommunityDiscussionAuthor", fields: [authorId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  removedBy StaffProfile?  @relation("CommunityDiscussionRemovedBy", fields: [removedByStaffId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  replies CommunityReply[]         @relation("CommunityReplyDiscussion")
  reports CommunityContentReport[] @relation("CommunityContentReportDiscussion")

  @@index([spaceId, status, lastActivityAt])
  @@index([authorId, createdAt])
}

/// A reply. FLAT BY CONSTRUCTION — there is no `parentReplyId`, so a thread can
/// never grow a depth that stops being readable on a 390px screen (§6).
model CommunityReply {
  id           String                 @id @default(cuid())
  discussionId String
  authorId     Int
  body         String
  status       CommunityContentStatus @default(visible)
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt

  removedAt        DateTime?
  removedByStaffId String?
  removalReason    String?

  discussion CommunityDiscussion @relation("CommunityReplyDiscussion", fields: [discussionId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  author     User                @relation("CommunityReplyAuthor", fields: [authorId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  removedBy  StaffProfile?       @relation("CommunityReplyRemovedBy", fields: [removedByStaffId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  reports CommunityContentReport[] @relation("CommunityContentReportReply")

  @@index([discussionId, createdAt])
  @@index([authorId, createdAt])
}

/// A learner's report of a piece of content.
///
/// The reporter is recorded and is NEVER projected to any learner-facing
/// response — not to the author, not to other learners, not as a count. Exactly
/// one of `discussionId` / `replyId` is set; the pair-uniqueness indexes below
/// are what stop one learner reporting the same thing repeatedly to inflate it.
model CommunityContentReport {
  id           String                @id @default(cuid())
  reporterId   Int
  discussionId String?
  replyId      String?
  reason       CommunityReportReason
  /// Optional learner note, bounded. Staff-visible only.
  note         String?
  status       CommunityReportStatus @default(open)
  createdAt    DateTime              @default(now())

  resolvedAt        DateTime?
  resolvedByStaffId String?

  reporter   User                 @relation("CommunityContentReportReporter", fields: [reporterId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  discussion CommunityDiscussion? @relation("CommunityContentReportDiscussion", fields: [discussionId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  reply      CommunityReply?      @relation("CommunityContentReportReply", fields: [replyId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  resolvedBy StaffProfile?        @relation("CommunityContentReportResolver", fields: [resolvedByStaffId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([reporterId, discussionId])
  @@unique([reporterId, replyId])
  @@index([status, createdAt])
}

/// Append-only moderation history. Its own table rather than a reuse of
/// `ChatModerationLog`, whose columns are shaped for a chat message id and
/// whose rows describe a different product under a different authority.
model CommunityModerationAction {
  id         String   @id @default(cuid())
  staffId    String
  /// `discussion.remove` | `discussion.restore` | `reply.remove` |
  /// `reply.restore` | `report.dismiss`
  action     String
  targetType String
  targetId   String
  reason     String?
  metadata   Json?
  createdAt  DateTime @default(now())

  staff StaffProfile @relation("CommunityModerationActor", fields: [staffId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([createdAt])
  @@index([targetType, targetId])
}

/// H-7 — the learner session, made server-side and revocable.
///
/// The learner session used to be a self-contained HMAC token: `userId.role.
/// expiresAt.signature`, verified with a secret and nothing else. It could not
/// be revoked, so logout only cleared the cookie and a copied token kept working
/// until it expired; a second login issued a new token without invalidating the
/// first; and the role travelled inside the token, so a demotion did not reach a
/// session already issued.
///
/// This table is the authority instead. The raw token is never stored — only a
/// SHA-256 of it — so the table is useless to anyone who reads it, and a lookup
/// is a hash comparison rather than a secret comparison.
///
/// ONE ACTIVE SESSION PER USER is a product decision, enforced at write time:
/// login revokes every live row for that user and inserts one, in a single
/// transaction, so two concurrent logins cannot both survive.
///
/// ROLE IS NOT STORED HERE. It is read from the User row at verification time,
/// which is what makes a role change and a blocked account take effect on the
/// next request rather than at the next login.
model UserSession {
  id        String    @id @default(cuid())
  userId    Int
  /// SHA-256 of the bearer token, hex. The raw token exists only in the cookie.
  tokenHash String    @unique
  createdAt DateTime  @default(now())
  expiresAt DateTime
  /// Null while live. Set by logout, and by the next successful login.
  revokedAt DateTime?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])

  /// ONE LIVE SESSION PER USER IS ENFORCED BY THE DATABASE, not by this file.
  /// The migration creates `UserSession_userId_active_key`, a UNIQUE index on
  /// (userId) WHERE revokedAt IS NULL. Prisma cannot express a partial index,
  /// so it lives in SQL — but it is a real constraint, and a second live row
  /// fails at the database no matter which writer attempts it.
}
