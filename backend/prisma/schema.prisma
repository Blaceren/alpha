model AssessmentVersion {
  id                  Int                   @id @default(autoincrement())
  levelDefinitionId   Int
  curriculumVersionId Int
  versionNumber       Int
  status              ContentResourceStatus @default(draft)
  passPercent         Int
  maxAttempts         Int?
  showExplanation     Boolean               @default(false)
  createdById         Int?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  publishedAt         DateTime?
  archivedAt          DateTime?
  changeNotes         String?

  // PHASE-G0 — the same aggregate revision and four-eyes evidence as
  // ContentVersion. The aggregate here covers the questions, their
  // localizations, the option set and the answer key, because a bank is only
  // meaningful as a whole: approving question 3 while question 1's answer key
  // moved underneath is exactly the failure this guards.
  revision             Int            @default(1)
  editorialState       EditorialState @default(draft)
  lastAuthoredById     Int?
  lastAuthoredAt       DateTime?
  submittedById        Int?
  submittedAt          DateTime?
  changesRequestedById Int?
  changesRequestedAt   DateTime?
  approvedById         Int?
  approvedAt           DateTime?

  /// PHASE-G2 SUCCESSOR — WHICH bank this bank was cloned from. The ONE
  /// load-bearing statement of descent.
  ///
  /// Written by `cloneAssessmentVersion` and by nothing else: it is not part of
  /// any create or update command schema, so no caller can assert a predecessor
  /// it did not actually copy from. NULL means "no recorded predecessor", which
  /// is every bank that existed before this migration.
  ///
  /// It carries no authority by itself. `readSourceAuthority` uses it to find a
  /// candidate ancestor decision and then RE-EVALUATES that decision against
  /// this bank's own live values through the unchanged `evaluateApplication`,
  /// with the source-lineage guards on top. Descent is permission to look, never
  /// permission to apply.
  ///
  /// Restrict, not SetNull: silently erasing lineage would turn a bank whose
  /// authority is inherited into one that appears to have none.
  predecessorVersionId Int?

  levelDefinition            LevelDefinition                 @relation(fields: [levelDefinitionId, curriculumVersionId], references: [id, curriculumVersionId], onDelete: Restrict, onUpdate: Cascade)
  predecessorVersion         AssessmentVersion?              @relation("AssessmentVersionLineage", fields: [predecessorVersionId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  successorVersions          AssessmentVersion[]             @relation("AssessmentVersionLineage")
  createdBy                  User?                           @relation("AssessmentVersionCreator", fields: [createdById], references: [id], onDelete: SetNull, onUpdate: Cascade)
  lastAuthoredBy             User?                           @relation("AssessmentVersionLastAuthor", fields: [lastAuthoredById], references: [id], onDelete: SetNull, onUpdate: Cascade)
  submittedBy                User?                           @relation("AssessmentVersionSubmitter", fields: [submittedById], references: [id], onDelete: SetNull, onUpdate: Cascade)
  changesRequestedBy         User?                           @relation("AssessmentVersionChangeRequester", fields: [changesRequestedById], references: [id], onDelete: SetNull, onUpdate: Cascade)
  approvedBy                 User?                           @relation("AssessmentVersionApprover", fields: [approvedById], references: [id], onDelete: SetNull, onUpdate: Cascade)
  questions                  QuestionDefinition[]
  resourceBindings           LevelResourceBinding[]
  attempts                   AssessmentAttempt[]
  reviewNotes                EditorialReviewNote[]           @relation("EditorialReviewNoteAssessment")
  previewSnapshots           AuthoringPreviewSnapshot[]      @relation("AuthoringPreviewSnapshotAssessment")
  /// PHASE-G0 CORRECTION — video contracts whose evidence is bound to this bank.
  videoProductionLinks       VideoProductionAssessmentLink[]
  /// PHASE-G2 FOUNDATION — adjudicated source-authority decisions for this bank.
  sourceAuthorityResolutions SourceAuthorityResolution[]

  @@unique([id, levelDefinitionId])
  @@unique([levelDefinitionId, versionNumber])
  @@index([curriculumVersionId, status])
  @@index([createdById])
  @@index([curriculumVersionId, editorialState])
  @@index([lastAuthoredById])
  @@index([submittedById])
  @@index([changesRequestedById])
  @@index([approvedById])
  @@index([predecessorVersionId])
}

