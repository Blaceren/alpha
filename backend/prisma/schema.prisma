/**
 * L4VC-1 — the durable outcome vocabulary for a checkpoint verification attempt.
 * Every member is either a verdict about a THRESHOLD (met / not_met) or an
 * operational fact. None of them can describe an amount, so an attempt row can
 * never record how much money a learner has — only whether a gate the platform
 * already published was reached, or why the question could not be answered.
 * `in_progress` is the claim state written before the provider is called; it is
 * what makes "exactly one provider call for concurrent identical requests"
 * enforceable by a unique index rather than by a lock.
 */
enum CheckpointVerificationOutcome {
  in_progress
  met
  not_met
  identity_unlinked
  identity_mismatch
  unsupported_currency
  provider_disabled
  provider_unconfigured
  provider_timeout
  provider_maintenance
  provider_rate_limited
  stale
  invalid_provider_response
}

