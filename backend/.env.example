DATABASE_URL="file:./dev.db"
SESSION_SECRET=change-me-session-secret-at-least-32-chars
POSTBACK_SECRET=dev-postback-secret
APP_URL=http://127.0.0.1:3000
# The external Pocket registration link, carrying THIS deployment's own
# affiliate account identifiers. The parameter NAMES are the contract; the
# values below are placeholders on purpose. A tracked template that pinned
# a real account would silently attribute every fresh clone's traffic to it.
POCKET_AFFILIATE_BASE_URL=https://REPLACE-WITH-YOUR-POCKET-AFFILIATE-HOST/register?utm_campaign=000000&utm_source=REPLACE&utm_medium=REPLACE&a=REPLACE_AFFILIATE_ID&al=0000000&ac=REPLACE_ACCOUNT&cid=000000&code=REPLACE_CODE
POCKET_POSTBACK_REQUIRE_SECRET=false
EMAIL_VERIFICATION_REQUIRED=false
CAPTCHA_DEV_BYPASS=true

STORAGE_DRIVER=local
LOCAL_UPLOADS_DIR=storage/uploads

# Do not set this in production unless you intentionally want to run seed.
ALLOW_PRODUCTION_SEED=false
# beta:reset is local/dev/test by default. Production requires both values below.
ALLOW_PRODUCTION_BETA_RESET=false
# BETA_RESET_CONFIRM=RESET_BETA_DATA

SMOKE_BASE_URL=http://127.0.0.1:3009
SMOKE_ALLOW_REMOTE_SEED=false
SMOKE_POSTBACK_SECRET=dev-postback-secret
VISUAL_QA_BASE_URL=http://127.0.0.1:3009

# Feature flag: V2 curriculum admin API (Phase 1B.4). Default off.
CURRICULUM_V2_ADMIN_ENABLED=false
CURRICULUM_V2_READ_ENABLED=false
CURRICULUM_V2_ENROLLMENT_ENABLED=false
# PHASE-F — automatic curriculum enrollment for NEW registrations. Default off.
#
# Separate from CURRICULUM_V2_ENROLLMENT_ENABLED on purpose: that one decides
# whether the operator command may enroll a learner at all, this one decides
# whether EVERY new signup becomes an enrollment. Auto-enrollment additionally
# requires READ and ENROLLMENT to be enabled, so this flag alone grants nothing.
#
# With it on, a registration that cannot produce an enrollment (no published
# curriculum, two published curricula, a corrupt graph) FAILS THE WHOLE
# REGISTRATION with 503 rather than creating a learner with no programme.
#
# Before this may appear in a real environment file, it must first be declared
# in config/flag-policy/curriculum-v2-flag-policy.*.schema5.json — the policy
# forbids unknown CURRICULUM_V2_* keys.
CURRICULUM_V2_REGISTRATION_AUTO_ENROLL_ENABLED=false
# Internal V2 XP resolver and ledger service (Phase 3B.2). Default off.
CURRICULUM_V2_XP_ENABLED=false
CURRICULUM_V2_CONTENT_ENABLED=false
CURRICULUM_V2_ASSESSMENT_ENABLED=false
CURRICULUM_V2_REPORT_ENABLED=false

# A8 — PREPROD-only QA attestation of the Pocket-registration and financial
# checkpoint gates. Default OFF, and absent means OFF.
#
# It requires ATA_ENVIRONMENT=staging: a deployment classified production, dev,
# unclassified or misspelled REFUSES TO BOOT with this set to true, so it can
# never be enabled in production even by accident.
#
# It grants no Pocket capability whatsoever. It does not enable
# POCKET_POSTBACK_ENABLED, does not enable POCKET_BALANCE_PROVIDER_ENABLED, does
# not select a checkpoint provider, does not touch any affiliate flag and does
# not relax CAPTCHA/Turnstile. Production remains Pocket-authoritative for both
# registration and money.
STAGING_ATTESTATION_ENABLED=false
