{
  "schema": "ata.curriculum-v2.flag-policy/5",
  "description": "PRODUCT-RC-1 PREPROD profile (schema/5). NOT INSTALLED ANYWHERE \u2014 this is the target the preprod topology must satisfy when it is built. Three differences from the DEV profile: the denial of POCKET_FIRST_DEPOSIT_ENABLED must be ON THE RECORD (an explicit false, not silence); the deployment must classify itself staging; and the production-forbidden dev_simulator is not an authorised checkpoint provider there, so L4 runs on the honest gate with the provider disabled. A preprod host that forgets any of these does not boot past the gate.",
  "enabled_value": "true",
  "valid_boolean_values": [
    "false",
    "true"
  ],
  "required_true": [
    "CURRICULUM_V2_ASSESSMENT_ENABLED",
    "CURRICULUM_V2_CONTENT_ENABLED",
    "CURRICULUM_V2_ENROLLMENT_ENABLED",
    "CURRICULUM_V2_READ_ENABLED",
    "CURRICULUM_V2_REPORT_ENABLED"
  ],
  "required_false_or_absent": [
    "CURRICULUM_V2_ADMIN_ENABLED",
    "CURRICULUM_V2_CHECKPOINT_ENABLED",
    "CURRICULUM_V2_REPORT_ATTACHMENTS_ENABLED",
    "CURRICULUM_V2_XP_ENABLED"
  ],
  "forbid_unknown_prefix": "CURRICULUM_V2_",
  "pocket_flag": "POCKET_POSTBACK_ENABLED",
  "pocket_flags": [
    "POCKET_BALANCE_PROVIDER_ENABLED",
    "POCKET_FIRST_DEPOSIT_ENABLED",
    "POCKET_POSTBACK_ENABLED"
  ],
  "pocket_required_disabled": false,
  "forbid_unknown_pocket_prefix": "POCKET_",
  "pocket_known_non_capability": [
    "POCKET_AFFILIATE_BASE_URL",
    "POCKET_DEPOSIT_CURRENCY",
    "POCKET_REFERRAL_URL"
  ],
  "checkpoint_provider": {
    "mode_key": "CHECKPOINT_PROVIDER_MODE",
    "valid_modes": [
      "disabled",
      "pocket_partner",
      "dev_simulator"
    ],
    "allowed_modes_here": [
      "disabled"
    ],
    "mode_may_be_absent": false,
    "provider_capability_flag": "POCKET_BALANCE_PROVIDER_ENABLED",
    "environment_key": "ATA_ENVIRONMENT",
    "valid_environments": [
      "dev",
      "staging",
      "production"
    ],
    "expected_environment": "staging",
    "environment_required": true,
    "dev_simulator_mode": "dev_simulator",
    "dev_simulator_requires_environment": "dev",
    "dev_simulator_state_path_key": "CHECKPOINT_DEV_SIMULATOR_STATE_PATH",
    "dev_simulator_state_path_required_absent": true,
    "pocket_partner_mode": "pocket_partner",
    "pocket_partner_required_config": [
      "POCKET_PARTNER_API_BASE_URL",
      "POCKET_PARTNER_ID",
      "POCKET_PARTNER_API_TOKEN"
    ],
    "forbid_unknown_checkpoint_prefix": "CHECKPOINT_",
    "checkpoint_known_keys": [
      "CHECKPOINT_PROVIDER_MODE",
      "CHECKPOINT_DEV_SIMULATOR_STATE_PATH",
      "CHECKPOINT_PROVIDER_TEST_BACKEND"
    ],
    "checkpoint_forbidden_keys": [
      "CHECKPOINT_PROVIDER_TEST_BACKEND"
    ],
    "dev_simulator_state_path_required_present": false,
    "provider_flag_required_true_with_dev_simulator": false,
    "checkpoint_flag_key": "CURRICULUM_V2_CHECKPOINT_ENABLED",
    "checkpoint_requires_provider": true
  },
  "pocket_required_enabled": [
    "POCKET_POSTBACK_ENABLED"
  ],
