# Alfa Trade Academy CRM — environment example (NO REAL SECRETS).
# Phase 1A has no backend/database/API. These are UI-mode flags only.
# Copy to .env.local for local overrides. Never put production secrets here.

# CRM data mode: "mock" (only supported value in Phase 1A).
NEXT_PUBLIC_CRM_MODE=mock

# Enable the development-only role switcher (frontend visibility demo, NOT production RBAC).
NEXT_PUBLIC_ENABLE_ROLE_SWITCH=true
