/**
 * L4VC-1 — the configured threshold for one financial-checkpoint level.
 *
 * One requirement per level (`levelDefinitionId` is unique). The threshold is an
 * INTEGER in minor units so $50.00 is 5000 and no float rounding can ever move
 * a gate. `integrationCode` names which provider integration answers for this
 * level; it is a code, not a URL and not a credential.
 *
 * A level with no row here is `requirement_unconfigured` and is never verified —
 * the platform will not invent a threshold.
 */
model LevelCheckpointRequirement {
  id                  Int             @id @default(autoincrement())
  levelDefinitionId   Int             @unique
  integrationCode     String
  thresholdCurrency   String
  thresholdMinorUnits Int
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  levelDefinition     LevelDefinition @relation(fields: [levelDefinitionId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([integrationCode])
}

/**
 * L4VC-1 — one verification attempt, and the durable receipt that replays it.
 *
 * WHAT IT DELIBERATELY DOES NOT HAVE: a balance column, a demo balance column,
 * a remaining-amount column, an account identifier, a token, or a `Json` bag a
 * provider payload could be poured into. The privacy contract is enforced by
 * the ABSENCE of columns, so no future code path can persist an observed
 * amount without a schema change and a migration review.
 *
 * `observedAt` is a timestamp, not a measurement: it records how fresh the
 * provider's answer was, which is what makes `stale` meaningful.
 */
model CheckpointVerificationAttempt {
  id                Int                           @id @default(autoincrement())
  enrollmentId      Int
  levelDefinitionId Int
  requestId         String
  outcome           CheckpointVerificationOutcome
  providerRequestId String?
  observedAt        DateTime?
  cooldownUntil     DateTime?
  createdAt         DateTime                      @default(now())
  completedAt       DateTime?
  enrollment        UserCurriculumEnrollment      @relation(fields: [enrollmentId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  levelDefinition   LevelDefinition               @relation(fields: [levelDefinitionId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([enrollmentId, levelDefinitionId, requestId])
  @@index([enrollmentId, requestId])
  @@index([enrollmentId, levelDefinitionId, createdAt])
  @@index([levelDefinitionId])
}

/**
 * L4PA-1 — the authoritative binding between an ATA learner and a Pocket trader.
 *
 * WHY THIS EXISTS RATHER THAN `ExchangeAccount.traderId`
 * `traderId` looks like the same fact and is not. It is nullable, it is NOT
 * unique, it is written by EVERY authenticated postback goal (deposit,
 * withdrawal, commission — not just registration), and the processor overwrites
 * it with `traderId ?? existing`, so a later postback silently rebinds a learner
 * to a different Pocket account. It is also one of the OR-branches the account
 * lookup itself searches, so it is an attribution hint, not an identity claim.
 * Using it to authorise a $50 financial gate would mean the gate could be moved
 * onto someone else's funded account without anyone noticing.
 *
 * This table states the fact once, immutably in practice, with the uniqueness
 * the gate actually requires:
 *   - `userId` UNIQUE  — one learner has at most one authoritative Pocket ID;
 *   - `pocketUserId` UNIQUE — one Pocket trader backs at most one learner.
 * Both constraints are enforced by the DATABASE, so two concurrent registration
 * postbacks cannot both win and a conflict cannot be resolved by overwriting.
 *
 * `pocketUserId` is TEXT holding a canonical decimal integer, not INTEGER: it
 * is a foreign system's identifier that must round-trip exactly, and comparing
 * canonical strings avoids ever depending on float behaviour for an identity.
 *
 * PRIVACY BY ABSENCE. There is no balance column, no demo balance, no deposit
 * total, no FTD, no raw postback, no raw provider response, no free-form JSON,
 * no API token and no generated hash. Storing a learner's money here would
 * require a new migration and a review, which is the point.
 */
model PocketTraderIdentity {
  id           Int      @id @default(autoincrement())
  userId       Int      @unique
  pocketUserId String   @unique
  clickId      String
  /** Provenance of the binding. Only `registration_postback` is written today. */
  source       String   @default("registration_postback")
  boundAt      DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation("PocketTraderIdentityLearner", fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([clickId])
  /// AFD-5B1 — the trusted Pocket-registration metric counts this table by
  /// `boundAt`. Without this the date-ranged count was a full table scan.
  @@index([source, boundAt])
}

/// AFD-4 — which provider produced an event. One member today, named rather
/// than assumed, so a second provider cannot silently inherit Pocket's
/// idempotency namespace.
enum PocketProviderEventProvider {
  pocket
}

/// AFD-4 — the provider event types ATA can canonically own.
///
/// `first_deposit` is deliberately the only member. Pocket's callback carries no
/// transaction id, no event id and no occurrence time, so ATA cannot tell a
/// replay from a correction from a genuine second deposit. Adding `redeposit`
/// here would be claiming a distinction the provider does not supply.
enum PocketProviderEventType {
  first_deposit
}

/// AFD-4 — how far an event has got towards being a countable conversion.
///
/// `pending_identity` is the honest state for a deposit that arrived before the
/// registration that would tell us whose it is. `conflict` is a quarantine, not
/// an error state: the row is kept exactly as first received so an operator can
/// see what disagreed, and no later delivery may overwrite it.
enum PocketProviderEventStatus {
  pending_identity
  matched
  conflict
}

/// AFD-4 — whether the stored amount has a known unit. See
/// `POCKET_DEPOSIT_CURRENCY`.
enum PocketProviderEventCurrencyStatus {
  unspecified
  configured
}

/// AFD-4 — the bounded set of disagreements that quarantine an event.
enum PocketProviderEventConflictCode {
  /// A later delivery for this player named a different Pocket click id.
  click_id_mismatch
  /// A later delivery for this player reported a different amount.
  amount_mismatch
  /// The click resolves to one learner and the Pocket identity to another.
  identity_owner_mismatch
  /// The click id no longer resolves to any exchange account.
  click_owner_missing
}

/// AFD-4 — the canonical record of one Pocket provider event.
///
/// THE DOMAIN INVARIANT THIS TABLE EXISTS TO ENFORCE: one Pocket player produces
/// at most one canonical first deposit. That is a database fact here, not an
/// application convention — `UNIQUE(provider, eventType, pocketPlayerId)` is
/// what a replayed, retried or concurrent callback collides with.
///
/// WHY THE KEY IS THE PLAYER AND NOT A TRANSACTION ID. Pocket sends no unique
/// deposit identifier. AFD-1 established that the existing
/// `PostbackEvent.externalEventId` therefore stays null for deposits and the
/// event records as `not_processed`. Synthesising a key from the amount and a
/// timestamp — which an earlier revision of the legacy route did — is forbidden
/// in both directions: two real deposits of the same size in the same second
/// collapse into one, and a redelivery with a different clock looks like new
/// money.
///
/// THE CANONICAL VALUES ARE IMMUTABLE. `pocketClickId` and `normalizedAmount`
/// are written once, by the first accepted delivery, and no later delivery may
/// change them. A delivery that disagrees is recorded as a conflict beside them,
/// never on top of them.
model PocketProviderEvent {
  id                 Int                               @id @default(autoincrement())
  provider           PocketProviderEventProvider       @default(pocket)
  eventType          PocketProviderEventType
  /// The Pocket click id as delivered. Immutable after the first acceptance.
  pocketClickId      String
  /// The Pocket player id. Together with provider and type, the identity of the
  /// event.
  pocketPlayerId     String
  /// Null until the click owner and the Pocket identity agree on one learner.
  matchedUserId      Int?
  /// Canonical decimal TEXT, always two fractional digits. Never a float, and
  /// never a balance.
  normalizedAmount   String
  /// Null whenever Pocket did not tell us the unit and no operator configured
  /// one. Never defaulted to USD.
  currencyCode       String?
  currencyStatus     PocketProviderEventCurrencyStatus @default(unspecified)
  status             PocketProviderEventStatus         @default(pending_identity)
  firstReceivedAt    DateTime
  lastReceivedAt     DateTime
  /// Bounded count of identical redeliveries. Metadata about transport, not
  /// about money: it never implies more than one deposit.
  replayCount        Int                               @default(0)
  conflictCode       PocketProviderEventConflictCode?
  conflictDetectedAt DateTime?
  matchedAt          DateTime?
  createdAt          DateTime                          @default(now())
  updatedAt          DateTime                          @updatedAt
  matchedUser        User?                             @relation("PocketProviderEventLearner", fields: [matchedUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([provider, eventType, pocketPlayerId])
  @@index([pocketClickId])
  @@index([matchedUserId])
  @@index([status, firstReceivedAt])
  /// AFD-5B1 — conflicting deposits are counted by `conflictDetectedAt`, which
  /// the composite above does not carry, so its range was unindexed.
  @@index([status, conflictDetectedAt])
  @@index([conflictCode])
  @@index([lastReceivedAt])
}

/// AFD-2 — administrative affiliate foundation.
///
/// These three tables describe WHO buys traffic and WHICH named link they were
/// given. They deliberately hold no click, no visitor, no attribution, no
/// conversion and no learner: acquisition data arrives in AFD-3B and lives in
/// its own tables. Nothing here is reachable from an unauthenticated request.
enum AffiliateEntityStatus {
  active
  paused
  archived
}

/// Tracking-link lifecycle. AFD-3B2 adds `active`, which AFD-2 deliberately
/// refused to invent before a public route and an attribution owner existed.
/// Stored status is what an operator chose; whether a link can actually serve
/// traffic also depends on the feature switch and on its parents, which is a
/// runtime question answered by `effectiveAvailability`, not by this column.
enum AffiliateTrackingLinkStatus {
  draft
  active
  paused
  archived
}

/// How a click was treated by the public acquisition route. Only `qualified`
/// can ever be attributed — the other two exist so that machine traffic and
/// clicks by already-registered users are recorded honestly instead of being
/// dropped or, worse, counted.
enum AffiliateClickClassification {
  qualified
  prefetch
  authenticated_user
}

/// The attribution model in force. One value in AFD-3B2, named rather than
/// implied so a stored decision says which rule produced it.
enum AffiliateAttributionModel {
  last_eligible_affiliate_click
}

/// Why a particular click was selected.
enum AffiliateAttributionSelectionReason {
  registration_cookie
}

/// Conversion-event types. Deposit-shaped events belong to AFD-4 and are absent.
enum AffiliateConversionEventType {
  academy_registration
  /// AFD-4. At most one per Pocket player, emitted only once the deposit's
  /// Pocket identity has been legally bound by a trusted `goal=reg`.
  first_deposit
}

/// AFD-4 — whether a money-bearing conversion knows its unit.
///
/// Null on rows that carry no money at all. On a `first_deposit` it is always
/// present, and it is the field that makes an unknown currency an explicit,
/// queryable state rather than an absence somebody later "fixes" by assuming
/// dollars.
enum AffiliateConversionCurrencyStatus {
  unspecified
  configured
}

/// The owner that produced a conversion event, and therefore the namespace its
/// `sourceEventId` is unique within.
enum AffiliateConversionSourceOwner {
  auth_register
  /// AFD-4. Its `sourceEventId` names a PocketProviderEvent ROW, never a Pocket
  /// player or click id, so no provider identifier reaches the ledger's key.
  pocket_first_deposit
}

/// The server-owned logical destination of a tracking link. A KEY, never a URL:
/// storing a URL would make every link a redirector for whatever an operator
/// pasted, which is the open-redirect this design refuses to have.
enum AffiliateLandingKey {
  academy_registration
}

model AffiliatePartner {
  id                           Int                     @id @default(autoincrement())
  /// Immutable, lowercase, globally unique operator-facing handle.
  code                         String                  @unique
  displayName                  String
  description                  String?
  status                       AffiliateEntityStatus   @default(active)
  /// Inherited by links that set no window of their own. Bounded 1..365.
  defaultAttributionWindowDays Int                     @default(30)
  createdByUserId              Int
  createdAt                    DateTime                @default(now())
  updatedAt                    DateTime                @updatedAt
  archivedAt                   DateTime?
  createdBy                    User                    @relation("AffiliatePartnerCreator", fields: [createdByUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  campaigns                    AffiliateCampaign[]
  trackingLinks                AffiliateTrackingLink[]
  conversionEvents             AffiliateConversionEvent[]

  @@index([status, createdAt])
  @@index([createdAt])
  @@index([createdByUserId])
}

model AffiliateCampaign {
  id                 Int                     @id @default(autoincrement())
  affiliatePartnerId Int
  /// Immutable and lowercase. Unique WITHIN one partner, so two affiliates may
  /// each run a campaign called `summer`.
  code               String
  displayName        String
  notes              String?
  status             AffiliateEntityStatus   @default(active)
  createdByUserId    Int
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt
  archivedAt         DateTime?
  partner            AffiliatePartner        @relation(fields: [affiliatePartnerId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  createdBy          User                    @relation("AffiliateCampaignCreator", fields: [createdByUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  trackingLinks      AffiliateTrackingLink[]
  conversionEvents   AffiliateConversionEvent[]

  @@unique([affiliatePartnerId, code])
  /// Composite target for the tracking-link FK that proves a link and its
  /// campaign belong to the SAME partner without a runtime read.
  @@unique([id, affiliatePartnerId])
  @@index([affiliatePartnerId, status, createdAt])
  @@index([createdAt])
  @@index([createdByUserId])
}

model AffiliateTrackingLink {
  id                     Int                         @id @default(autoincrement())
  affiliatePartnerId     Int
  affiliateCampaignId    Int?
  /// Server-generated, 160-bit, URL-safe, immutable and globally unique. Never
  /// accepted from a client, and it embeds no database id and no partner code.
  publicCode             String                      @unique
  displayName            String
  status                 AffiliateTrackingLinkStatus @default(draft)
  landingKey             AffiliateLandingKey         @default(academy_registration)
  /// Names of INCOMING query parameters this link will accept in AFD-3B. These
  /// are parameter NAMES, never captured values.
  externalClickParameter String                      @default("clickid")
  sub1Parameter          String?
  sub2Parameter          String?
  sub3Parameter          String?
  sub4Parameter          String?
  sub5Parameter          String?
  /// Null inherits AffiliatePartner.defaultAttributionWindowDays.
  attributionWindowDays  Int?
  createdByUserId        Int
  createdAt              DateTime                    @default(now())
  updatedAt              DateTime                    @updatedAt
  archivedAt             DateTime?
  partner                AffiliatePartner            @relation(fields: [affiliatePartnerId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  campaign               AffiliateCampaign?          @relation(fields: [affiliateCampaignId, affiliatePartnerId], references: [id, affiliatePartnerId], onDelete: Restrict, onUpdate: Cascade)
  createdBy              User                        @relation("AffiliateTrackingLinkCreator", fields: [createdByUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  clicks                 AffiliateClick[]
  conversionEvents       AffiliateConversionEvent[]

  @@index([affiliatePartnerId, status, createdAt])
  @@index([affiliateCampaignId, status, createdAt])
  @@index([status, createdAt])
  @@index([createdAt])
  @@index([createdByUserId])
}

/// AFD-3B2 — one row per request the public acquisition route accepted.
///
/// PRIVACY BY SHAPE. There is no column here for a raw IP address, a
/// User-Agent, a complete request URL, a query string, a cookie or any
/// authorization material, so none of them can be stored by accident. The only
/// externally supplied values are those of parameters an operator explicitly
/// configured on the link, each bounded and control-character-free.
model AffiliateClick {
  id                             Int                          @id @default(autoincrement())
  /// OUR acquisition click id: 160 CSPRNG bits as 32 lowercase base32
  /// characters, globally unique, never accepted from a client, and not the
  /// affiliate network's click id nor any Pocket identifier.
  ataClickId                     String                       @unique
  trackingLinkId                 Int
  /// The anonymous visitor journey this click belongs to. NULL for prefetch and
  /// for authenticated-user clicks, which is what makes those permanently
  /// unattributable at the database level rather than by convention.
  anonymousVisitorId             String?
  /// The AFFILIATE NETWORK's own click id, from the link-configured parameter.
  /// Deliberately not unique: networks legitimately repeat values.
  externalAffiliateClickId       String?
  sub1                           String?
  sub2                           String?
  sub3                           String?
  sub4                           String?
  sub5                           String?
  classification                 AffiliateClickClassification
  /// The attribution window as it stood WHEN THE CLICK HAPPENED. Eligibility is
  /// judged against this snapshot, so later edits to the link or the partner
  /// cannot retroactively create or destroy attribution for past traffic.
  effectiveAttributionWindowDays Int
  /// A bare lowercase host, never a URL, a path or a query.
  sanitizedReferrerHost          String?
  occurredAt                     DateTime
  createdAt                      DateTime                     @default(now())
  trackingLink                   AffiliateTrackingLink        @relation(fields: [trackingLinkId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  firstTouchOf                   AffiliateAttribution[]       @relation("AffiliateAttributionFirstTouch")
  lastTouchOf                    AffiliateAttribution[]       @relation("AffiliateAttributionLastTouch")
  selectedBy                     AffiliateAttribution[]       @relation("AffiliateAttributionSelected")
  conversionEvents               AffiliateConversionEvent[]

  @@index([trackingLinkId, occurredAt])
  @@index([anonymousVisitorId, occurredAt])
  @@index([externalAffiliateClickId])
  @@index([classification, occurredAt])
}

/// AFD-3B2 — the frozen answer to "which affiliate acquired this learner".
///
/// Written once, inside the registration transaction, and never again. There is
/// no PATCH owner, no DELETE owner and no reattribution path in the application.
/// The two unique constraints make the two dangerous mistakes unrepresentable:
/// a user cannot acquire a second attribution, and one visitor journey cannot be
/// spent twice — which is precisely what a copied or replayed token attempts.
model AffiliateAttribution {
  id                 Int                                 @id @default(autoincrement())
  userId             Int                                 @unique
  anonymousVisitorId String                              @unique
  firstTouchClickId  Int
  lastTouchClickId   Int
  selectedClickId    Int
  attributionModel   AffiliateAttributionModel
  selectedAt         DateTime
  /// Separate from `selectedAt` on purpose: when a decision was computed and
  /// when it became immutable are different facts.
  frozenAt           DateTime
  selectionReason    AffiliateAttributionSelectionReason
  createdAt          DateTime                            @default(now())
  user               User                                @relation("UserAffiliateAttribution", fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  firstTouchClick    AffiliateClick                      @relation("AffiliateAttributionFirstTouch", fields: [firstTouchClickId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  lastTouchClick     AffiliateClick                      @relation("AffiliateAttributionLastTouch", fields: [lastTouchClickId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  selectedClick      AffiliateClick                      @relation("AffiliateAttributionSelected", fields: [selectedClickId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  conversionEvents   AffiliateConversionEvent[]

  @@index([selectedClickId])
  @@index([selectedAt])
}

/// AFD-3B2 — the append-only conversion ledger.
///
/// Exactly one `academy_registration` row per successful public registration,
/// INCLUDING a direct one, whose affiliate columns are all NULL. A direct
/// registration that produced no row would be indistinguishable from one the
/// ledger missed, and "nobody referred this learner" must not look like "we do
/// not know". The snapshots are denormalised so a payout report still reads the
/// code an affiliate had at conversion time after a rename or an archive.
model AffiliateConversionEvent {
  id                             Int                            @id @default(autoincrement())
  eventId                        String                         @unique
  eventType                      AffiliateConversionEventType
  userId                         Int
  attributionId                  Int?
  selectedClickId                Int?
  affiliatePartnerId             Int?
  affiliateCampaignId            Int?
  trackingLinkId                 Int?
  affiliateCodeSnapshot          String?
  campaignCodeSnapshot           String?
  trackingLinkPublicCodeSnapshot String?
  sourceOwner                    AffiliateConversionSourceOwner
  /// The producing owner's idempotency key. Never an email address — an email
  /// is mutable and re-registrable, and would make replay look like a new
  /// conversion.
  sourceEventId                  String
  /// AFD-4 — the provider-reported conversion amount, as canonical decimal TEXT.
  ///
  /// Null for `academy_registration`, which has no money. Present for every
  /// `first_deposit`. It is ONE IMMUTABLE REPORTED AMOUNT, not a balance, not a
  /// running total and not something a later event adds to.
  providerAmount                 String?
  /// Null whenever the provider did not state a currency and no operator
  /// configured one. Never defaulted to USD — see `currencyStatus`.
  currencyCode                   String?
  /// Records WHY `currencyCode` is null, so "we know it is unspecified" can
  /// never be misread as "this row has not been backfilled yet".
  currencyStatus                 AffiliateConversionCurrencyStatus?
  occurredAt                     DateTime
  createdAt                      DateTime                       @default(now())
  user                           User                           @relation("UserAffiliateConversionEvents", fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  attribution                    AffiliateAttribution?          @relation(fields: [attributionId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  selectedClick                  AffiliateClick?                @relation(fields: [selectedClickId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  partner                        AffiliatePartner?              @relation(fields: [affiliatePartnerId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  campaign                       AffiliateCampaign?             @relation(fields: [affiliateCampaignId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  trackingLink                   AffiliateTrackingLink?         @relation(fields: [trackingLinkId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([eventType, sourceOwner, sourceEventId])
  @@index([eventType, occurredAt])
  @@index([affiliatePartnerId, occurredAt])
  @@index([affiliateCampaignId, occurredAt])
  @@index([trackingLinkId, occurredAt])
  @@index([userId, occurredAt])
}

