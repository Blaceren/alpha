  id                      Int                    @id @default(autoincrement())
  submissionId            Int
  revisionNumber          Int
  kind                    ReportRevisionKind
  sourceRevisionId        Int?
  content                 Json
  contentFingerprint      String
  createdById             Int
  createdAt               DateTime               @default(now())
  submittedAt             DateTime?
  submission              ReportSubmission       @relation("ReportSubmissionRevisions", fields: [submissionId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  createdBy               User                   @relation("ReportRevisionCreator", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Cascade)
  sourceRevision          ReportRevision?        @relation("ReportRevisionSource", fields: [sourceRevisionId, submissionId], references: [id, submissionId], onDelete: Restrict, onUpdate: Cascade)
  derivedRevisions        ReportRevision[]       @relation("ReportRevisionSource")
  attachments             ReportAttachment[]
  reviews                 ReportReview[]
  activeForSubmissions    ReportSubmission[]     @relation("ReportSubmissionActiveRevision")
  submittedForSubmissions ReportSubmission[]     @relation("ReportSubmissionSubmittedRevision")
  approvedForSubmissions  ReportSubmission[]     @relation("ReportSubmissionApprovedRevision")
  targetReceipts          ReportCommandReceipt[] @relation("ReportCommandTargetRevision")
  resultReceipts          ReportCommandReceipt[] @relation("ReportCommandResultRevision")

  @@unique([id, submissionId])
  @@unique([submissionId, revisionNumber])
  @@index([submissionId, createdAt])
}

model ReportReview {
  id                        Int                    @id @default(autoincrement())
  submissionId              Int
  revisionId                Int
  curriculumVersionId       Int
  levelDefinitionId         Int
  reportAssignmentVersionId Int
  reportRubricVersionId     Int
  reviewerId                Int?
  reviewerRoleSnapshot      UserRole
  decision                  ReportReviewDecision
  humanComment              String?
  correctiveAction          String?
  rejectionReasonId         Int?
  requestId                 String
  payloadFingerprint        String
  claimedAt                 DateTime?
  claimExpiresAt            DateTime?
  reviewStartedAt           DateTime?
  reviewedAt                DateTime
  createdAt                 DateTime               @default(now())
  submission                ReportSubmission       @relation("ReportSubmissionReviews", fields: [submissionId, curriculumVersionId, levelDefinitionId, reportAssignmentVersionId, reportRubricVersionId], references: [id, curriculumVersionId, levelDefinitionId, reportAssignmentVersionId, reportRubricVersionId], onDelete: Restrict, onUpdate: Cascade)
  revision                  ReportRevision         @relation(fields: [revisionId, submissionId], references: [id, submissionId], onDelete: Restrict, onUpdate: Cascade)
  rubric                    ReportRubricVersion    @relation(fields: [reportRubricVersionId, reportAssignmentVersionId], references: [id, reportAssignmentVersionId], onDelete: Restrict, onUpdate: Cascade)
  reviewer                  User?                  @relation("ReportReviewer", fields: [reviewerId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  reason                    ReportRejectionReason? @relation(fields: [rejectionReasonId, reportRubricVersionId], references: [id, reportRubricVersionId], onDelete: Restrict, onUpdate: Cascade)
  scores                    ReportReviewScore[]
  latestForSubmissions      ReportSubmission[]     @relation("ReportSubmissionLatestReview")
  approvedForSubmissions    ReportSubmission[]     @relation("ReportSubmissionApprovedReview")

  @@unique([revisionId])
  @@unique([reviewerId, requestId])
  @@unique([id, submissionId])
  @@unique([id, reportRubricVersionId])
  @@index([submissionId, reviewedAt])
}

model ReportReviewScore {
  id                    Int                     @id @default(autoincrement())
  reportReviewId        Int
  reportRubricVersionId Int
  rubricCriterionId     Int
  rubricScaleOptionId   Int
  comment               String?
  createdAt             DateTime                @default(now())
  review                ReportReview            @relation(fields: [reportReviewId, reportRubricVersionId], references: [id, reportRubricVersionId], onDelete: Restrict, onUpdate: Cascade)
  criterion             ReportRubricCriterion   @relation(fields: [rubricCriterionId, reportRubricVersionId], references: [id, reportRubricVersionId], onDelete: Restrict, onUpdate: Cascade)
  scaleOption           ReportRubricScaleOption @relation(fields: [rubricScaleOptionId, reportRubricVersionId], references: [id, reportRubricVersionId], onDelete: Restrict, onUpdate: Cascade)

  @@unique([reportReviewId, rubricCriterionId])
}

model ReportAttachment {
  id              Int                    @id @default(autoincrement())
  submissionId    Int
  revisionId      Int
  ownerUserId     Int
  storageKey      String                 @unique
  originalName    String
  mimeType        String
  sizeBytes       Int
  checksum        String?
  status          ReportAttachmentStatus @default(initiated)
  scanProvider    String?
  scanReference   String?
  scanCompletedAt DateTime?
  createdAt       DateTime               @default(now())
  availableAt     DateTime?
  deletedAt       DateTime?
  storagePurgedAt DateTime?
  submission      ReportSubmission       @relation(fields: [submissionId, ownerUserId], references: [id, userId], onDelete: Restrict, onUpdate: Cascade)
  revision        ReportRevision         @relation(fields: [revisionId, submissionId], references: [id, submissionId], onDelete: Restrict, onUpdate: Cascade)
  owner           User                   @relation("ReportAttachmentOwner", fields: [ownerUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([id, revisionId, submissionId])
  @@index([revisionId, status])
  @@index([ownerUserId, createdAt])
  @@index([status, createdAt])
}

model ReportCommandReceipt {
  id                       Int               @id @default(autoincrement())
  actorUserId              Int
  submissionId             Int
  commandType              ReportCommandType
  requestId                String
  payloadFingerprint       String
  targetRevisionId         Int?
  resultRevisionId         Int?
  resultingWorkflowVersion Int
  safeResult               Json
  appliedAt                DateTime          @default(now())
  actor                    User              @relation("ReportCommandActor", fields: [actorUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  submission               ReportSubmission  @relation("ReportSubmissionReceipts", fields: [submissionId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  targetRevision           ReportRevision?   @relation("ReportCommandTargetRevision", fields: [targetRevisionId, submissionId], references: [id, submissionId], onDelete: Restrict, onUpdate: Cascade)
  resultRevision           ReportRevision?   @relation("ReportCommandResultRevision", fields: [resultRevisionId, submissionId], references: [id, submissionId], onDelete: Restrict, onUpdate: Cascade)

  @@unique([actorUserId, requestId])
  @@index([submissionId, appliedAt])
}

model XPTransaction {
  id                         Int                         @id @default(autoincrement())
  userId                     Int
  enrollmentId               Int
  curriculumVersionId        Int
  levelDefinitionId          Int?
  sourceType                 CurriculumXpSourceType
  sourceId                   String?
  idempotencyKey             String                      @unique
  payloadFingerprint         String
  amount                     Int
  metadata                   Json?
  createdAt                  DateTime                    @default(now())
  createdById                Int?
  user                       User                        @relation("CurriculumXpTarget", fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  enrollment                 UserCurriculumEnrollment    @relation(fields: [enrollmentId, userId, curriculumVersionId], references: [id, userId, curriculumVersionId], onDelete: Restrict, onUpdate: Cascade)
  levelDefinition            LevelDefinition?            @relation(fields: [levelDefinitionId, curriculumVersionId], references: [id, curriculumVersionId], onDelete: Restrict, onUpdate: Cascade)
  createdBy                  User?                       @relation("CurriculumXpCreator", fields: [createdById], references: [id], onDelete: SetNull, onUpdate: Cascade)
  promocodeRedemptionRequest PromocodeRedemptionRequest?

  @@unique([id, userId])
  @@index([enrollmentId, createdAt, id])
  @@index([userId, createdAt, id])
  @@index([curriculumVersionId, sourceType])
  @@index([levelDefinitionId])
  @@index([sourceType, sourceId])
}

enum StaffRole {
  crm_admin
  crm_manager
  retention_manager
  mentor
  support
  moderator
  analyst
  content_manager
  read_only
}

model StaffProfile {
  id                   String         @id @default(cuid())
  userId               Int            @unique
  displayName          String
  staffRole            StaffRole
  permissionVersion    Int            @default(1)
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  user                 User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  authoredCrmUserNotes CrmUserNote[]  @relation("CrmUserNoteAuthor")
  ownedLearnerStates   CrmUserOwner[] @relation("CrmUserOwnerStaff")

  // Owner-history attribution axes. All three are Restrict-referenced (see
  // CrmUserOwnerHistory), so a StaffProfile named as an actor, previous or next
  // owner cannot be deleted out from under the immutable record.
  actedOwnerHistory    CrmUserOwnerHistory[] @relation("CrmUserOwnerHistoryActor")
  previousOwnerHistory CrmUserOwnerHistory[] @relation("CrmUserOwnerHistoryPrevious")
  nextOwnerHistory     CrmUserOwnerHistory[] @relation("CrmUserOwnerHistoryNext")

  @@index([staffRole])
}

// CRM learner note — Notes v1. Immutable, append-only internal staff commentary
// about a learner. There is deliberately no updatedAt, deletedAt, visibility,
// pinned, category, caseId, owner, team, version or author name snapshot: v1
// creates notes and reads them back, nothing else.
//
// Both relations are Restrict on purpose. Deleting a learner who has notes, or
// a StaffProfile that authored notes, fails loudly rather than silently
// orphaning or erasing operational history. The author's display name is always
// resolved live through `author`, so a corrected staff name corrects every note.
model CrmUserNote {
  id        String   @id @default(cuid())
  userId    Int
  authorId  String
  body      String
  createdAt DateTime @default(now())

  user   User         @relation("CrmUserNoteTarget", fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  author StaffProfile @relation("CrmUserNoteAuthor", fields: [authorId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  // Exactly the keyset the list query walks: (userId) filter, then the
  // (createdAt DESC, id DESC) cursor tuple.
  @@index([userId, createdAt, id])
  @@index([authorId])
}

// CRM learner owner — Owner v1. The single current owner of one learner, stored
// as a mutable singleton keyed by the learner (userId is the primary key, so a
// learner can have at most one owner-state row). Ownership is informational
// only: it grants no authorization and changes no Notes, email, financial or
// learner-visibility rule.
//
// Concurrency and lifecycle are deliberate and MUST NOT be simplified:
//   - NO row            = pristine, never-mutated state → owner null, version 0.
//   - version starts at 1 on the first real assignment (row is created then).
//   - `ownerId` is nullable: a row with ownerId = null and version > 0 is
//     "previously mutated but currently unassigned" — a real, distinct state.
//   - version is monotonic and never resets; unassignment sets ownerId = null
//     and increments version. The row is NEVER deleted by Owner v1.
//
// Both foreign keys are Restrict: deleting a learner that has an owner-state
// row, or a StaffProfile that currently owns a learner, fails loudly rather
// than silently orphaning operational state. The owner FK is nullable so an
// unassigned row keeps no dangling reference. The owner's display name is
// always resolved live through `owner`, never snapshotted.
//
// There is deliberately no history, actorId, assignedBy, reason, comment,
// deletedAt, AuditLog relation, workload or team field: Owner v1 stores current
// state only. Typed assignment history is a deferred future slice.
model CrmUserOwner {
  userId    Int      @id
  ownerId   String?
  version   Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User          @relation("CrmUserOwnerLearner", fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  owner StaffProfile? @relation("CrmUserOwnerStaff", fields: [ownerId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([ownerId])
}

// CRM learner owner HISTORY — Owner History OH-1. One immutable row per real
// owner transition of one learner. It is the dedicated domain record of owner
// change; it is NOT the generic AuditLog and NOT the mock `/audit` workspace.
//
// A row is written inside the SAME transaction as the CrmUserOwner mutation it
// records, so the current owner and its history can never disagree: if the row
// cannot be written the owner change rolls back, and if the owner change fails
// no row is written. Exactly one row is written per successful assign, replace
// or unassign; a no-op or a stale/losing concurrent write produces none.
//
// Transition type is DERIVED, never stored as a string:
//   previousOwnerId NULL, nextOwnerId set   -> assigned   (from unowned)
//   both set, previous <> next              -> reassigned
//   previousOwnerId set, nextOwnerId NULL   -> unassigned
// The DB CHECK constraint (see the migration) rejects null->null and A->A, so
// an invalid transition cannot be stored even if application validation is
// bypassed. `ownerVersion` is the RESULTING current owner version after the
// transition, and (userId, ownerVersion) is unique — a version is claimed by at
// most one history row, which is the concurrency backstop.
//
// All three staff references are Restrict: the actor and the previous/next
// owner cannot be deleted while any history names them, so attribution is never
// silently erased. There is deliberately no updatedAt, deletedAt, reason,
// comment, IP, user-agent or AuditLog relation: history rows are immutable and
// carry only what the CRM read needs. History begins after this migration; no
// backfill is attempted and no synthetic transition is fabricated.
model CrmUserOwnerHistory {
  id              String   @id @default(cuid())
  userId          Int
  actorStaffId    String
  previousOwnerId String?
  nextOwnerId     String?
  ownerVersion    Int
  createdAt       DateTime @default(now())

  user          User          @relation("CrmUserOwnerHistoryLearner", fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  actor         StaffProfile  @relation("CrmUserOwnerHistoryActor", fields: [actorStaffId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  previousOwner StaffProfile? @relation("CrmUserOwnerHistoryPrevious", fields: [previousOwnerId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  nextOwner     StaffProfile? @relation("CrmUserOwnerHistoryNext", fields: [nextOwnerId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  // A resulting version is claimed by at most one history row per learner. This
  // unique index also carries the keyset the list query walks: (userId) filter,
  // then ownerVersion DESC — newest transition first, no tie-breaker needed
  // because ownerVersion is unique and monotonic per learner.
  @@unique([userId, ownerVersion])
  // Support the Restrict deletion lookups ("does any history name this staff?")
  // across all three attribution axes, matching the CrmUserOwner/CrmUserNote
  // convention of indexing each Restrict-referenced staff FK.
  @@index([actorStaffId])
  @@index([previousOwnerId])
  @@index([nextOwnerId])
}
