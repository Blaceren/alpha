generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum UserRole {
  user
  admin
  support
  mentor
  moderator
  news_editor
}

enum UserStatus {
  active
  blocked
}

enum RewardType {
  lesson
  consultation
  guide
  xp
  chat_access
  analytics_access
  other
}

enum NewsStatus {
  draft
  published
}

enum SupportDialogStatus {
  new
  in_progress
  waiting_user
  closed
}

enum TaskReportStatus {
  pending
  approved
  rejected
}

enum NotificationType {
  support_reply
  task_report_approved
  task_report_rejected
  reward_granted
  level_up
  checkpoint_frozen
  checkpoint_restored
  postback_received
  exchange_connected
  exchange_rejected
  exchange_blocked
  mentor_reply
  daily_reward
  achievement_granted
  promocode_redeemed
  referral_bonus
  system
}

enum PromocodeType {
  xp_bonus
  unlock_reward
  grant_achievement
}

enum FilePurpose {
  task_report
  support_attachment
  other
}

enum TesterFeedbackType {
  bug
  ux
  question
  idea
  other
}

enum TesterFeedbackSeverity {
  low
  medium
  high
  blocker
}

enum TesterFeedbackStatus {
  new
  triaged
  in_progress
  resolved
  rejected
  closed
}

model User {
  id                              Int                          @id @default(autoincrement())
  email                           String                       @unique
  pendingEmail                    String?                      @unique
  pendingEmailRequestedAt         DateTime?
  referralCode                    String                       @unique @default(cuid())
  passwordHash                    String                       @default("")
  role                            UserRole                     @default(user)
  status                          UserStatus                   @default(active)
  name                            String
  level                           Int                          @default(1)
  xp                              Int                          @default(0)
  currentTask                     String?
  emailVerifiedAt                 DateTime?
  leaderboardExcluded             Boolean                      @default(false)
  selectedAchievementId           Int?
  createdAt                       DateTime                     @default(now())
  updatedAt                       DateTime                     @updatedAt
  notificationSettings            NotificationSettings?
  invitedReferrals                Referral[]                   @relation("InviterReferrals")
  invitedByReferral               Referral?                    @relation("InvitedReferral")
  taskProgress                    UserTaskProgress[]
  rewards                         UserReward[]
  checkpoint                      Checkpoint?
  exchangeAccount                 ExchangeAccount?
  chatMessages                    ChatMessage[]
  supportDialogs                  SupportDialog[]              @relation("SupportDialogOwner")
  assignedSupportDialogs          SupportDialog[]              @relation("SupportDialogAssignee")
  supportMessages                 SupportMessage[]             @relation("SupportMessageSender")
  crmUserCohorts                  CrmUserCohort[]
  auditLogs                       AuditLog[]
  taskReports                     TaskReport[]                 @relation("TaskReportOwner")
  reviewedTaskReports             TaskReport[]                 @relation("TaskReportReviewer")
  notifications                   Notification[]
  fileAssets                      FileAsset[]
  testerFeedback                  TesterFeedback[]             @relation("TesterFeedbackAuthor")
  resolvedFeedback                TesterFeedback[]             @relation("TesterFeedbackResolver")
  emailVerificationTokens         EmailVerificationToken[]
  dailyRewards                    DailyLoginReward[]
  promocodeRedemptions            PromocodeRedemption[]
  promocodeRedemptionRequests     PromocodeRedemptionRequest[]
  achievements                    UserAchievement[]
  mentorDialogs                   MentorChatDialog[]           @relation("MentorChatOwner")
  assignedMentorDialogs           MentorChatDialog[]           @relation("MentorChatAssignee")
  mentorMessages                  MentorChatMessage[]          @relation("MentorMessageSender")
  channelMentorAssignments        MentorChannelAssignment[]
  channelModeratorAssignments     ModeratorChannelAssignment[]
  chatMutes                       ChatMute[]
  xpEvents                        XpEvent[]
  curriculumVersionsCreated       CurriculumVersion[]          @relation("CurriculumVersionCreator")
  curriculumEnrollments           UserCurriculumEnrollment[]
  curriculumXpTransactions        XPTransaction[]              @relation("CurriculumXpTarget")
  curriculumXpTransactionsCreated XPTransaction[]              @relation("CurriculumXpCreator")
  contentVersionsCreated          ContentVersion[]             @relation("ContentVersionCreator")
  assessmentVersionsCreated       AssessmentVersion[]          @relation("AssessmentVersionCreator")
  levelResourceBindingsCreated    LevelResourceBinding[]       @relation("LevelResourceBindingCreator")
  assessmentAttempts              AssessmentAttempt[]          @relation("AssessmentAttemptUser")
  lessonProgress                  UserLessonProgress[]         @relation("UserLessonProgressUser")
}

model XpEvent {
  id        Int      @id @default(autoincrement())
  userId    Int
  amount    Int
  source    String
  sourceId  String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([source, sourceId])
}

model EmailVerificationToken {
  id        Int       @id @default(autoincrement())
  userId    Int
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model Level {
  id         Int      @id @default(autoincrement())
  number     Int      @unique
  title      String
  requiredXp Int
  status     String
  createdAt  DateTime @default(now())
}

model Task {
  id               Int                @id @default(autoincrement())
  code             String?            @unique
  stepNumber       Int                @unique
  title            String
  description      String
  rewardType       String
  actionLabel      String
  xpReward         Int                @default(0)
  isCheckpoint     Boolean            @default(false)
  requiresReport   Boolean            @default(false)
  kind             String             @default("lesson")
  completionMethod String             @default("manual")
  balanceThreshold Float?
  createdAt        DateTime           @default(now())
  progress         UserTaskProgress[]
  reports          TaskReport[]
}

model TaskReport {
  id            Int              @id @default(autoincrement())
  userId        Int
  taskId        Int
  status        TaskReportStatus @default(pending)
  reportText    String?
  reportUrl     String?
  fileName      String?
  fileAssetId   Int?
  reviewerId    Int?
  reviewComment String?
  submittedAt   DateTime         @default(now())
  reviewedAt    DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  user          User             @relation("TaskReportOwner", fields: [userId], references: [id], onDelete: Cascade)
  task          Task             @relation(fields: [taskId], references: [id], onDelete: Cascade)
  reviewer      User?            @relation("TaskReportReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  fileAsset     FileAsset?       @relation("TaskReportFileAsset", fields: [fileAssetId], references: [id], onDelete: SetNull)

  @@unique([userId, taskId])
  @@index([status, submittedAt])
  @@index([taskId])
  @@index([reviewerId])
}

model UserTaskProgress {
  id        Int      @id @default(autoincrement())
  userId    Int
  taskId    Int
  status    String
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([userId, taskId])
}

model Reward {
  id            Int          @id @default(autoincrement())
  title         String
  description   String
  type          RewardType   @default(other)
  status        String
  relatedTaskId Int?
  users         UserReward[]
}

model UserReward {
  id         Int       @id @default(autoincrement())
  userId     Int
  rewardId   Int
  status     String
  receivedAt DateTime?
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  reward     Reward    @relation(fields: [rewardId], references: [id], onDelete: Cascade)

  @@unique([userId, rewardId])
}

model Referral {
  id              Int       @id @default(autoincrement())
  inviterUserId   Int
  invitedUserId   Int       @unique
  xpEarned        Int       @default(0)
  invitedXpEarned Int       @default(0)
  bonusGrantedAt  DateTime?
  createdAt       DateTime  @default(now())
  inviter         User      @relation("InviterReferrals", fields: [inviterUserId], references: [id], onDelete: Cascade)
  invited         User      @relation("InvitedReferral", fields: [invitedUserId], references: [id], onDelete: Cascade)
}

model ReferralBonusConfig {
  id            Int      @id @default(autoincrement())
  slug          String   @unique
  inviterXp     Int      @default(100)
  invitedXp     Int      @default(50)
  secondLevelXp Int      @default(0)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model NotificationSettings {
  id              Int      @id @default(autoincrement())
  userId          Int      @unique
  emailEnabled    Boolean  @default(true)
  webPushEnabled  Boolean  @default(false)
  telegramEnabled Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Notification {
  id        Int              @id @default(autoincrement())
  userId    Int
  type      NotificationType
  title     String
  message   String
  metadata  Json?
  readAt    DateTime?
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
}

model FileAsset {
  id              Int              @id @default(autoincrement())
  ownerUserId     Int
  originalName    String
  storedName      String           @unique
  mimeType        String
  sizeBytes       Int
  storagePath     String
  storageDriver   String           @default("local")
  purpose         FilePurpose
  createdAt       DateTime         @default(now())
  owner           User             @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  taskReports     TaskReport[]     @relation("TaskReportFileAsset")
  supportMessages SupportMessage[]

  @@index([ownerUserId, purpose, createdAt])
}

model Checkpoint {
  id              Int      @id @default(autoincrement())
  userId          Int?     @unique
  title           String
  stepId          Int
  requiredBalance Float
  currentBalance  Float
  status          String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ExchangeAccount {
  id                    Int             @id @default(autoincrement())
  userId                Int             @unique
  provider              String          @default("sandbox")
  referralLink          String
  exchangeAccountId     String          @unique
  externalAccountId     String?
  traderId              String?
  clickId               String?
  attribution           Json?
  status                String          @default("not_connected")
  registrationStatus    Boolean         @default(false)
  emailConfirmed        Boolean         @default(false)
  firstDepositConfirmed Boolean         @default(false)
  balance               Float           @default(0)
  depositAmount         Float           @default(0)
  tradesCount           Int             @default(0)
  totalDeposits         Float           @default(0)
  totalWithdrawals      Float           @default(0)
  totalCommission       Float           @default(0)
  lastVerifiedAt        DateTime?
  verifiedAt            DateTime?
  rejectionReason       String?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt
  user                  User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  postbackEvents        PostbackEvent[]

  @@index([provider, status])
  @@index([externalAccountId])
  @@index([traderId])
  @@index([clickId])
}

model PostbackEvent {
  id                  Int              @id @default(autoincrement())
  exchangeAccountId   Int?
  externalEventId     String?          @unique
  type                String
  eventType           String           @default("")
  normalizedEventType String?
  externalAccountId   String?
  traderId            String?
  clickId             String?
  amount              Float?
  currency            String?
  status              String
  rawPayload          String
  payload             Json?
  attribution         Json?
  rejectionReason     String?
  processedAt         DateTime?
  createdAt           DateTime         @default(now())
  exchangeAccount     ExchangeAccount? @relation(fields: [exchangeAccountId], references: [id], onDelete: Cascade)
}

model Cohort {
  id          Int             @id @default(autoincrement())
  slug        String          @unique
  name        String
  description String
  conditions  String
  action      String
  usersCount  Int             @default(0)
  users       CrmUserCohort[]
}

model CrmUserCohort {
  id             Int      @id @default(autoincrement())
  userId         Int?
  cohortId       Int
  name           String
  email          String
  level          Int
  currentStep    String
  exchangeStatus String
  depositStatus  String
  balance        Float
  lastActiveAt   DateTime
  user           User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  cohort         Cohort   @relation(fields: [cohortId], references: [id], onDelete: Cascade)
}

model NewsPost {
  id            Int        @id @default(autoincrement())
  slug          String     @unique
  title         String
  excerpt       String
  content       String
  category      String
  author        String
  coverImageUrl String?
  mediaUrl      String?
  mediaType     String?
  status        NewsStatus @default(published)
  publishedAt   DateTime
  createdAt     DateTime   @default(now())
}

model ChatMessage {
  id               Int          @id @default(autoincrement())
  channelId        Int?
  userId           Int?
  userName         String
  userLevel        Int
  userRank         String
  role             String
  message          String
  isHidden         Boolean      @default(false)
  achievementTitle String?
  createdAt        DateTime     @default(now())
  channel          ChatChannel? @relation(fields: [channelId], references: [id], onDelete: SetNull)
  user             User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model ChatChannel {
  id                   Int                          @id @default(autoincrement())
  slug                 String                       @unique
  title                String
  description          String
  requiredLevel        Int?
  requiredCheckpoint   String?
  requiredAchievement  String?
  isLockedVisible      Boolean                      @default(true)
  isActive             Boolean                      @default(true)
  retentionDays        Int                          @default(3)
  createdAt            DateTime                     @default(now())
  updatedAt            DateTime                     @updatedAt
  messages             ChatMessage[]
  mentorAssignments    MentorChannelAssignment[]
  moderatorAssignments ModeratorChannelAssignment[]

  @@index([isActive, requiredLevel])
}

model MentorChannelAssignment {
  id        Int         @id @default(autoincrement())
  channelId Int
  mentorId  Int
  createdAt DateTime    @default(now())
  channel   ChatChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  mentor    User        @relation(fields: [mentorId], references: [id], onDelete: Cascade)

  @@unique([channelId, mentorId])
}

model ModeratorChannelAssignment {
  id          Int         @id @default(autoincrement())
  channelId   Int
  moderatorId Int
  createdAt   DateTime    @default(now())
  channel     ChatChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  moderator   User        @relation(fields: [moderatorId], references: [id], onDelete: Cascade)

  @@unique([channelId, moderatorId])
}

model ChatModerationRule {
  id        Int      @id @default(autoincrement())
  type      String
  value     String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([type, isActive])
}

model ChatMute {
  id        Int       @id @default(autoincrement())
  userId    Int
  channelId Int?
  reason    String
  expiresAt DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, channelId, expiresAt])
}

model ChatModerationLog {
  id          Int      @id @default(autoincrement())
  moderatorId Int?
  userId      Int?
  channelId   Int?
  messageId   Int?
  action      String
  reason      String?
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([action, createdAt])
}

model SupportDialog {
  id            Int                 @id @default(autoincrement())
  userId        Int
  userName      String
  userLevel     Int
  currentStep   String
  status        SupportDialogStatus @default(new)
  assignedToId  Int?
  lastMessage   String
  lastMessageAt DateTime
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  user          User                @relation("SupportDialogOwner", fields: [userId], references: [id], onDelete: Cascade)
  assignedTo    User?               @relation("SupportDialogAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  messages      SupportMessage[]

  @@index([userId, status, updatedAt])
  @@index([status, lastMessageAt])
  @@index([assignedToId])
}

model SupportMessage {
  id           Int           @id @default(autoincrement())
  dialogId     Int
  senderUserId Int?
  senderRole   UserRole
  message      String
  fileAssetId  Int?
  internalNote Boolean       @default(false)
  createdAt    DateTime      @default(now())
  dialog       SupportDialog @relation(fields: [dialogId], references: [id], onDelete: Cascade)
  senderUser   User?         @relation("SupportMessageSender", fields: [senderUserId], references: [id], onDelete: SetNull)
  fileAsset    FileAsset?    @relation(fields: [fileAssetId], references: [id], onDelete: SetNull)

  @@index([dialogId, createdAt])
  @@index([senderUserId])
  @@index([fileAssetId])
}

model MentorChatDialog {
  id            Int                 @id @default(autoincrement())
  userId        Int
  mentorId      Int?
  status        String              @default("locked")
  unlockReason  String?
  lastMessage   String?
  lastMessageAt DateTime?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  user          User                @relation("MentorChatOwner", fields: [userId], references: [id], onDelete: Cascade)
  mentor        User?               @relation("MentorChatAssignee", fields: [mentorId], references: [id], onDelete: SetNull)
  messages      MentorChatMessage[]

  @@index([userId, status])
  @@index([mentorId, status])
}

model MentorChatMessage {
  id           Int              @id @default(autoincrement())
  dialogId     Int
  senderUserId Int?
  senderRole   UserRole
  message      String
  createdAt    DateTime         @default(now())
  dialog       MentorChatDialog @relation(fields: [dialogId], references: [id], onDelete: Cascade)
  senderUser   User?            @relation("MentorMessageSender", fields: [senderUserId], references: [id], onDelete: SetNull)

  @@index([dialogId, createdAt])
}

model DailyLoginReward {
  id         Int      @id @default(autoincrement())
  userId     Int
  rewardDate String
  streak     Int
  xpGranted  Int      @default(0)
  rewardId   Int?
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, rewardDate])
}

model Promocode {
  id                 Int                          @id @default(autoincrement())
  code               String                       @unique
  type               PromocodeType
  value              Json
  maxUses            Int?
  perUserLimit       Int                          @default(1)
  usedCount          Int                          @default(0)
  startsAt           DateTime?
  expiresAt          DateTime?
  isActive           Boolean                      @default(true)
  createdById        Int?
  createdAt          DateTime                     @default(now())
  updatedAt          DateTime                     @updatedAt
  redemptions        PromocodeRedemption[]
  redemptionRequests PromocodeRedemptionRequest[]

  @@index([isActive, startsAt, expiresAt])
}

model PromocodeRedemption {
  id          Int                         @id @default(autoincrement())
  promocodeId Int
  userId      Int
  createdAt   DateTime                    @default(now())
  promocode   Promocode                   @relation(fields: [promocodeId], references: [id], onDelete: Cascade)
  user        User                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  request     PromocodeRedemptionRequest?

  @@unique([id, userId, promocodeId])
  @@index([promocodeId, userId])
}

model PromocodeRedemptionRequest {
  id                 Int                 @id @default(autoincrement())
  userId             Int
  promocodeId        Int
  redemptionId       Int                 @unique
  requestId          String
  requestFingerprint String
  xpAwarded          Int?
  v2XpTransactionId  Int?                @unique
  createdAt          DateTime            @default(now())
  user               User                @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  promocode          Promocode           @relation(fields: [promocodeId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  redemption         PromocodeRedemption @relation(fields: [redemptionId, userId, promocodeId], references: [id, userId, promocodeId], onDelete: Restrict, onUpdate: Cascade)
  v2XpTransaction    XPTransaction?      @relation(fields: [v2XpTransactionId, userId], references: [id, userId], onDelete: Restrict, onUpdate: Cascade)

  @@unique([userId, requestId])
  @@unique([redemptionId, userId, promocodeId])
  @@unique([v2XpTransactionId, userId])
  @@index([promocodeId, createdAt])
  @@index([userId, createdAt])
}

model Achievement {
  id          Int               @id @default(autoincrement())
  slug        String            @unique
  title       String
  description String
  rarity      String
  iconKey     String
  isActive    Boolean           @default(true)
  createdAt   DateTime          @default(now())
  users       UserAchievement[]
}

model UserAchievement {
  id            Int         @id @default(autoincrement())
  userId        Int
  achievementId Int
  grantedById   Int?
  grantedAt     DateTime    @default(now())
  source        String      @default("manual")
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement   Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@unique([userId, achievementId])
}

model OpenQuestion {
  id          Int      @id @default(autoincrement())
  title       String
  description String
  status      String
  priority    String
  owner       String
  note        String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model AuditLog {
  id         Int      @id @default(autoincrement())
  userId     Int?
  action     String
  entityType String?
  entityId   String?
  metadata   Json?
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now())
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model TesterFeedback {
  id           Int                    @id @default(autoincrement())
  userId       Int?
  role         UserRole?
  type         TesterFeedbackType
  severity     TesterFeedbackSeverity
  status       TesterFeedbackStatus   @default(new)
  pageUrl      String?
  title        String
  message      String
  browserInfo  String?
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt
  resolvedAt   DateTime?
  resolvedById Int?
  adminComment String?
  user         User?                  @relation("TesterFeedbackAuthor", fields: [userId], references: [id], onDelete: SetNull)
  resolvedBy   User?                  @relation("TesterFeedbackResolver", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([type, severity, status])
  @@index([userId])
  @@index([resolvedById])
}

enum CurriculumVersionStatus {
  draft
  published
  archived
}

enum CurriculumDefinitionStatus {
  active
  disabled
}

enum LevelDefinitionType {
  external_event
  lesson
  scenario
  practice
  report
  mentor_review
  financial_checkpoint
  final_exam
}

enum CurriculumEnrollmentStatus {
  active
  completed
  superseded
}

enum UserLevelProgressStatus {
  in_progress
  pending_review
  completed
}

enum CurriculumXpSourceType {
  level_completion
  assessment_pass
  report_approval
  mentor_completion
  promocode
  migration_adjustment
  admin_correction
}

enum ContentResourceStatus {
  draft
  published
  archived
}

enum ContentAssetKind {
  video
  subtitles
  image
  chart
  attachment
}

enum QuestionType {
  single_choice
  multiple_choice
  true_false
  ordered_steps
  scenario_choice
  numeric
  chart_choice
}

enum AssessmentAttemptStatus {
  in_progress
  passed
  failed
}

enum LessonProgressStatus {
  in_progress
  completed
}

model CurriculumVersion {
  id            Int                        @id @default(autoincrement())
  code          String
  name          String
  status        CurriculumVersionStatus    @default(draft)
  versionNumber Int
  effectiveFrom DateTime?
  createdAt     DateTime                   @default(now())
  publishedAt   DateTime?
  createdById   Int?
  changeNotes   String?
  createdBy     User?                      @relation("CurriculumVersionCreator", fields: [createdById], references: [id], onDelete: SetNull)
  modules       ModuleDefinition[]
  levels        LevelDefinition[]
  enrollments   UserCurriculumEnrollment[]

  @@unique([id, code])
  @@unique([code, versionNumber])
  @@index([status])
  @@index([createdById])
}

model ModuleDefinition {
  id                  Int                        @id @default(autoincrement())
  curriculumVersionId Int
  moduleNumber        Int
  code                String
  title               String
  description         String                     @default("")
  firstLevel          Int
  lastLevel           Int
  checkpointLevel     Int?
  learningObjective   String                     @default("")
  status              CurriculumDefinitionStatus @default(active)
  curriculumVersion   CurriculumVersion          @relation(fields: [curriculumVersionId], references: [id], onDelete: Restrict)
  levels              LevelDefinition[]

  @@unique([id, curriculumVersionId])
  @@unique([curriculumVersionId, moduleNumber])
  @@unique([curriculumVersionId, code])
  @@index([curriculumVersionId, firstLevel])
}

model LevelDefinition {
  id                      Int                        @id @default(autoincrement())
  curriculumVersionId     Int
  moduleId                Int
  levelNumber             Int
  stableCode              String
  type                    LevelDefinitionType
  title                   String
  shortDescription        String                     @default("")
  learningObjective       String                     @default("")
  completionMethod        String
  xpReward                Int                        @default(0)
  requiredXp              Int                        @default(0)
  requiredPreviousLevel   Int?
  requiredCheckpointLevel Int?
  featureUnlockCode       String?
  visibilityRule          Json?
  status                  CurriculumDefinitionStatus @default(active)
  curriculumVersion       CurriculumVersion          @relation(fields: [curriculumVersionId], references: [id], onDelete: Restrict)
  module                  ModuleDefinition           @relation(fields: [moduleId, curriculumVersionId], references: [id, curriculumVersionId], onDelete: Restrict)
  userProgress            UserLevelProgress[]
  xpTransactions          XPTransaction[]
  contentVersions         ContentVersion[]
  assessmentVersions      AssessmentVersion[]
  resourceBinding         LevelResourceBinding?
  assessmentAttempts      AssessmentAttempt[]
  lessonProgress          UserLessonProgress[]

  @@unique([id, curriculumVersionId])
  @@unique([curriculumVersionId, levelNumber])
  @@unique([curriculumVersionId, stableCode])
  @@index([moduleId])
  @@index([curriculumVersionId, type])
}

model UserCurriculumEnrollment {
  id                     Int                        @id @default(autoincrement())
  userId                 Int
  curriculumVersionId    Int
  curriculumCode         String
  status                 CurriculumEnrollmentStatus @default(active)
  enrolledAt             DateTime                   @default(now())
  highestCompletedLevel  Int                        @default(0)
  currentLevel           Int                        @default(1)
  lastMeaningfulActionAt DateTime?
  completedAt            DateTime?
  migrationSource        String?
  createdAt              DateTime                   @default(now())
  updatedAt              DateTime                   @updatedAt
  user                   User                       @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  curriculumVersion      CurriculumVersion          @relation(fields: [curriculumVersionId, curriculumCode], references: [id, code], onDelete: Restrict, onUpdate: Cascade)
  levelProgress          UserLevelProgress[]
  xpTransactions         XPTransaction[]
  assessmentAttempts     AssessmentAttempt[]
  lessonProgress         UserLessonProgress[]

  @@unique([id, curriculumVersionId])
  @@unique([id, userId, curriculumVersionId])
  @@index([curriculumVersionId, status])
  @@index([userId, enrolledAt])
}

model UserLevelProgress {
  id                  Int                      @id @default(autoincrement())
  enrollmentId        Int
  curriculumVersionId Int
  levelDefinitionId   Int
  status              UserLevelProgressStatus  @default(in_progress)
  startedAt           DateTime                 @default(now())
  lastProgressAt      DateTime?
  completedAt         DateTime?
  completionMethod    String?
  completionEvidence  Json?
  attemptCount        Int                      @default(0)
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt
  enrollment          UserCurriculumEnrollment @relation(fields: [enrollmentId, curriculumVersionId], references: [id, curriculumVersionId], onDelete: Restrict, onUpdate: Cascade)
  levelDefinition     LevelDefinition          @relation(fields: [levelDefinitionId, curriculumVersionId], references: [id, curriculumVersionId], onDelete: Restrict, onUpdate: Cascade)

  @@unique([enrollmentId, levelDefinitionId])
  @@index([enrollmentId, status])
  @@index([curriculumVersionId, status])
  @@index([levelDefinitionId])
}

model ContentVersion {
  id                   Int                    @id @default(autoincrement())
  levelDefinitionId    Int
  curriculumVersionId  Int
  versionNumber        Int
  status               ContentResourceStatus  @default(draft)
  videoDurationSeconds Int?
  createdById          Int?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  publishedAt          DateTime?
  archivedAt           DateTime?
  changeNotes          String?
  levelDefinition      LevelDefinition        @relation(fields: [levelDefinitionId, curriculumVersionId], references: [id, curriculumVersionId], onDelete: Restrict, onUpdate: Cascade)
  createdBy            User?                  @relation("ContentVersionCreator", fields: [createdById], references: [id], onDelete: SetNull, onUpdate: Cascade)
  localizations        ContentLocalization[]
  assets               ContentAsset[]
  resourceBindings     LevelResourceBinding[]
  lessonProgress       UserLessonProgress[]

  @@unique([id, levelDefinitionId])
  @@unique([levelDefinitionId, versionNumber])
  @@index([curriculumVersionId, status])
  @@index([createdById])
}

model ContentLocalization {
  id                         Int            @id @default(autoincrement())
  contentVersionId           Int
  locale                     String
  title                      String
  subtitle                   String         @default("")
  learningObjectiveExtension String         @default("")
  summary                    String         @default("")
  transcript                 String?
  body                       Json
  createdAt                  DateTime       @default(now())
  updatedAt                  DateTime       @updatedAt
  contentVersion             ContentVersion @relation(fields: [contentVersionId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([contentVersionId, locale])
}

model ContentAsset {
  id               Int              @id @default(autoincrement())
  contentVersionId Int
  kind             ContentAssetKind
  assetCode        String
  locale           String?
  url              String
  mimeType         String
  sizeBytes        Int?
  durationSeconds  Int?
  checksum         String?
  sortOrder        Int              @default(0)
  createdAt        DateTime         @default(now())
  contentVersion   ContentVersion   @relation(fields: [contentVersionId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([id, contentVersionId])
  @@unique([contentVersionId, assetCode])
  @@unique([contentVersionId, sortOrder])
  @@index([contentVersionId, kind, locale])
}

model AssessmentVersion {
  id                  Int                    @id @default(autoincrement())
  levelDefinitionId   Int
  curriculumVersionId Int
  versionNumber       Int
  status              ContentResourceStatus  @default(draft)
  passPercent         Int
  maxAttempts         Int?
  showExplanation     Boolean                @default(false)
  createdById         Int?
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt
  publishedAt         DateTime?
  archivedAt          DateTime?
  changeNotes         String?
  levelDefinition     LevelDefinition        @relation(fields: [levelDefinitionId, curriculumVersionId], references: [id, curriculumVersionId], onDelete: Restrict, onUpdate: Cascade)
  createdBy           User?                  @relation("AssessmentVersionCreator", fields: [createdById], references: [id], onDelete: SetNull, onUpdate: Cascade)
  questions           QuestionDefinition[]
  resourceBindings    LevelResourceBinding[]
  attempts            AssessmentAttempt[]

  @@unique([id, levelDefinitionId])
  @@unique([levelDefinitionId, versionNumber])
  @@index([curriculumVersionId, status])
  @@index([createdById])
}

model QuestionDefinition {
  id                  Int                        @id @default(autoincrement())
  assessmentVersionId Int
  questionNumber      Int
  stableKey           String
  type                QuestionType
  skillTag            String?
  status              CurriculumDefinitionStatus @default(active)
  options             Json?
  correctAnswer       Json
  createdAt           DateTime                   @default(now())
  updatedAt           DateTime                   @updatedAt
  assessmentVersion   AssessmentVersion          @relation(fields: [assessmentVersionId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  localizations       QuestionLocalization[]

  @@unique([assessmentVersionId, questionNumber])
  @@unique([assessmentVersionId, stableKey])
}

model QuestionLocalization {
  id           Int                @id @default(autoincrement())
  questionId   Int
  locale       String
  prompt       String
  optionLabels Json?
  explanation  String?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  question     QuestionDefinition @relation(fields: [questionId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([questionId, locale])
}

model LevelResourceBinding {
  id                  Int                @id @default(autoincrement())
  levelDefinitionId   Int                @unique
  curriculumVersionId Int
  contentVersionId    Int?
  assessmentVersionId Int?
  createdById         Int?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  levelDefinition     LevelDefinition    @relation(fields: [levelDefinitionId, curriculumVersionId], references: [id, curriculumVersionId], onDelete: Restrict, onUpdate: Cascade)
  contentVersion      ContentVersion?    @relation(fields: [contentVersionId, levelDefinitionId], references: [id, levelDefinitionId], onDelete: Restrict, onUpdate: Cascade)
  assessmentVersion   AssessmentVersion? @relation(fields: [assessmentVersionId, levelDefinitionId], references: [id, levelDefinitionId], onDelete: Restrict, onUpdate: Cascade)
  createdBy           User?              @relation("LevelResourceBindingCreator", fields: [createdById], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@unique([levelDefinitionId, curriculumVersionId])
  @@index([contentVersionId])
  @@index([assessmentVersionId])
  @@index([curriculumVersionId])
  @@index([createdById])
}

model AssessmentAttempt {
  id                  Int                      @id @default(autoincrement())
  userId              Int
  enrollmentId        Int
  curriculumVersionId Int
  levelDefinitionId   Int
  assessmentVersionId Int
  attemptNumber       Int
  status              AssessmentAttemptStatus  @default(in_progress)
  startedAt           DateTime                 @default(now())
  submittedAt         DateTime?
  durationSeconds     Int?
  totalQuestions      Int?
  correctCount        Int?
  scoreBasisPoints    Int?
  submittedAnswers    Json?
  answersFingerprint  String?
  startRequestId      String
  submitRequestId     String?
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt
  user                User                     @relation("AssessmentAttemptUser", fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  enrollment          UserCurriculumEnrollment @relation(fields: [enrollmentId, userId, curriculumVersionId], references: [id, userId, curriculumVersionId], onDelete: Restrict, onUpdate: Cascade)
  levelDefinition     LevelDefinition          @relation(fields: [levelDefinitionId, curriculumVersionId], references: [id, curriculumVersionId], onDelete: Restrict, onUpdate: Cascade)
  assessmentVersion   AssessmentVersion        @relation(fields: [assessmentVersionId, levelDefinitionId], references: [id, levelDefinitionId], onDelete: Restrict, onUpdate: Cascade)

  @@unique([enrollmentId, assessmentVersionId, attemptNumber])
  @@unique([enrollmentId, startRequestId])
  @@index([enrollmentId, assessmentVersionId, status])
  @@index([userId, createdAt])
  @@index([assessmentVersionId, status])
}

model UserLessonProgress {
  id                      Int                      @id @default(autoincrement())
  userId                  Int
  enrollmentId            Int
  curriculumVersionId     Int
  levelDefinitionId       Int
  contentVersionId        Int
  status                  LessonProgressStatus     @default(in_progress)
  startedAt               DateTime                 @default(now())
  lastProgressAt          DateTime                 @default(now())
  completedAt             DateTime?
  playbackPositionSeconds Int                      @default(0)
  completedSections       Json                     @default("[]")
  progressData            Json?
  lastRequestId           String?
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  user                    User                     @relation("UserLessonProgressUser", fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  enrollment              UserCurriculumEnrollment @relation(fields: [enrollmentId, userId, curriculumVersionId], references: [id, userId, curriculumVersionId], onDelete: Restrict, onUpdate: Cascade)
  levelDefinition         LevelDefinition          @relation(fields: [levelDefinitionId, curriculumVersionId], references: [id, curriculumVersionId], onDelete: Restrict, onUpdate: Cascade)
  contentVersion          ContentVersion           @relation(fields: [contentVersionId, levelDefinitionId], references: [id, levelDefinitionId], onDelete: Restrict, onUpdate: Cascade)

  @@unique([enrollmentId, contentVersionId])
  @@index([enrollmentId, levelDefinitionId])
  @@index([userId, lastProgressAt])
}

model XPTransaction {
  id                         Int                         @id @default(autoincrement())
  userId                     Int
  enrollmentId               Int
  curriculumVersionId        Int
  levelDefinitionId          Int?
  sourceType                 CurriculumXpSourceType
  sourceId                   String?
  idempotencyKey             String                      @unique
  payloadFingerprint         String
  amount                     Int
  metadata                   Json?
  createdAt                  DateTime                    @default(now())
  createdById                Int?
  user                       User                        @relation("CurriculumXpTarget", fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  enrollment                 UserCurriculumEnrollment    @relation(fields: [enrollmentId, userId, curriculumVersionId], references: [id, userId, curriculumVersionId], onDelete: Restrict, onUpdate: Cascade)
  levelDefinition            LevelDefinition?            @relation(fields: [levelDefinitionId, curriculumVersionId], references: [id, curriculumVersionId], onDelete: Restrict, onUpdate: Cascade)
  createdBy                  User?                       @relation("CurriculumXpCreator", fields: [createdById], references: [id], onDelete: SetNull, onUpdate: Cascade)
  promocodeRedemptionRequest PromocodeRedemptionRequest?

  @@unique([id, userId])
  @@index([enrollmentId, createdAt, id])
  @@index([userId, createdAt, id])
  @@index([curriculumVersionId, sourceType])
  @@index([levelDefinitionId])
  @@index([sourceType, sourceId])
}
